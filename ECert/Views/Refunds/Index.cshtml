@{
    ViewData["Title"] = "استرداد الرسوم";
    ViewData["PageIcon"] = "bi-arrow-counterclockwise";
    ViewData["PageDesc"] = "سندات استرداد الرسوم؛ كل استرداد حركة مستقلة تُخصم من عهدة الموظف المنفّذ";
    Layout = "_AdminLayout";
    var refunds = (ViewBag.Refunds as List<Refund> ?? new())
        .Where(r => r.Status != RefundStatus.Cancelled).ToList();
    var search = ViewBag.Search as string;
    bool canApprove = User.HasPermission(AdminPermissions.ApproveRefunds);
    bool canRefund = User.HasPermission(AdminPermissions.ManageRefunds);
    int? currentUserId = ViewBag.CurrentUserId as int?;
    var pending = refunds.Where(r => r.Status == RefundStatus.PendingApproval).ToList();
    string statusLabel(string s) => s == RefundStatus.Approved ? "معتمد" : "بانتظار الاعتماد";
    string statusBadge(string s) => s == RefundStatus.Approved ? "a-badge--success" : "a-badge--warning";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        @if (canRefund)
        {
            <a asp-action="NewRefund" class="btn btn-danger"><i class="bi bi-plus-circle"></i> طلب استرداد جديد</a>
        }
    </div>
</div>


@if (canApprove && pending.Any())
{
    <div class="a-card mb-4">
        <div class="a-card__header">
            <h2 class="a-card__title"><i class="bi bi-hourglass-split" aria-hidden="true"></i> بانتظار الاعتماد</h2>
            <span class="a-badge a-badge--warning">@pending.Count طلب</span>
        </div>
        <div class="a-card__body a-card__body--flush">
            <div class="a-table-wrap">
                <table class="table a-table align-middle">
                    <thead><tr><th>رقم السند</th><th>الفاتورة</th><th>المتدرب</th><th>المبلغ</th><th>السبب</th><th>نفّذه</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in pending)
                        {
                            <tr>
                                <td><span class="a-code">@(r.ReceiptNumber ?? $"R-{r.RefundId}")</span></td>
                                <td><span class="a-code">@r.Invoice?.InvoiceNumber</span></td>
                                <td class="a-table__primary">@(r.Invoice?.TraineeNameArabic ?? r.Invoice?.TraineeName)</td>
                                <td class="a-amount a-amount--out">@r.Amount.ToString("N2") @Currency.Symbol</td>
                                <td class="text-muted small">@r.Reason</td>
                                <td class="small">@r.RefundedBy</td>
                                <td>
                                    <form asp-action="Approve" asp-route-id="@r.RefundId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success" data-confirm="اعتماد الاسترداد وخصمه من العهدة؟">
                                            <i class="bi bi-check-lg"></i> اعتماد
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<form method="get" class="a-toolbar" role="search" aria-label="بحث في الاستردادات">
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label" for="refundSearch">بحث</label>
        <input id="refundSearch" type="search" name="search" value="@search" class="form-control" placeholder="رقم الفاتورة أو اسم المتدرب أو رقم السند" />
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> بحث</button>
        <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
    </div>
</form>

<div class="a-card">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> الاستردادات</h2>
        <span class="a-badge a-badge--neutral a-badge--none">@refunds.Count سند</span>
    </div>
    <div class="a-card__body @(refunds.Any() ? "a-card__body--flush" : "")">
        @if (refunds.Any())
        {
            <div class="a-table-wrap">
                <table class="table a-table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>رقم السند</th>
                            <th>الفاتورة</th>
                            <th>المتدرب</th>
                            <th>المبلغ</th>
                            <th>السبب</th>
                            <th>نفّذه</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in refunds)
                        {
                            <tr>
                                <td>@r.RefundId</td>
                                <td><span class="a-code">@(r.ReceiptNumber ?? $"R-{r.RefundId}")</span></td>
                                <td>
                                    <a class="a-code" asp-controller="Receivables" asp-action="Statement" asp-route-invoiceId="@r.InvoiceId" title="كشف حساب">@r.Invoice?.InvoiceNumber</a>
                                </td>
                                <td class="a-table__primary">@(r.Invoice?.TraineeNameArabic ?? r.Invoice?.TraineeName)</td>
                                <td class="a-amount a-amount--out">@r.Amount.ToString("N2") @Currency.Symbol</td>
                                <td class="text-muted small">@r.Reason</td>
                                <td class="small">@r.RefundedBy</td>
                                <td>
                                    <span class="a-badge @statusBadge(r.Status)">
                                        @statusLabel(r.Status)
                                    </span>
                                </td>
                                <td class="small">@r.RefundDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-nowrap">
                                    @{
                                        // The requester may withdraw their own refund request while it is
                                        // still waiting for approval; nothing has moved yet, so cancelling
                                        // only releases the custody the request was reserving.
                                        bool canCancelOwn = r.Status == RefundStatus.PendingApproval
                                            && currentUserId.HasValue && r.RequestedByUserId == currentUserId;
                                    }
                                    @if (canCancelOwn)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@r.RefundId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" data-confirm="إلغاء طلب الاسترداد؟ لا يمكن التراجع."><i class="bi bi-x-circle"></i> إلغاء</button>
                                        </form>
                                    }
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Receipt" asp-route-id="@r.RefundId">
                                        <i class="bi bi-printer"></i> سند
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new ECert.ViewModels.EmptyState { Icon = "bi-arrow-counterclockwise", Title = "لا توجد استردادات", Text = "لم تُسجَّل أي سندات استرداد بعد. ابدأ بطلب استرداد جديد.", ActionText = canRefund ? "طلب استرداد جديد" : null, ActionHref = canRefund ? Url.Action("NewRefund") : null })" />
        }
    </div>
</div>

@{
    ViewData["Title"] = "مصروف جديد";
    ViewData["PageIcon"] = "bi-cart-plus";
    ViewData["PageDesc"] = "تسجيل مصروف جديد؛ يبقى بانتظار اعتماد مدير النظام قبل أن يُحتسب";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as List<ExpenseCategory> ?? new();
    var remaining = ViewBag.CategoryRemaining as Dictionary<int, decimal?> ?? new();
    decimal fundBalance = ViewBag.FundBalance is decimal fb ? fb : 0m;
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> عودة</a>
    </div>
</div>


<div class="a-note a-note--info mb-4">
    <i class="bi bi-safe" aria-hidden="true"></i>
    <div>
        رصيد الصندوق الرئيسي المتاح حالياً: <strong>@fundBalance.ToString("N2") @Currency.Symbol</strong>.
        يُخصم المصروف من الرصيد عند اعتماده فقط، ولا يُحتسب قبل ذلك.
    </div>
</div>

@if (!categories.Any())
{
    <div class="a-note a-note--warning mb-4" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <div>لا توجد بنود مصروفات. أضف بنداً من <a asp-controller="ExpenseCategories" asp-action="Index">بنود المصروفات</a> أولاً.</div>
    </div>
}

<div class="a-card">
    <div class="a-card__body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="a-form__grid">
            @Html.AntiForgeryToken()
            <div class="a-field">
                <label class="a-field__label a-label--required" for="expCategoryId">بند المصروف</label>
                <select id="expCategoryId" name="expenseCategoryId" class="form-select" required>
                    <option value="">— اختر البند —</option>
                    @foreach (var c in categories)
                    {
                        var rem = remaining.TryGetValue(c.ExpenseCategoryId, out var r) ? r : null;
                        var label = c.Name;
                        if (rem.HasValue)
                            label = $"{c.Name} — المتبقي: {rem.Value:N2}";
                        <option value="@c.ExpenseCategoryId">@label</option>
                    }
                </select>
            </div>
            <div class="a-field">
                <label class="a-field__label a-label--required" for="expAmount">المبلغ (@Currency.Symbol)</label>
                <input id="expAmount" type="number" name="amount" min="0.01" step="0.01" class="form-control" required placeholder="0.00" />
            </div>
            <div class="a-field a-field--full">
                <label class="a-field__label a-label--required" for="expDesc">البيان</label>
                <input id="expDesc" type="text" name="description" maxlength="300" class="form-control" required placeholder="وصف المصروف" />
            </div>
            <div class="a-field">
                <label class="a-field__label" for="expDate">تاريخ المصروف</label>
                <input id="expDate" type="date" name="expenseDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="a-field">
                <label class="a-field__label" for="expDoc">رقم المستند</label>
                <input id="expDoc" type="text" name="documentNumber" maxlength="80" class="form-control" placeholder="اختياري" />
            </div>
            <div class="a-field a-field--full">
                <label class="a-field__label" for="expFiles">المرفقات (صور الفاتورة) — حتى @ECert.Models.ExpenseAttachment.MaxPerExpense صور</label>
                <input id="expFiles" type="file" name="attachments" accept=".jpg,.jpeg,.png,.gif,.webp" class="form-control" multiple data-attachment-input />
                <p class="a-hint">صيغ مسموحة: JPG, PNG, GIF, WEBP بحجم أقصى 5 ميغابايت للصورة، و@ECert.Models.ExpenseAttachment.MaxPerExpense صور كحد أقصى.</p>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-camera-open>
                        <i class="bi bi-camera"></i> التقاط صورة بالكاميرا
                    </button>
                </div>
                <div class="exp-thumbs mt-3" data-attachment-preview></div>
            </div>
            <div class="a-field a-field--full">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ المصروف</button>
            </div>
        </form>
    </div>
</div>

<partial name="_CameraCapture" />

@section Scripts {
    <script src="~/js/expense-attachments.js" asp-append-version="true"></script>
}

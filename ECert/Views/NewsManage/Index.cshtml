@{
    ViewData["Title"] = "إدارة الأخبار";
    ViewData["PageIcon"] = "bi-megaphone";
    ViewData["PageDesc"] = "نشر أخبار المركز وفعالياته على الموقع العام";
    Layout = "_AdminLayout";
    var news = ViewBag.News as List<ECert.Models.Post> ?? new();
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> إضافة خبر</a>
    </div>
</div>

<form method="get" class="a-toolbar" role="search">
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label visually-hidden" for="pageSearch">بحث</label>
        <div class="a-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="pageSearch" type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بعنوان الخبر..." />
        </div>
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search)) { <a asp-action="Index" class="btn btn-outline-secondary">مسح</a> }
    </div>
</form>

@if (news.Any())
{
    <div class="a-card">
        <div class="a-card__body a-card__body--flush">
            <div class="a-table-wrap">
                <table class="table a-table table-hover">
                    <thead>
                        <tr><th>الصورة</th><th>العنوان</th><th>الكاتب</th><th>الحالة</th><th>تاريخ النشر</th><th>إجراءات</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in news)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" class="a-thumb" />
                                    }
                                    else
                                    {
                                        <div class="a-thumb a-thumb--empty">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </td>
                                <td>@item.Title</td>
                                <td>@item.Author</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Published":
                                            @:<span class="a-badge a-badge--success">منشور</span>
                                            break;
                                        case "Draft":
                                            @:<span class="a-badge a-badge--warning">مسودة</span>
                                            break;
                                        case "Archived":
                                            @:<span class="a-badge a-badge--neutral">مؤرشف</span>
                                            break;
                                    }
                                </td>
                                <td>@item.PublishedAt?.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.PostId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                    @if (item.Status != "Published")
                                    {
                                        <form asp-action="Publish" asp-route-id="@item.PostId" method="post" class="d-inline">
                                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-globe"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Unpublish" asp-route-id="@item.PostId" method="post" class="d-inline">
                                            <button class="btn btn-sm btn-outline-warning"><i class="bi bi-eye-slash"></i></button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@item.PostId" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الخبر؟')">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="a-card">
        <div class="a-card__body">
            <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-megaphone", Title = "لا توجد أخبار", Text = "لم يُنشر أي خبر بعد. ابدأ بإضافة أول خبر.", ActionText = "إضافة أول خبر", ActionHref = Url.Action("Create") })" />
        </div>
    </div>
}

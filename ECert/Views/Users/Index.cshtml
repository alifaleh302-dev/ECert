@model List<User>
@{
    ViewData["Title"] = "إدارة المستخدمين";
    ViewData["PageIcon"] = "bi-people";
    ViewData["PageDesc"] = "إنشاء حسابات موظفي النظام وإدارتها وربطها بالأدوار المتاحة";
    Layout = "_AdminLayout";
    var roles = ViewBag.Roles as List<Role> ?? new();
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> إضافة مستخدم</a>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-shield-lock"></i> الأدوار والصلاحيات</a>
        }
    </div>
</div>

<form method="get" class="a-toolbar" role="search" aria-label="بحث وتصفية المستخدمين">
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label" for="userSearch">بحث</label>
        <div class="a-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="userSearch" type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="الاسم أو البريد أو اسم المستخدم..." />
        </div>
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="userRole">الدور</label>
        <select id="userRole" name="roleId" class="form-select">
            <option value="">كل الأدوار</option>
            @foreach (var r in roles)
            {
                <option value="@r.RoleId" selected="@(ViewBag.RoleId == r.RoleId)">@r.RoleName</option>
            }
        </select>
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="userStatus">الحالة</label>
        <select id="userStatus" name="status" class="form-select">
            <option value="">الكل</option>
            <option value="active" selected="@(ViewBag.Status == "active")">نشط</option>
            <option value="inactive" selected="@(ViewBag.Status == "inactive")">معطل</option>
        </select>
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> تصفية</button>
        <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
    </div>
</form>

<div class="a-card">
    <div class="a-card__body a-card__body--flush">
        <div class="a-table-wrap">
            <table class="table a-table table-hover align-middle">
                <thead>
                    <tr>
                        <th>اسم المستخدم</th>
                        <th>الاسم الكامل</th>
                        <th>البريد الإلكتروني</th>
                        <th>الأدوار</th>
                        <th>الحالة</th>
                        <th>آخر دخول</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td><code>@user.Username</code></td>
                                <td><strong>@user.FullName</strong></td>
                                <td>@user.Email</td>
                                <td>
                                    @foreach (var ur in user.UserRoles)
                                    {
                                        <span class="a-badge a-badge--info">@ur.Role?.RoleName</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive) { <span class="a-badge a-badge--success">نشط</span> }
                                    else { <span class="a-badge a-badge--danger">معطل</span> }
                                </td>
                                <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "لم يسجل دخول")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <form asp-action="ToggleActive" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-outline-warning" title="تعطيل" onclick="return confirm('هل تريد تعطيل هذا المستخدم؟')"><i class="bi bi-pause-circle"></i></button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success" title="تفعيل"><i class="bi bi-play-circle"></i></button>
                                            }
                                        </form>
                                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resetModal-@user.UserId" title="إعادة تعيين كلمة المرور">
                                            <i class="bi bi-key"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Reset Password Modal -->
                            <div class="modal fade" id="resetModal-@user.UserId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="ResetPassword" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <div class="modal-header">
                                                <h5 class="modal-title">إعادة تعيين كلمة المرور - @user.FullName</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">كلمة المرور الجديدة</label>
                                                    <input type="password" name="newPassword" class="form-control" required minlength="6" />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                <button type="submit" class="btn btn-primary">إعادة التعيين</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-0">
                                <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-people", Title = "لا يوجد مستخدمون", Text = "لم يُعثر على أي حساب مطابق. جرّب تعديل الفلاتر أو أضف مستخدمًا جديدًا." })" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

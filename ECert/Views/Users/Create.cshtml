@model ECert.Models.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "إضافة مستخدم";
    ViewData["PageIcon"] = "bi-person-plus";
    ViewData["PageDesc"] = "أنشئ حساب مستخدم وامنحه الدور المناسب";
    Layout = "_AdminLayout";
    var roles = ViewBag.Roles as List<Role> ?? new();
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للمستخدمين</a>
    </div>
</div>

<div class="a-card a-card--narrow">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-person-plus" aria-hidden="true"></i> بيانات المستخدم</h2>
    </div>
    <div class="a-card__body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>

            <div class="a-field">
                <label asp-for="Username" class="a-label a-label--required"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="a-error"></span>
            </div>
            <div class="a-field">
                <label asp-for="FullName" class="a-label a-label--required"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="a-error"></span>
            </div>
            <div class="a-form__grid a-form__grid--2">
                <div class="a-field">
                    <label asp-for="Email" class="a-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="a-error"></span>
                </div>
                <div class="a-field">
                    <label asp-for="Phone" class="a-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="a-error"></span>
                </div>
            </div>
            <div class="a-field">
                <label asp-for="Password" class="a-label a-label--required"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="a-error"></span>
            </div>
            <div class="a-field">
                <label asp-for="RoleId" class="a-label a-label--required"></label>
                <select asp-for="RoleId" class="form-select">
                    <option value="">-- اختر الدور --</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role.RoleId">@role.RoleName</option>
                    }
                </select>
                <span asp-validation-for="RoleId" class="a-error"></span>
            </div>

            <div class="a-form__actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> إنشاء المستخدم</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

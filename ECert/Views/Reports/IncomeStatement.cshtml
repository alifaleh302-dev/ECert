@{
    ViewData["Title"] = "قائمة الدخل";
    ViewData["PageIcon"] = "bi-file-earmark-text";
    ViewData["PageDesc"] = "الإيرادات المحصَّلة ناقص الاستردادات والمصروفات المعتمدة خلال الفترة";
    Layout = "_AdminLayout";
    var expenses = ViewBag.Expenses as List<(string Category, decimal Total)> ?? new();
    decimal collections = ViewBag.Collections is decimal c ? c : 0m;
    decimal refunds = ViewBag.Refunds is decimal r ? r : 0m;
    decimal netRevenue = ViewBag.NetRevenue is decimal nr ? nr : 0m;
    decimal expenseTotal = ViewBag.ExpenseTotal is decimal et ? et : 0m;
    decimal netIncome = ViewBag.NetIncome is decimal ni ? ni : 0m;
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="ExportIncomeStatementXlsx" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> تصدير XLSX
        </a>
    </div>
</div>

<form method="get" class="a-toolbar" role="search" aria-label="نطاق التاريخ">
    <div class="a-toolbar__field">
        <label class="a-field__label" for="isFrom">من</label>
        <input id="isFrom" type="date" name="from" value="@ViewBag.From" class="form-control" />
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="isTo">إلى</label>
        <input id="isTo" type="date" name="to" value="@ViewBag.To" class="form-control" />
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> عرض</button>
        <a asp-action="IncomeStatement" class="btn btn-outline-secondary">إعادة تعيين</a>
    </div>
</form>

<section class="a-kpis mb-4" aria-label="ملخص قائمة الدخل">
    <partial name="_KpiCard" model="@(new ECert.ViewModels.KpiCard { Label = "الإيراد المحصَّل", Value = collections.ToString("N2"), Icon = "bi-cash-stack", Tone = "success", Hint = Currency.Symbol })" />
    <partial name="_KpiCard" model="@(new ECert.ViewModels.KpiCard { Label = "صافي الإيراد", Value = netRevenue.ToString("N2"), Icon = "bi-graph-up-arrow", Tone = "brand", Hint = "بعد الاستردادات" })" />
    <partial name="_KpiCard" model="@(new ECert.ViewModels.KpiCard { Label = "إجمالي المصروفات", Value = expenseTotal.ToString("N2"), Icon = "bi-cart-dash", Tone = "danger", Hint = "المعتمدة فقط" })" />
    <partial name="_KpiCard" model="@(new ECert.ViewModels.KpiCard { Label = "صافي الدخل", Value = netIncome.ToString("N2"), Icon = "bi-cash-coin", Tone = (netIncome >= 0 ? "success" : "danger"), Hint = Currency.Symbol })" />
</section>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="a-card h-100">
            <div class="a-card__header">
                <h2 class="a-card__title"><i class="bi bi-arrow-down-up" aria-hidden="true"></i> الإيرادات</h2>
            </div>
            <div class="a-card__body">
                <table class="table a-table align-middle">
                    <tbody>
                        <tr><td>التحصيلات (الدفعات)</td><td class="a-amount a-amount--in fw-bold">@collections.ToString("N2") @Currency.Symbol</td></tr>
                        <tr><td>الاستردادات المعتمدة</td><td class="a-amount a-amount--out fw-bold">− @refunds.ToString("N2") @Currency.Symbol</td></tr>
                        <tr class="border-top"><td class="fw-bold">صافي الإيراد</td><td class="a-amount fw-bold">@netRevenue.ToString("N2") @Currency.Symbol</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="a-card h-100">
            <div class="a-card__header">
                <h2 class="a-card__title"><i class="bi bi-cart-dash" aria-hidden="true"></i> المصروفات حسب البند</h2>
            </div>
            <div class="a-card__body">
                @if (expenses.Any())
                {
                    <table class="table a-table align-middle">
                        <tbody>
                            @foreach (var e in expenses)
                            {
                                <tr><td>@e.Category</td><td class="a-amount a-amount--out">@e.Total.ToString("N2") @Currency.Symbol</td></tr>
                            }
                            <tr class="border-top"><td class="fw-bold">إجمالي المصروفات</td><td class="a-amount a-amount--out fw-bold">@expenseTotal.ToString("N2") @Currency.Symbol</td></tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="a-hint mb-0">لا توجد مصروفات معتمدة في هذه الفترة.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="a-card mt-4">
    <div class="a-card__body text-center">
        <span class="a-hint">صافي الدخل</span>
        <div class="display-6 fw-bold @(netIncome >= 0 ? "text-success" : "text-danger")">@netIncome.ToString("N2") @Currency.Symbol</div>
    </div>
</div>

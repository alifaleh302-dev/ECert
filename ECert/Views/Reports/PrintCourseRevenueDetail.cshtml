@model CourseRevenueDetailViewModel
@{
    ViewData["Title"] = "طباعة تفاصيل تحصيلات الدورة";
    Layout = "_AdminLayout";
    var from = ViewBag.From as string;
    var to = ViewBag.To as string;
    decimal Pct(decimal part, decimal whole) => whole > 0 ? Math.Round(part / whole * 100m, 1) : 0m;
}

@section Styles {
    <style>
        .crp-actions { display: flex; gap: .5rem; margin-bottom: 1rem; }
        .crp-sheet { background: #fff; color: #1a2233; max-width: 900px; margin-inline: auto; padding: 1.5rem; font-family: "Tajawal", "Segoe UI", system-ui, sans-serif; }
        .crp-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #14335c; padding-bottom: .75rem; margin-bottom: 1rem; }
        .crp-head h1 { margin: 0; font-size: 1.25rem; color: #14335c; }
        .crp-head p { margin: 0; font-size: .8rem; color: #6b7688; }
        .crp-meta { display: grid; grid-template-columns: repeat(2, 1fr); gap: .35rem 1.5rem; margin-bottom: 1rem; font-size: .9rem; }
        .crp-meta span { color: #6b7688; }
        .crp-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: .6rem; margin-bottom: 1rem; }
        .crp-kpi { border: 1px solid #d8dee9; border-radius: 8px; padding: .6rem .75rem; }
        .crp-kpi b { display: block; font-size: 1.05rem; color: #14335c; }
        .crp-kpi span { font-size: .72rem; color: #6b7688; }
        .crp-table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
        .crp-table th, .crp-table td { border: 1px solid #e2e7ef; padding: .4rem .6rem; font-size: .85rem; text-align: start; }
        .crp-table th { background: #f4f6fa; color: #42506b; }
        .crp-table td.num { text-align: end; font-variant-numeric: tabular-nums; }
        .crp-section { font-size: .95rem; color: #14335c; margin: .5rem 0; }
        @@media print {
            @@page { size: A4; margin: 12mm; }
            .no-print, .admin-nav, .admin-topbar, .admin-nav__footer { display: none !important; }
            .admin-shell, .admin-main, .admin-content { display: block !important; padding: 0 !important; margin: 0 !important; background: #fff !important; }
            .crp-sheet { max-width: none; padding: 0; }
            .crp-table th, .crp-table td { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
}

<div class="crp-actions no-print">
    <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة / حفظ PDF</button>
    <button type="button" class="btn btn-outline-secondary" onclick="window.close()">إغلاق</button>
</div>

<div class="crp-sheet">
    <header class="crp-head">
        <div>
            <h1>تقرير تحصيلات الدورة</h1>
            <p>@Model.CourseName</p>
        </div>
        <p>تاريخ الطباعة: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
    </header>

    <div class="crp-meta">
        <div><span>الفئة:</span> @Model.CategoryName</div>
        <div><span>الفترة:</span> @(string.IsNullOrWhiteSpace(from) ? "البداية" : from) — @(string.IsNullOrWhiteSpace(to) ? "الآن" : to)</div>
    </div>

    <div class="crp-kpis">
        <div class="crp-kpi"><span>الإيراد المتوقع</span><b>@Model.Expected.ToString("N2") @Currency.Symbol</b></div>
        <div class="crp-kpi"><span>المدفوع</span><b>@Model.Paid.ToString("N2") @Currency.Symbol</b></div>
        <div class="crp-kpi"><span>المسترد</span><b>@Model.Refunds.ToString("N2") @Currency.Symbol</b></div>
        <div class="crp-kpi"><span>صافي الإيراد الفعلي</span><b>@Model.NetPaid.ToString("N2") @Currency.Symbol</b></div>
    </div>

    <h2 class="crp-section">تحصيلات المتدربين</h2>
    <table class="crp-table">
        <thead>
            <tr><th>#</th><th>الفاتورة</th><th>المتدرب</th><th>الهاتف</th><th>المتوقع</th><th>المدفوع</th><th>المسترد</th><th>صافي المدفوع</th><th>المتبقي</th></tr>
        </thead>
        <tbody>
            @{ var i = 0; }
            @foreach (var t in Model.Trainees)
            {
                i++;
                <tr>
                    <td class="num">@i</td>
                    <td>@t.InvoiceNumber</td>
                    <td>@t.TraineeName</td>
                    <td dir="ltr">@t.Phone</td>
                    <td class="num">@t.Expected.ToString("N2")</td>
                    <td class="num">@t.Paid.ToString("N2")</td>
                    <td class="num">@t.Refunds.ToString("N2")</td>
                    <td class="num">@t.NetPaid.ToString("N2")</td>
                    <td class="num">@t.Remaining.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4">الإجمالي</th>
                <th class="num">@Model.Expected.ToString("N2")</th>
                <th class="num">@Model.Paid.ToString("N2")</th>
                <th class="num">@Model.Refunds.ToString("N2")</th>
                <th class="num">@Model.NetPaid.ToString("N2")</th>
                <th class="num">@Model.Remaining.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>

    <h2 class="crp-section">التوزيع حسب الموظف</h2>
    <table class="crp-table">
        <thead><tr><th>الموظف</th><th>عدد الدفعات</th><th>المبلغ</th></tr></thead>
        <tbody>
            @foreach (var r in Model.ByEmployee)
            {
                <tr><td>@r.Label</td><td class="num">@r.Count</td><td class="num">@r.Amount.ToString("N2") @Currency.Symbol</td></tr>
            }
        </tbody>
    </table>

    <h2 class="crp-section">التوزيع حسب طريقة الدفع</h2>
    <table class="crp-table">
        <thead><tr><th>طريقة الدفع</th><th>عدد الدفعات</th><th>المبلغ</th><th>النسبة</th></tr></thead>
        <tbody>
            @{ var methodTotal = Model.ByMethod.Sum(r => r.Amount); }
            @foreach (var r in Model.ByMethod)
            {
                <tr><td>@r.Label</td><td class="num">@r.Count</td><td class="num">@r.Amount.ToString("N2") @Currency.Symbol</td><td class="num">@Pct(r.Amount, methodTotal)%</td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        window.addEventListener('load', function () { window.print(); });
    </script>
}

@{
    ViewData["Title"] = "تقرير إيرادات الدورات";
    ViewData["PageIcon"] = "bi-graph-up-arrow";
    ViewData["PageDesc"] = "تحليل الإيرادات والمدفوعات لكل دورة تدريبية";
    Layout = "_AdminLayout";
    var data = ViewBag.Data as List<CourseRevenueRowViewModel> ?? new();
    var courses = ViewBag.Courses as List<Course> ?? new();
    bool canTransfer = ViewBag.CanTransfer is bool b && b;
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-controller="Cashbox" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-safe"></i> الصندوق
        </a>
        <a asp-action="ExportCourseRevenueXlsx" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> تصدير XLSX
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<form method="get" class="a-toolbar" role="search" aria-label="تصفية تقارير الإيرادات">
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label" for="revenueCourse">اسم الدورة</label>
        <select id="revenueCourse" name="courseId" class="form-select">
            <option value="">كل الدورات</option>
            @if (courses != null)
            {
                @foreach (var c in courses)
                {
                    <option value="@c.CourseId" selected="@(ViewBag.CourseId == c.CourseId)">@c.CourseName</option>
                }
            }
        </select>
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> تصفية</button>
        <a asp-action="CourseRevenue" class="btn btn-outline-secondary">مسح</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        @if (data != null && data.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>الدورة</th>
                            <th>المسجلين</th>
                            <th>المتوقع</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th>نقدي</th>
                            <th>محافظ</th>
                            <th class="text-center">رصيد مرحَّل</th>
                            <th class="text-center">رصيد دون ترحيل</th>
                            @if (canTransfer)
                            {
                                <th class="text-center" style="min-width:160px">ترحيل إلى الصندوق</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in data)
                        {
                            <tr>
                                <td class="fw-bold">@item.CourseName</td>
                                <td>@item.Registrations</td>
                                <td>@(((decimal)item.Expected).ToString("N0")) ريال</td>
                                <td class="text-success fw-bold">@(((decimal)item.Paid).ToString("N0")) ريال</td>
                                <td class="text-danger">@(((decimal)item.Remaining).ToString("N0")) ريال</td>
                                <td>@(((decimal)item.Cash).ToString("N0")) ريال</td>
                                <td>@(((decimal)item.Bank).ToString("N0")) ريال</td>
                                <td class="text-center">
                                    <span class="badge bg-success">@(((decimal)item.Transferred).ToString("N0")) ريال</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        var avail = (decimal)item.AvailableToTransfer;
                                        var badgeClass = avail > 0 ? "bg-warning text-dark" : "bg-light text-muted";
                                    }
                                    <span class="badge @badgeClass">@avail.ToString("N0") ريال</span>
                                </td>
                                @if (canTransfer)
                                {
                                    <td class="text-center">
                                        @if (((decimal)item.AvailableToTransfer) > 0)
                                        {
                                            <form asp-controller="Cashbox" asp-action="Transfer" method="post" class="d-inline-flex gap-1 align-items-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="courseId" value="@item.CourseId" />
                                                <input type="number" name="amount" min="0.01" step="0.01"
                                                       max="@(((decimal)item.AvailableToTransfer).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                       value="@(((decimal)item.AvailableToTransfer).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                                                       class="form-control form-control-sm" style="width:130px" required />
                                                <button type="submit" class="btn btn-sm btn-primary"
                                                        onclick="return confirm('ترحيل @(((decimal)item.AvailableToTransfer).ToString("N0")) ريال من هذه الدورة إلى الصندوق؟');">
                                                    <i class="bi bi-arrow-left-circle"></i> ترحيل
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (canTransfer)
            {
                <p class="text-muted small mb-0 mt-2">
                    <i class="bi bi-info-circle"></i>
                    زر "ترحيل" يظهر فقط عندما يكون هناك رصيد "بدون ترحيل" أكبر من صفر. المبلغ المُدخل لا يجتاز الرصيد المتاح.
                </p>
            }
        }
        else
        {
            <p class="text-center text-muted py-4">لا توجد بيانات</p>
        }
    </div>
</div>

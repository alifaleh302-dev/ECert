@{
    ViewData["Title"] = "تقرير إيرادات الدورات";
    ViewData["PageIcon"] = "bi-graph-up-arrow";
    ViewData["PageDesc"] = "تحليل تفصيلي للإيرادات: المتوقع، المحصّل، المسترد، وصافي الإيراد الفعلي لكل دورة";
    Layout = "_AdminLayout";
    var data = ViewBag.Data as List<CourseRevenueRowViewModel> ?? new();
    var summary = ViewBag.Summary as CourseRevenueSummaryViewModel ?? new();
    var categories = ViewBag.Categories as List<Category> ?? new();
    var courses = ViewBag.Courses as List<Course> ?? new();
    int? categoryId = ViewBag.CategoryId as int?;
    int? courseId = ViewBag.CourseId as int?;
    string? status = ViewBag.Status as string;

    var courseStatuses = new (string Value, string Label)[]
    {
        ("Draft", "مسودة"),
        ("OpenForRegistration", "مفتوحة للتسجيل"),
        ("InProgress", "جارية"),
        ("Completed", "مكتملة"),
        ("Archived", "مؤرشفة")
    };

    string BarTone(decimal pct) => pct >= 80 ? "success" : pct >= 40 ? "warning" : "danger";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="ExportCourseRevenueXlsx" asp-route-categoryId="@categoryId" asp-route-courseId="@courseId"
           asp-route-status="@status" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> تصدير XLSX
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="a-note a-note--success mb-3" role="status">
        <i class="bi bi-check-circle" aria-hidden="true"></i> <div>@TempData["Success"]</div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="a-note a-note--danger mb-3" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> <div>@TempData["Error"]</div>
    </div>
}

<section class="a-kpis mb-4" aria-label="ملخص الإيرادات">
    <partial name="_KpiCard" model="@(new KpiCard { Label = "إجمالي الإيراد المتوقع", Value = summary.Expected.ToString("N0"), Icon = "bi-cash-stack", Tone = "brand", Hint = Currency.Symbol })" />
    <partial name="_KpiCard" model="@(new KpiCard { Label = "صافي المحصّل الفعلي", Value = summary.NetPaid.ToString("N0"), Icon = "bi-graph-up-arrow", Tone = "success", Hint = $"نقدي {summary.Cash.ToString("N0")} · محافظ {summary.Wallet.ToString("N0")} {Currency.Symbol}" })" />
    <partial name="_KpiCard" model="@(new KpiCard { Label = "إجمالي المتبقي", Value = summary.Remaining.ToString("N0"), Icon = "bi-hourglass-split", Tone = "warning", Hint = Currency.Symbol })" />
    <partial name="_KpiCard" model="@(new KpiCard { Label = "نسبة التحصيل الإجمالية", Value = $"{summary.CollectionPercent}%", Icon = "bi-percent", Tone = "info", Hint = "صافي المحصّل ÷ المتوقع" })" />
</section>

<form method="get" class="a-toolbar" role="search" aria-label="تصفية تقرير الإيرادات">
    <div class="a-toolbar__field">
        <label class="a-field__label" for="revCategory">الفئة</label>
        <select id="revCategory" name="categoryId" class="form-select">
            <option value="">كل الفئات</option>
            @foreach (var c in categories)
            {
                <option value="@c.CategoryId" selected="@(categoryId == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label" for="revCourse">الدورة</label>
        <select id="revCourse" name="courseId" class="form-select">
            <option value="">كل الدورات</option>
            @foreach (var c in courses)
            {
                <option value="@c.CourseId" selected="@(courseId == c.CourseId)">@c.CourseName</option>
            }
        </select>
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="revStatus">حالة الدورة</label>
        <select id="revStatus" name="status" class="form-select">
            <option value="">كل الحالات</option>
            @foreach (var s in courseStatuses)
            {
                <option value="@s.Value" selected="@(status == s.Value)">@s.Label</option>
            }
        </select>
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="revFrom">من</label>
        <input id="revFrom" type="date" name="from" value="@ViewBag.From" class="form-control" />
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="revTo">إلى</label>
        <input id="revTo" type="date" name="to" value="@ViewBag.To" class="form-control" />
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> تصفية</button>
        <a asp-action="CourseRevenue" class="btn btn-outline-secondary">مسح</a>
    </div>
</form>

<div class="a-card">
    <div class="a-card__body">
        @if (data.Count > 0)
        {
            <div class="a-table-wrap">
                <table class="table a-table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>الدورة</th>
                            <th>الفئة</th>
                            <th>المسجلين</th>
                            <th>المتوقع</th>
                            <th>المدفوع</th>
                            <th>المسترد (Refunds)</th>
                            <th>صافي الإيراد الفعلي</th>
                            <th>المتبقي</th>
                            <th style="min-width:160px">نسبة التحصيل %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in data)
                        {
                            var pct = item.CollectionPercent;
                            <tr>
                                <td class="fw-bold">
                                    <a asp-action="CourseRevenueDetail" asp-route-courseId="@item.CourseId"
                                       asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To"
                                       class="text-decoration-none">@item.CourseName</a>
                                </td>
                                <td class="small text-muted">@item.CategoryName</td>
                                <td>@item.Registrations</td>
                                <td>@item.Expected.ToString("N0") @Currency.Symbol</td>
                                <td class="text-success fw-bold">@item.Paid.ToString("N0") @Currency.Symbol</td>
                                <td class="text-danger">@(item.Refunds > 0 ? item.Refunds.ToString("N0") : "—")</td>
                                <td class="fw-bold">@item.NetPaid.ToString("N0") @Currency.Symbol</td>
                                <td class="text-danger">@item.Remaining.ToString("N0") @Currency.Symbol</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="a-progress flex-grow-1" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                            <div class="a-progress__bar a-progress__bar--@BarTone(pct)" style="width:@(pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                        <span class="small fw-bold">@pct%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td>الإجمالي</td>
                            <td></td>
                            <td>@data.Sum(r => r.Registrations)</td>
                            <td>@summary.Expected.ToString("N0") @Currency.Symbol</td>
                            <td class="text-success">@data.Sum(r => r.Paid).ToString("N0") @Currency.Symbol</td>
                            <td class="text-danger">@data.Sum(r => r.Refunds).ToString("N0") @Currency.Symbol</td>
                            <td>@summary.NetPaid.ToString("N0") @Currency.Symbol</td>
                            <td class="text-danger">@summary.Remaining.ToString("N0") @Currency.Symbol</td>
                            <td>@summary.CollectionPercent%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="text-muted small mb-0 mt-2">
                <i class="bi bi-info-circle"></i>
                اضغط على اسم الدورة لعرض تفاصيل تحصيلات المتدربين وتوزيعها حسب الموظف وطريقة الدفع.
                الأموال تصل إلى الصندوق الرئيسي فقط عبر توريد العهدة من صفحة
                <a asp-controller="Custody" asp-action="Index">عهدة الموظف</a>.
            </p>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-graph-up-arrow", Title = "لا توجد بيانات", Text = "لا توجد دورات مطابقة للفلاتر المحددة." })" />
        }
    </div>
</div>

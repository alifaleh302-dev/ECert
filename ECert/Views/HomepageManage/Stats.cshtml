@model List<ECert.Models.StatCard>
@{
    ViewData["Title"] = "إدارة الإحصائيات";
    ViewData["PageIcon"] = "bi-bar-chart";
    ViewData["PageDesc"] = "إدارة بطاقات الإحصائيات المعروضة في الصفحة الرئيسية";
    Layout = "_AdminLayout";
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-right me-1"></i>الرجوع إلى إدارة الصفحة الرئيسية</a>

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<form method="post" action="/HomepageManage/SaveStats">
    <div class="row g-4">
        @for (int i = 0; i < Model.Count; i++)
        {
            var s = Model[i];
            <div class="col-md-6">
                <div class="a-card">
                    <div class="a-card__body">
                        <input type="hidden" name="stats[@i].StatCardId" value="@s.StatCardId" />
                        <div class="row g-3">
                            <div class="col-8">
                                <label class="form-label">التسمية</label>
                                <input type="text" name="stats[@i].Label" value="@s.Label" class="form-control" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">اللون</label>
                                <input type="color" name="stats[@i].Color" value="@s.Color" class="form-control form-control-color w-100" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">الأيقونة</label>
                                <input type="text" name="stats[@i].IconClass" value="@s.IconClass" class="form-control" placeholder="bi-star" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">المصدر التلقائي</label>
                                <select name="stats[@i].DynamicSource" class="form-select">
                                    @{ var src = s.DynamicSource; }
                                    <option value="Courses" selected="@(src == "Courses")">الدورات</option>
                                    <option value="Instructors" selected="@(src == "Instructors")">المدربون</option>
                                    <option value="Trainees" selected="@(src == "Trainees")">المتدربون</option>
                                    <option value="Certificates" selected="@(src == "Certificates")">الشهادات</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-4">
                                    <input type="hidden" name="stats[@i].IsDynamic" value="false" />
                                    <input class="form-check-input" type="checkbox" name="stats[@i].IsDynamic" value="true" id="dyn_@i" @(s.IsDynamic ? "checked" : "") />
                                    <label class="form-check-label" for="dyn_@i">تلقائي من قاعدة البيانات</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check mt-4">
                                    <input type="hidden" name="stats[@i].IsActive" value="false" />
                                    <input class="form-check-input" type="checkbox" name="stats[@i].IsActive" value="true" id="act_@i" @(s.IsActive ? "checked" : "") />
                                    <label class="form-check-label" for="act_@i">ظاهر</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label">قيمة ثابتة (إذا غير تلقائي)</label>
                                <input type="number" name="stats[@i].StaticValue" value="@s.StaticValue" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-4">
        <button class="btn btn-primary"><i class="bi bi-check me-1"></i>حفظ الإحصائيات</button>
    </div>
</form>

@model List<ECert.Models.SocialLink>
@{
    ViewData["Title"] = "روابط التواصل الاجتماعي";
    ViewData["PageIcon"] = "bi-share";
    ViewData["PageDesc"] = "إدارة حسابات المركز على منصات التواصل الاجتماعي";
    Layout = "_AdminLayout";
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-right me-1"></i>الرجوع إلى إدارة الصفحة الرئيسية</a>

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<div class="a-note a-note--info mb-4" role="note">
    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
    <div>
        <strong>طريقة الظهور للعامة:</strong> الرابط يظهر للزوار في تذييل الموقع فقط عندما تكون <strong>الحالة مفعّلة</strong> (محددة) <strong>وبرابط حقيقي</strong> يبدأ بـ <code>https://</code> — الروابط التي قيمتها <code>#</code> أو فارغة لا تظهر أبداً.
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-8">
        <form method="post" action="/HomepageManage/SaveSocial">
            <div class="a-card">
                <div class="a-card__header"><strong>الروابط الحالية</strong></div>
                <div class="a-card__body a-card__body--flush">
                    <div class="a-table-wrap">
                        <table class="table align-middle mb-0 social-table">
                            <thead>
                                <tr><th>المنصة</th><th>الأيقونة</th><th>الرابط</th><th>الحالة</th><th></th></tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var l = Model[i];
                                    <tr>
                                        <td data-label="المنصة">
                                            <input type="hidden" name="links[@i].SocialLinkId" value="@l.SocialLinkId" />
                                            <input type="hidden" name="links[@i].SortOrder" value="@l.SortOrder" />
                                            <input type="text" name="links[@i].PlatformName" value="@l.PlatformName" class="form-control form-control-sm" />
                                        </td>
                                        <td data-label="الأيقونة">
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="text" name="links[@i].IconClass" value="@l.IconClass" class="form-control form-control-sm" />
                                                <i class="bi @l.IconClass fs-5"></i>
                                            </div>
                                        </td>
                                        <td data-label="الرابط" class="url-cell">
                                            <input type="text" name="links[@i].Url" value="@l.Url" class="form-control form-control-sm text-start" dir="ltr" />
                                        </td>
                                        <td data-label="الحالة">
                                            <div class="form-check form-switch mb-0">
                                                <input type="checkbox" name="links[@i].IsActive" value="true" class="form-check-input" id="active-@l.SocialLinkId" @(l.IsActive ? "checked" : "") />
                                                <label class="form-check-label small" for="active-@l.SocialLinkId">مفعّل</label>
                                            </div>
                                            <input type="hidden" name="links[@i].IsActive" value="false" />
                                        </td>
                                        <td data-label="إجراء">
                                            <form method="post" action="/HomepageManage/DeleteSocial" class="d-inline" onsubmit="return confirm('حذف؟')">
                                                <input type="hidden" name="id" value="@l.SocialLinkId" />
                                                <button class="btn btn-outline-danger btn-icon" title="حذف"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary save-btn"><i class="bi bi-check me-1"></i>حفظ الروابط</button>
            </div>
        </form>
    </div>
    <div class="col-12 col-md-4">
        <div class="a-card">
            <div class="a-card__header"><strong>إضافة منصة</strong></div>
            <div class="a-card__body">
                <form method="post" action="/HomepageManage/AddSocial">
                    <div class="mb-3">
                        <label class="form-label">اسم المنصة</label>
                        <input type="text" name="platformName" class="form-control" placeholder="WhatsApp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الأيقونة (Bootstrap Icon)</label>
                        <input type="text" name="iconClass" class="form-control" placeholder="bi-whatsapp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الرابط</label>
                        <input type="text" name="url" class="form-control text-start" dir="ltr" placeholder="https://..." />
                    </div>
                    <button class="btn btn-success w-100"><i class="bi bi-plus me-1"></i>إضافة</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .social-table input.form-control { min-width: 110px; }
    .social-table .url-cell input.form-control { min-width: 200px; }
    .btn-icon { min-width: 38px; min-height: 38px; }
    .save-btn { width: 100%; }
    @@media (min-width: 768px) {
        .save-btn { width: auto; }
    }
    @@media (max-width: 767.98px) {
        .social-table thead { display: none; }
        .social-table, .social-table tbody, .social-table tr, .social-table td { display: block; width: 100%; }
        .social-table tr {
            border: 1px solid var(--a-border);
            border-radius: 0.75rem;
            padding: 0.75rem;
            margin-bottom: 1rem;
            background: var(--a-surface);
        }
        .social-table td {
            border: 0 !important;
            padding: 0.35rem 0 !important;
        }
        .social-table td::before {
            content: attr(data-label);
            display: block;
            font-size: 0.75rem;
            color: var(--a-text-3);
            margin-bottom: 0.15rem;
        }
        .social-table input.form-control,
        .social-table .url-cell input.form-control { min-width: 0; width: 100%; }
        .social-table .form-switch { display: inline-flex; align-items: center; gap: 0.5rem; }
    }
</style>

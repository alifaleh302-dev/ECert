@model List<ECert.Models.HomepageSection>
@{
    ViewData["Title"] = "إدارة الأقسام";
    ViewData["PageIcon"] = "bi-layout-three-columns";
    ViewData["PageDesc"] = "إظهار وإخفاء وترتيب أقسام الصفحة الرئيسية";
    Layout = "_AdminLayout";
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-right me-1"></i>الرجوع إلى إدارة الصفحة الرئيسية</a>

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<div class="a-card">
    <div class="a-card__body a-card__body--flush">
        <table class="table a-table table-hover align-middle mb-0">
            <thead>
                <tr><th>القسم</th><th>المعرف</th><th>الحالة</th><th>الترتيب</th></tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var s = Model[i];
                    <tr>
                        <td><strong>@s.SectionName</strong></td>
                        <td><code>@s.SectionKey</code></td>
                        <td>
                            <form method="post" action="/HomepageManage/ToggleSection">
                                <input type="hidden" name="id" value="@s.HomepageSectionId" />
                                <button type="submit" class="btn btn-sm @(s.IsVisible ? "btn-success" : "btn-outline-secondary")">
                                    <i class="bi @(s.IsVisible ? "bi-eye" : "bi-eye-slash") me-1"></i>
                                    @(s.IsVisible ? "ظاهر" : "مخفي")
                                </button>
                            </form>
                        </td>
                        <td>
                            <form method="post" action="/HomepageManage/MoveSection" class="d-inline">
                                <input type="hidden" name="id" value="@s.HomepageSectionId" />
                                <input type="hidden" name="direction" value="-1" />
                                <button class="btn btn-sm btn-outline-secondary" @(i == 0 ? "disabled" : "")><i class="bi bi-arrow-up"></i></button>
                            </form>
                            <form method="post" action="/HomepageManage/MoveSection" class="d-inline">
                                <input type="hidden" name="id" value="@s.HomepageSectionId" />
                                <input type="hidden" name="direction" value="1" />
                                <button class="btn btn-sm btn-outline-secondary" @(i == Model.Count - 1 ? "disabled" : "")><i class="bi bi-arrow-down"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

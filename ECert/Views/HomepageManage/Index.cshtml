@{
    ViewData["Title"] = "إدارة الصفحة الرئيسية";
    ViewData["PageIcon"] = "bi-house-gear";
    ViewData["PageDesc"] = "التحكم الكامل في محتوى وتصميم الصفحة الرئيسية للموقع";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a href="/" target="_blank" class="btn btn-outline-primary"><i class="bi bi-eye me-1"></i>معاينة الموقع</a>
    </div>
</div>

<div class="a-tiles">
    <a href="/HomepageManage/Slides" class="a-tile">
        <span class="a-tile__icon"><i class="bi bi-images" aria-hidden="true"></i></span>
        <span class="a-tile__title">الشرائح (Slider)</span>
        <span class="a-tile__text">إدارة شرائح القسم الرئيسي</span>
    </a>
    <a href="/HomepageManage/AnimatedTexts" class="a-tile a-tile--success">
        <span class="a-tile__icon"><i class="bi bi-type" aria-hidden="true"></i></span>
        <span class="a-tile__title">النصوص المتحركة</span>
        <span class="a-tile__text">نصوص متغيرة في القسم الرئيسي</span>
    </a>
    <a href="/HomepageManage/Sections" class="a-tile a-tile--warning">
        <span class="a-tile__icon"><i class="bi bi-layout-three-columns" aria-hidden="true"></i></span>
        <span class="a-tile__title">إدارة الأقسام</span>
        <span class="a-tile__text">إظهار/إخفاء وترتيب الأقسام</span>
    </a>
    <a href="/HomepageManage/Stats" class="a-tile a-tile--info">
        <span class="a-tile__icon"><i class="bi bi-bar-chart" aria-hidden="true"></i></span>
        <span class="a-tile__title">الإحصائيات</span>
        <span class="a-tile__text">بطاقات الأرقام والإحصائيات</span>
    </a>
    <a href="/HomepageManage/Contact" class="a-tile a-tile--danger">
        <span class="a-tile__icon"><i class="bi bi-telephone" aria-hidden="true"></i></span>
        <span class="a-tile__title">معلومات التواصل</span>
        <span class="a-tile__text">الهاتف، البريد، العنوان</span>
    </a>
    <a href="/HomepageManage/Social" class="a-tile">
        <span class="a-tile__icon"><i class="bi bi-share" aria-hidden="true"></i></span>
        <span class="a-tile__title">التواصل الاجتماعي</span>
        <span class="a-tile__text">روابط المنصات الاجتماعية</span>
    </a>
    <a href="/HomepageManage/AboutFooter" class="a-tile a-tile--success">
        <span class="a-tile__icon"><i class="bi bi-layout-text-sidebar-reverse" aria-hidden="true"></i></span>
        <span class="a-tile__title">من نحن والفوتر</span>
        <span class="a-tile__text">نبذة المركز والتحكم في ظهور الفوتر</span>
    </a>
    <a href="/HomepageManage/Theme" class="a-tile a-tile--neutral">
        <span class="a-tile__icon"><i class="bi bi-palette" aria-hidden="true"></i></span>
        <span class="a-tile__title">الألوان والهوية</span>
        <span class="a-tile__text">تخصيص ألوان الموقع</span>
    </a>
    <a href="/HomepageManage/SiteSettings" class="a-tile a-tile--neutral">
        <span class="a-tile__icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
        <span class="a-tile__title">إعدادات الموقع</span>
        <span class="a-tile__text">الاسم، الشعار، SEO</span>
    </a>
</div>

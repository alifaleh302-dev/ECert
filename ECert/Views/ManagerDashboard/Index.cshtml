@{
    ViewData["Title"] = "لوحة الإداري";
    ViewData["PageIcon"] = "bi-clipboard-data";
    ViewData["PageDesc"] = "متابعة التسجيلات والدورات والمدربين والشهادات";
    Layout = "_AdminLayout";

    var recentRegs = ViewBag.RecentRegistrations as List<ECert.Models.Registration> ?? new();

    var kpis = new List<KpiCard>
    {
        new() { Label = "تسجيلات معلقة", Value = ViewBag.PendingRegistrations?.ToString() ?? "0", Icon = "bi-hourglass-split", Tone = "warning", Hint = "بحاجة إلى مراجعة", Href = Url.Action("Index", "Registrations", new { status = "Pending" }) },
        new() { Label = "متدربون مقبولون", Value = ViewBag.TotalTrainees?.ToString() ?? "0", Icon = "bi-people", Tone = "success" },
        new() { Label = "دورات نشطة", Value = ViewBag.ActiveCourses?.ToString() ?? "0", Icon = "bi-book", Tone = "brand", Hint = "متاحة للتسجيل", Href = Url.Action("Index", "CoursesManage") },
        new() { Label = "إجمالي الدورات", Value = ViewBag.TotalCourses?.ToString() ?? "0", Icon = "bi-journal-bookmark", Tone = "info" },
        new() { Label = "المدربون", Value = ViewBag.TotalInstructors?.ToString() ?? "0", Icon = "bi-person-badge", Tone = "neutral", Href = Url.Action("Index", "Instructors") },
        new() { Label = "شهادات صادرة", Value = ViewBag.CertificatesIssued?.ToString() ?? "0", Icon = "bi-award", Tone = "brand", Href = Url.Action("Index", "Certificates") },
    };

    var quickLinks = new (string Ctrl, string Action, string Label, string Icon)[]
    {
        ("Registrations", "Index", "التسجيلات", "bi-clipboard-check"),
        ("CoursesManage", "Index", "الدورات", "bi-book"),
        ("Instructors", "Index", "المدربون", "bi-person-badge"),
        ("Certificates", "Index", "الشهادات", "bi-award"),
    };
}

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<section class="a-kpis" aria-label="مؤشرات التشغيل">
    @foreach (var kpi in kpis)
    {
        <partial name="_KpiCard" model="kpi" />
    }
</section>

<section class="a-card mb-4" aria-label="إجراءات سريعة">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-lightning-charge" aria-hidden="true"></i> إجراءات سريعة</h2>
    </div>
    <div class="a-card__body">
        <div class="a-quicklinks">
            @foreach (var link in quickLinks)
            {
                <a class="a-quicklink" asp-controller="@link.Ctrl" asp-action="@link.Action">
                    <i class="bi @link.Icon" aria-hidden="true"></i>
                    <span>@link.Label</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="a-card" aria-label="أحدث التسجيلات">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-clock-history" aria-hidden="true"></i> أحدث التسجيلات</h2>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Registrations" asp-action="Index">عرض الكل</a>
    </div>
    @if (recentRegs.Any())
    {
        <div class="a-table-wrap">
            <table class="a-table">
                <thead>
                    <tr>
                        <th scope="col">الاسم</th>
                        <th scope="col">الدورة</th>
                        <th scope="col">الحالة</th>
                        <th scope="col">التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in recentRegs)
                    {
                        <tr>
                            <td class="a-table__primary">@r.FullName</td>
                            <td>@r.Course?.CourseName</td>
                            <td>
                                @switch (r.Status)
                                {
                                    case "Pending":
                                        <span class="a-badge a-badge--warning">معلق</span>
                                        break;
                                    case "Accepted":
                                        <span class="a-badge a-badge--success">مقبول</span>
                                        break;
                                    case "Rejected":
                                        <span class="a-badge a-badge--danger">مرفوض</span>
                                        break;
                                    default:
                                        <span class="a-badge a-badge--neutral">@r.Status</span>
                                        break;
                                }
                            </td>
                            <td class="a-table__num">@r.RegistrationDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-clipboard-x", Title = "لا توجد تسجيلات بعد", Text = "ستظهر أحدث الطلبات هنا فور وصولها." })" />
    }
</section>

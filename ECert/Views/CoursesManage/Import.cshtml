@model ECert.ViewModels.CourseImportPageViewModel
@{
    ViewData["Title"] = "استيراد الدورات";
    ViewData["PageIcon"] = "bi-file-earmark-spreadsheet";
    ViewData["PageDesc"] = "رفع عدة دورات من ملف Excel مع تحقق ومراجعة قبل الحفظ";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للدورات</a>
        <a asp-action="DownloadImportTemplate" class="btn btn-outline-primary"><i class="bi bi-download"></i> تنزيل القالب</a>
    </div>
</div>

<div class="a-note a-note--info mb-4">
    <i class="bi bi-shield-check" aria-hidden="true"></i>
    <div><strong>استيراد آمن قبل الحفظ.</strong> يجب أن تكون كل الصفوف صحيحة؛ إذا وُجد خطأ واحد فلن يتم حفظ أي دورة حتى تتم مراجعته. يدعم القالب الآن أكثر من مدرب داخل العمود نفسه مع الفصل بفاصلة.</div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="a-note a-note--danger mb-4" role="alert"><div asp-validation-summary="All"></div></div>
}

@if (Model.Preview is null)
{
    <div class="a-card">
        <div class="a-card__header">
            <h2 class="a-card__title"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> رفع ملف الدورات</h2>
        </div>
        <div class="a-card__body">
            <form asp-action="Import" method="post" enctype="multipart/form-data" class="a-form__grid">
                @Html.AntiForgeryToken()
                <div class="a-field a-field--full">
                    <label asp-for="File" class="a-field__label a-label--required">ملف XLSX</label>
                    <input asp-for="File" type="file" class="form-control" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                    <div class="a-hint">الحد الأقصى 10 ميجابايت. استخدم القالب المرفق، ولا تغيّر أسماء الأعمدة الأساسية.</div>
                </div>
                <div class="a-field a-field--full">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> فحص ومعاينة الملف</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <section class="a-kpis mb-4" aria-label="ملخص الملف">
        <partial name="_KpiCard" model="@(new KpiCard { Label = "إجمالي الصفوف", Value = Model.Preview.TotalRows.ToString(), Icon = "bi-list-ol", Tone = "brand" })" />
        <partial name="_KpiCard" model="@(new KpiCard { Label = "صفوف سليمة", Value = Model.Preview.ValidRows.ToString(), Icon = "bi-check-circle", Tone = "success" })" />
        <partial name="_KpiCard" model="@(new KpiCard { Label = "صفوف تحتاج مراجعة", Value = Model.Preview.InvalidRows.ToString(), Icon = "bi-exclamation-triangle", Tone = "danger" })" />
    </section>
    @if (Model.Preview.InvalidRows > 0)
    {
        <div class="a-note a-note--danger mb-4" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>لا يمكن الاعتماد قبل إصلاح جميع الصفوف المعلّمة. عدّل الملف ثم ارفعه مرة أخرى.</div></div>
    }
    else
    {
        <div class="a-note a-note--success mb-4" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i><div>جميع الصفوف اجتازت التحقق. راجع البيانات ثم اعتمد الاستيراد.</div></div>
    }
    <div class="a-card">
        <div class="a-card__body a-card__body--flush">
            <div class="a-table-wrap">
                <table class="table a-table table-hover align-middle mb-0">
                    <thead><tr><th>الصف</th><th>الدورة</th><th>الفئة</th><th>المدربون</th><th>السعر</th><th>الحالة</th><th>التحقق</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Preview.Rows)
                    {
                        <tr class="@(row.IsValid ? "" : "table-danger")">
                            <td>@row.RowNumber</td><td><strong>@row.CourseName</strong></td><td>@row.Category</td><td>@row.Instructors</td><td>@row.Price.ToString("N0") ريال</td><td>@row.Status</td>
                            <td>@if (row.IsValid) { <span class="a-badge a-badge--success">سليم</span> } else { <span class="a-error">@string.Join("، ", row.Errors)</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-4">
        <a asp-action="Import" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat"></i> رفع ملف آخر</a>
        @if (Model.Preview.CanCommit)
        {
            <form asp-action="ConfirmImport" method="post" onsubmit="return confirm('سيتم إنشاء جميع الدورات المعروضة دفعة واحدة. هل تريد المتابعة؟');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@Model.Preview.Token" />
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> اعتماد استيراد @Model.Preview.ValidRows دورة</button>
            </form>
        }
    </div>
}

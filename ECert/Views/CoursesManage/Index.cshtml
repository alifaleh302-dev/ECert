@model List<Course>
@{
    ViewData["Title"] = "إدارة الدورات";
    ViewData["PageIcon"] = "bi-book";
    ViewData["PageDesc"] = "إضافة وتعديل الدورات التدريبية ومتابعة حالاتها وأسعارها";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Import" class="btn btn-outline-primary"><i class="bi bi-file-earmark-spreadsheet"></i> استيراد من Excel</a>
        <a asp-action="Export" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير إلى Excel</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> إضافة دورة</a>
    </div>
</div>

<form method="get" class="a-toolbar" role="search">
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label visually-hidden" for="courseSearch">بحث</label>
        <div class="a-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="courseSearch" type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم الدورة..." />
        </div>
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search)) { <a asp-action="Index" class="btn btn-outline-secondary">مسح</a> }
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>الدورة</th>
                        <th>الفئة</th>
                        <th>المدربون</th>
                        <th>السعر</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@course.CourseName</strong>
                                    @if (course.IsFeatured) { <i class="bi bi-star-fill text-warning" title="مميزة"></i> }
                                </td>
                                <td>@course.Category?.CategoryName</td>
                                <td>@course.InstructorNamesDisplay</td>
                                <td>@course.Price.ToString("N0") ريال</td>
                                <td>
                                    @switch (course.Status)
                                    {
                                        case "Draft":
                                            @:<span class="badge bg-secondary">مسودة</span>
                                            break;
                                        case "Published":
                                            @:<span class="badge bg-info">منشورة</span>
                                            break;
                                        case "OpenForRegistration":
                                            @:<span class="badge bg-success">مفتوحة للتسجيل</span>
                                            break;
                                        case "InProgress":
                                            @:<span class="badge bg-primary">جارية</span>
                                            break;
                                        case "Completed":
                                            @:<span class="badge bg-dark">مكتملة</span>
                                            break;
                                        case "Archived":
                                            @:<span class="badge bg-warning text-dark">مؤرشفة</span>
                                            break;
                                    }
                                </td>
                                <td>@(course.StartDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-outline-primary" title="تعديل"><i class="bi bi-pencil"></i></a>
                                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="تغيير الحالة">
                                            <i class="bi bi-gear"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><form asp-action="ChangeStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@course.CourseId" /><input type="hidden" name="status" value="Draft" /><button class="dropdown-item">مسودة</button></form></li>
                                            <li><form asp-action="ChangeStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@course.CourseId" /><input type="hidden" name="status" value="Published" /><button class="dropdown-item">نشر</button></form></li>
                                            <li><form asp-action="ChangeStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@course.CourseId" /><input type="hidden" name="status" value="OpenForRegistration" /><button class="dropdown-item">فتح التسجيل</button></form></li>
                                            <li><form asp-action="ChangeStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@course.CourseId" /><input type="hidden" name="status" value="InProgress" /><button class="dropdown-item">جارية</button></form></li>
                                            <li><form asp-action="ChangeStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@course.CourseId" /><input type="hidden" name="status" value="Completed" /><button class="dropdown-item">مكتملة</button></form></li>
                                            <li><form asp-action="ChangeStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@course.CourseId" /><input type="hidden" name="status" value="Archived" /><button class="dropdown-item">أرشفة</button></form></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-0">
                                <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-journal-bookmark", Title = "لا توجد دورات", Text = "لم تُضف أي دورة مطابقة. جرّب تعديل البحث أو أضف دورة جديدة.", ActionText = "إضافة دورة", ActionHref = Url.Action("Create") })" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

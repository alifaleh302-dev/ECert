@model RoleFormViewModel
@{
    var permissions = ViewBag.Permissions as List<Permission> ?? new();
    var permissionGroups = permissions
        .GroupBy(permission => AdminPermissions.Catalog
            .FirstOrDefault(definition => definition.Name == permission.PermissionName)?.Group ?? "صلاحيات أخرى")
        .OrderBy(group => group.Key);
}

<div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>
<div class="a-form__grid a-form__grid--2 mb-5">
    <div class="a-field">
        <label asp-for="RoleName" class="a-field__label"></label>
        <input asp-for="RoleName" class="form-control" maxlength="50" placeholder="مثال: مشرف التسجيلات" />
        <span asp-validation-for="RoleName" class="a-error"></span>
    </div>
    <div class="a-field">
        <label asp-for="Description" class="a-field__label"></label>
        <input asp-for="Description" class="form-control" maxlength="250" placeholder="وصف موجز لمسؤوليات هذا الدور" />
        <span asp-validation-for="Description" class="a-error"></span>
    </div>
</div>

<div class="a-form__section">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="a-form__section-title"><i class="bi bi-key-fill" aria-hidden="true"></i> الصلاحيات</h3>
            <p class="a-form__section-desc mb-0">اختر ما يستطيع المستخدمون المرتبطون بهذا الدور تنفيذه داخل النظام.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="a-badge a-badge--brand" id="selectedPermissionCount">0 صلاحيات مختارة</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="toggleAllPermissions"><i class="bi bi-check2-all"></i> تحديد الكل</button>
        </div>
    </div>

    <div class="a-form__grid a-form__grid--2 mb-3">
        <div class="a-field">
            <label class="a-field__label" for="rolePreset">قالب جاهز</label>
            <select class="form-select" id="rolePreset">
                <option value="">— اختر قالباً لتعبئة الصلاحيات —</option>
                @foreach (var preset in AdminPermissions.Presets)
                {
                    <option value="@preset.Key">@preset.Name</option>
                }
            </select>
            <span class="a-hint" id="rolePresetHint">يضبط القالب الصلاحيات الشائعة لهذا الدور، ويمكنك تعديلها بعدها.</span>
        </div>
    </div>
    <span asp-validation-for="PermissionIds" class="a-error d-block mb-3"></span>

    <div class="a-form__grid a-form__grid--2">
        @foreach (var group in permissionGroups)
        {
            <section class="a-card">
                <div class="a-card__header">
                    <h4 class="a-card__title"><i class="bi bi-folder2-open" aria-hidden="true"></i> @group.Key</h4>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var permission in group)
                    {
                        var selected = Model.PermissionIds.Contains(permission.PermissionId);
                        <label class="list-group-item list-group-item-action d-flex gap-3 align-items-start py-3">
                            <input class="form-check-input mt-1 permission-checkbox" type="checkbox" name="PermissionIds" value="@permission.PermissionId" checked="@selected" />
                            <span>
                                <strong class="d-block">@permission.Description</strong>
                                <small class="text-muted">@permission.PermissionName</small>
                            </span>
                        </label>
                    }
                </div>
            </section>
        }
    </div>
</div>

<script>
    (function () {
        const checkboxes = Array.from(document.querySelectorAll('.permission-checkbox'));
        const counter = document.getElementById('selectedPermissionCount');
        const toggleButton = document.getElementById('toggleAllPermissions');

        function updateState() {
            const selected = checkboxes.filter(checkbox => checkbox.checked).length;
            counter.textContent = `${selected} ${selected === 1 ? 'صلاحية مختارة' : 'صلاحيات مختارة'}`;
            toggleButton.innerHTML = selected === checkboxes.length
                ? '<i class="bi bi-x-lg"></i> إلغاء تحديد الكل'
                : '<i class="bi bi-check2-all"></i> تحديد الكل';
        }

        checkboxes.forEach(checkbox => checkbox.addEventListener('change', updateState));
        toggleButton.addEventListener('click', function () {
            const selectAll = checkboxes.some(checkbox => !checkbox.checked);
            checkboxes.forEach(checkbox => checkbox.checked = selectAll);
            updateState();
        });
        updateState();

        const presets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            AdminPermissions.Presets.ToDictionary(
                preset => preset.Key,
                preset => preset.Permissions.Select(name => permissions
                    .FirstOrDefault(permission => permission.PermissionName == name)?.PermissionId)
                    .Where(id => id.HasValue)
                    .Select(id => id!.Value)
                    .ToArray())));
        const presetSelect = document.getElementById('rolePreset');
        const presetHint = document.getElementById('rolePresetHint');
        if (presetSelect) {
            presetSelect.addEventListener('change', function () {
                const ids = presets[presetSelect.value];
                if (!ids) { presetHint.textContent = 'يضبط القالب الصلاحيات الشائعة لهذا الدور، ويمكنك تعديلها بعدها.'; return; }
                const wanted = new Set(ids.map(String));
                checkboxes.forEach(checkbox => { checkbox.checked = wanted.has(checkbox.value); });
                presetHint.textContent = `طُبّق القالب: ${ids.length} صلاحية. عدّل ما تريد ثم احفظ.`;
                updateState();
            });
        }
    })();
</script>

@model RoleFormViewModel
@{
    var permissions = ViewBag.Permissions as List<Permission> ?? new();
    var idByName = permissions.ToDictionary(p => p.PermissionName, p => p.PermissionId, StringComparer.Ordinal);

    // Only render cells whose permission is actually offered to the caller (SuperAdmin-only
    // permissions are filtered out upstream), so the matrix can never reference a hidden id.
    int? IdOf(string? name) =>
        name is not null && idByName.TryGetValue(name, out var id) ? id : null;

    var totalPermissions = AdminPermissions.MatrixPermissions
        .Select(IdOf)
        .Count(id => id.HasValue);
}

<div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>

<div class="a-form__grid a-form__grid--2 mb-4">
    <div class="a-field">
        <label asp-for="RoleName" class="a-field__label"></label>
        <input asp-for="RoleName" class="form-control" maxlength="50" placeholder="مثال: مشرف التسجيلات" />
        <span asp-validation-for="RoleName" class="a-error"></span>
    </div>
    <div class="a-field">
        <label asp-for="Description" class="a-field__label"></label>
        <input asp-for="Description" class="form-control" maxlength="250" placeholder="وصف موجز لمسؤوليات هذا الدور" />
        <span asp-validation-for="Description" class="a-error"></span>
    </div>
</div>

<div class="rp" data-perm-editor>
    <div class="rp__layout">
        <div class="rp__main">

            <div class="rp-toolbar">
                <div class="rp-search">
                    <i class="bi bi-search rp-search__icon" aria-hidden="true"></i>
                    <label class="visually-hidden" for="permSearch">بحث في الميزات</label>
                    <input id="permSearch" type="search" class="form-control" data-perm-search
                           placeholder="بحث في الميزات" autocomplete="off" />
                </div>
                <div class="rp-toolbar__actions">
                    <button type="button" class="rp-btn" data-perm-select-all">تحديد الكل</button>
                    <button type="button" class="rp-btn rp-btn--muted" data-perm-clear-all">مسح الكل</button>
                </div>
            </div>

            <span asp-validation-for="PermissionIds" class="a-error d-block"></span>

            <div class="rp-matrix">
                <table class="rp-table">
                    <caption class="visually-hidden">مصفوفة الصلاحيات: الصفوف ميزات والأعمدة مستويات الوصول</caption>
                    <colgroup>
                        <col class="rp-col--feature" />
                        <col class="rp-col--level" />
                        <col class="rp-col--level" />
                        <col class="rp-col--level" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col" class="rp-th--feature">الميزة</th>
                            <th scope="col" class="rp-th--level">مشاهدة</th>
                            <th scope="col" class="rp-th--level">إدارة</th>
                            <th scope="col" class="rp-th--level">اعتماد</th>
                        </tr>
                    </thead>
                    @foreach (var group in AdminPermissions.Matrix)
                    {
                        var rows = group.Rows
                            .Select(row => new
                            {
                                row.Label,
                                ViewName = row.View,
                                ManageName = row.Manage,
                                ApproveName = row.Approve,
                                View = IdOf(row.View),
                                Manage = IdOf(row.Manage),
                                Approve = IdOf(row.Approve)
                            })
                            .Where(row => row.View.HasValue || row.Manage.HasValue || row.Approve.HasValue)
                            .ToList();
                        if (rows.Count == 0) { continue; }

                        <tbody data-perm-group>
                            <tr class="rp-group-row">
                                <th scope="colgroup" colspan="4">
                                    <label class="rp-group">
                                        <input type="checkbox" class="rp-check rp-check--group" data-perm-group-toggle
                                               aria-label="تحديد كل صلاحيات @group.Title" />
                                        <span class="rp-group__title">@group.Title</span>
                                    </label>
                                </th>
                            </tr>
                            @foreach (var row in rows)
                            {
                                <tr class="rp-row" data-perm-item data-perm-search="@row.Label">
                                    <th scope="row" class="rp-cell--feature">@row.Label</th>
                                    @foreach (var (name, id, level) in new[] { (row.ViewName, row.View, "view"), (row.ManageName, row.Manage, "manage"), (row.ApproveName, row.Approve, "approve") })
                                    {
                                        <td class="rp-cell--level">
                                            @if (id.HasValue)
                                            {
                                                var selected = Model.PermissionIds.Contains(id.Value);
                                                var sections = string.Join("|", AdminPermissions.SectionLabelsFor(name!));
                                                <label class="rp-cell">
                                                    <input type="checkbox" class="rp-check" name="PermissionIds"
                                                           value="@id.Value" checked="@(selected ? "checked" : null)"
                                                           data-perm-check data-perm-level="@level" data-perm-sections="@sections"
                                                           aria-label="@($"{row.Label} — {level}")" />
                                                </label>
                                            }
                                            else
                                            {
                                                <span class="rp-cell__none" aria-hidden="true">—</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>

            <div class="rp-empty" data-perm-empty hidden>
                <i class="bi bi-search" aria-hidden="true"></i>
                <span>لا توجد ميزة تطابق بحثك.</span>
            </div>
        </div>

        <aside class="rp__aside" aria-label="ملخص الصلاحيات">
            <div class="rp-summary">
                <div class="rp-summary__head">
                    <span class="rp-summary__label">الصلاحيات المحددة</span>
                    <span class="rp-summary__value" data-summary-total>0</span>
                    <span class="rp-summary__of">/ @totalPermissions</span>
                </div>
                <div class="rp-summary__sections">
                    <span class="rp-summary__sections-title">الأقسام المتاحة</span>
                    <div class="rp-summary__list" data-summary-sections></div>
                    <p class="rp-summary__empty" data-summary-sections-empty>لم تُحدَّد أي صلاحية بعد.</p>
                </div>
            </div>
        </aside>
    </div>
</div>

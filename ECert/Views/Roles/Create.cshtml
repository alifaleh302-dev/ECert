@model RoleFormViewModel
@{
    ViewData["Title"] = "إنشاء دور مخصص";
    ViewData["PageIcon"] = "bi-shield-plus";
    ViewData["PageDesc"] = "كوّن دوراً جديداً عبر اختيار الصلاحيات المناسبة لمهام الموظف";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للأدوار</a>
    </div>
</div>

<div class="a-card">
    <div class="a-card__body">
        <div class="a-note a-note--warning mb-4" role="note">
            <i class="bi bi-lightbulb" aria-hidden="true"></i>
            <div>سمِّ الدور بحسب الوظيفة، مثل <strong>مشرف التسجيلات</strong> أو <strong>منسق المحتوى</strong>، ثم امنح أقل مجموعة صلاحيات لازمة لتنفيذ مهامه.</div>
        </div>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_RoleForm" model="Model" />
            <div class="a-form__actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-shield-check"></i> إنشاء الدور</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

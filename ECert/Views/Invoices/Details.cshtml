@model Invoice
@{
    ViewData["Title"] = "فاتورة " + Model.InvoiceNumber;
    ViewData["PageIcon"] = "bi-receipt";
    ViewData["PageDesc"] = "تفاصيل الفاتورة والدفعات المرتبطة بها";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للفواتير</a>
    </div>
</div>

<div class="a-grid-2">
    <section class="a-card">
        <div class="a-card__header">
            <h2 class="a-card__title"><i class="bi bi-file-text" aria-hidden="true"></i> بيانات الفاتورة</h2>
            <span class="a-badge @(Model.Status switch { "Paid" => "a-badge--success", "Unpaid" => "a-badge--danger", "PartiallyPaid" => "a-badge--warning", "Cancelled" => "a-badge--neutral", _ => "a-badge--neutral" })">
                @(Model.Status switch { "Unpaid" => "غير مدفوعة", "PartiallyPaid" => "مدفوعة جزئياً", "Paid" => "مدفوعة", "Cancelled" => "ملغية", _ => Model.Status })
            </span>
        </div>
        <div class="a-card__body">
            <div class="a-dl">
                <span class="a-dl__label">رقم الفاتورة</span>
                <p class="a-dl__value"><span class="a-code">@Model.InvoiceNumber</span></p>

                <span class="a-dl__label">اسم الطالب بالعربية</span>
                <p class="a-dl__value">@(Model.TraineeNameArabic ?? Model.TraineeName)</p>

                <span class="a-dl__label">اسم الطالب بالإنجليزية</span>
                <p class="a-dl__value" dir="ltr">@(Model.TraineeNameEnglish ?? Model.TraineeName)</p>

                <span class="a-dl__label">الهاتف</span>
                <p class="a-dl__value">@Model.TraineePhone</p>

                <span class="a-dl__label">الدورة بالعربية</span>
                <p class="a-dl__value">@(Model.CourseNameArabic ?? Model.CourseName)</p>

                <span class="a-dl__label">الدورة بالإنجليزية</span>
                <p class="a-dl__value" dir="ltr">@(Model.CourseNameEnglish ?? Model.CourseName)</p>

                <span class="a-dl__label">الرسوم الأصلية</span>
                <p class="a-dl__value">@Model.OriginalAmount.ToString("N2") ريال</p>

                @if (Model.ExemptionAmount > 0)
                {
                    <span class="a-dl__label">الإعفاء</span>
                    <p class="a-dl__value text-success">@Model.ExemptionAmount.ToString("N2") ريال@(string.IsNullOrWhiteSpace(Model.ExemptionReason) ? "" : $" — {Model.ExemptionReason}")</p>
                }

                <span class="a-dl__label">المبلغ المستحق</span>
                <p class="a-dl__value fw-bold">@Model.TotalAmount.ToString("N2") ريال</p>

                <span class="a-dl__label">المبلغ المدفوع</span>
                <p class="a-dl__value text-success">@Model.PaidAmount.ToString("N2") ريال</p>

                <span class="a-dl__label">المبلغ المتبقي</span>
                <p class="a-dl__value text-danger">@Model.RemainingAmount.ToString("N0") ريال</p>

                <span class="a-dl__label">تاريخ الإنشاء</span>
                <p class="a-dl__value">@Model.CreatedAt.ToString("yyyy-MM-dd")</p>

                <span class="a-dl__label">تاريخ الاستحقاق</span>
                <p class="a-dl__value">@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "-")</p>

                <span class="a-dl__label">أنشأها</span>
                <p class="a-dl__value">@Model.CreatedBy</p>
            </div>
        </div>
        @if (Model.Status != "Paid" && Model.Status != "Cancelled")
        {
            <div class="a-card__footer d-flex flex-wrap gap-2">
                <a asp-controller="Payments" asp-action="Add" asp-route-invoiceId="@Model.InvoiceId" class="btn btn-success btn-sm"><i class="bi bi-cash"></i> تسجيل دفعة</a>
                <form asp-action="Cancel" method="post" onsubmit="return confirm('هل أنت متأكد من إلغاء الفاتورة؟')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.InvoiceId" />
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle"></i> إلغاء الفاتورة</button>
                </form>
            </div>
        }
    </section>

    <section class="a-card">
        <div class="a-card__header">
            <h2 class="a-card__title"><i class="bi bi-cash-stack" aria-hidden="true"></i> الدفعات</h2>
            <span class="a-badge a-badge--neutral a-badge--none">@Model.Payments.Count دفعة</span>
        </div>
        @if (Model.Payments.Any())
        {
            <div class="a-card__body">
                @foreach (var p in Model.Payments)
                {
                    <div class="a-payment @(p.IsCancelled ? "a-payment--cancelled" : "")">
                        <div class="a-payment__head">
                            <span class="a-payment__amount">@p.Amount.ToString("N0") ريال</span>
                            @if (p.IsCancelled)
                            {
                                <span class="a-badge a-badge--danger">ملغاة</span>
                            }
                            else
                            {
                                <span class="a-badge a-badge--success">صحيحة</span>
                            }
                        </div>
                        <div class="a-dl">
                            <span class="a-dl__label">طريقة الدفع</span>
                            <p class="a-dl__value">
                                @switch (p.PaymentMethod)
                                {
                                    case "Cash":
                                        <span><i class="bi bi-cash"></i> نقد</span>
                                        break;
                                    case "BankTransfer":
                                        <span><i class="bi bi-bank"></i> تحويل بنكي</span>
                                        break;
                                    case "EWallet":
                                    case "Card":
                                        <span><i class="bi bi-wallet2"></i> محفظة إلكترونية</span>
                                        break;
                                    default:
                                        <span>@p.PaymentMethod</span>
                                        break;
                                }
                            </p>

                            @if (!string.IsNullOrEmpty(p.ReferenceNumber))
                            {
                                <span class="a-dl__label">رقم السند</span>
                                <p class="a-dl__value"><span class="a-code">@p.ReferenceNumber</span></p>
                            }

                            <span class="a-dl__label">التاريخ</span>
                            <p class="a-dl__value">@p.PaymentDate.ToString("yyyy-MM-dd")</p>

                            <span class="a-dl__label">الموظف</span>
                            <p class="a-dl__value">@p.RecordedBy</p>

                            @if (!string.IsNullOrEmpty(p.Notes))
                            {
                                <span class="a-dl__label">ملاحظة</span>
                                <p class="a-dl__value">@p.Notes</p>
                            }
                        </div>
                        @if (!p.IsCancelled)
                        {
                            <div class="a-payment__actions">
                                <form asp-controller="Payments" asp-action="Delete" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذه الدفعة؟ سيتم تحديث رصيد الفاتورة.')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.PaymentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> حذف الدفعة</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-cash-stack", Title = "لا توجد دفعات", Text = "لم تُسجَّل أي دفعة على هذه الفاتورة بعد." })" />
        }
    </section>
</div>

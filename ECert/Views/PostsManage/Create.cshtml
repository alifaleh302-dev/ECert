@model Post
@{
    ViewData["Title"] = "إضافة منشور";
    ViewData["PageIcon"] = "bi-newspaper";
    ViewData["PageDesc"] = "أنشئ منشوراً جديداً للموقع العام";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للمنشورات</a>
    </div>
</div>

<div class="a-card">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-newspaper" aria-hidden="true"></i> بيانات المنشور</h2>
    </div>
    <div class="a-card__body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>

            <div class="a-field">
                <label asp-for="Title" class="a-label a-label--required"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="a-error"></span>
            </div>
            <div class="a-field">
                <label asp-for="Content" class="a-label a-label--required"></label>
                <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                <span asp-validation-for="Content" class="a-error"></span>
            </div>
            <div class="a-form__grid a-form__grid--2">
                <div class="a-field">
                    <label class="a-label" for="postImage">صورة المنشور</label>
                    <input id="postImage" type="file" name="image" accept="image/*" class="form-control" onchange="previewImg(this)" />
                    <span class="a-hint">صورة اختيارية تظهر أعلى المنشور.</span>
                    <img id="imgPreview" class="a-media-preview" src="" alt="معاينة الصورة" hidden />
                </div>
                <div class="a-field">
                    <label asp-for="Status" class="a-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Draft">مسودة (حفظ بدون نشر)</option>
                        <option value="Published">نشر مباشرة</option>
                    </select>
                    <span asp-validation-for="Status" class="a-error"></span>
                </div>
            </div>

            <div class="a-form__actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ المنشور</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function previewImg(input) {
        const preview = document.getElementById('imgPreview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) { preview.src = e.target.result; preview.hidden = false; };
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.hidden = true;
        }
    }
</script>
}

@model PhoneCountry
@{
    ViewData["Title"] = "إضافة دولة";
    ViewData["PageIcon"] = "bi-globe2";
    ViewData["PageDesc"] = "حدّد رمز الدولة وقواعد التحقق من أرقام الهواتف";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للدول</a>
    </div>
</div>

<div class="a-card a-card--narrow">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-globe2" aria-hidden="true"></i> بيانات الدولة</h2>
    </div>
    <div class="a-card__body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>

            <div class="a-form__grid a-form__grid--2">
                <div class="a-field">
                    <label asp-for="CountryName" class="a-label a-label--required"></label>
                    <input asp-for="CountryName" class="form-control" />
                    <span asp-validation-for="CountryName" class="a-error"></span>
                </div>
                <div class="a-field">
                    <label asp-for="CountryCode" class="a-label a-label--required"></label>
                    <input asp-for="CountryCode" class="form-control" placeholder="+967" />
                    <span asp-validation-for="CountryCode" class="a-error"></span>
                </div>
                <div class="a-field">
                    <label asp-for="MinPhoneLength" class="a-label"></label>
                    <input asp-for="MinPhoneLength" type="number" class="form-control" />
                    <span asp-validation-for="MinPhoneLength" class="a-error"></span>
                </div>
                <div class="a-field">
                    <label asp-for="MaxPhoneLength" class="a-label"></label>
                    <input asp-for="MaxPhoneLength" type="number" class="form-control" />
                    <span asp-validation-for="MaxPhoneLength" class="a-error"></span>
                </div>
                <div class="a-field a-field--full">
                    <label asp-for="Prefixes" class="a-label"></label>
                    <input asp-for="Prefixes" class="form-control" placeholder="70,71,73,77,78" />
                    <span class="a-hint">افصل بين البدايات بفاصلة.</span>
                    <span asp-validation-for="Prefixes" class="a-error"></span>
                </div>
            </div>

            <div class="form-check mb-0">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <div class="a-form__actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

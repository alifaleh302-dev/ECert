@{
    ViewData["Title"] = "سجل العمليات";
    ViewData["PageIcon"] = "bi-journal-text";
    ViewData["PageDesc"] = "تتبع جميع العمليات التي تمت في النظام مع المستخدم والتوقيت";
    Layout = "_AdminLayout";
    var logs = ViewBag.Logs as List<AuditLog> ?? new();
    var entityType = ViewBag.EntityType as string;
    var action = ViewBag.Action as string;
    int totalCount = ViewBag.TotalCount is int t ? t : 0;
    string? errorMsg = ViewBag.Error as string;
    string? actorRole = ViewBag.ActorRole as string;
    var availableActions = ViewBag.AvailableActions as List<string> ?? new();
    var availableEntities = ViewBag.AvailableEntities as List<string> ?? new();

    var entityLabel = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Registration"] = "تسجيل",
        ["Invoice"] = "فاتورة",
        ["Payment"] = "دفعة",
        ["Certificate"] = "شهادة",
        ["CertificateTemplate"] = "قالب شهادة",
        ["CertificateDesign"] = "تصميم شهادة",
        ["Course"] = "دورة",
        ["User"] = "مستخدم",
        ["Post"] = "منشور",
        ["News"] = "خبر",
        ["Category"] = "فئة",
        ["Role"] = "دور",
        ["University"] = "جامعة",
        ["College"] = "كلية",
        ["AcademicSpecialization"] = "تخصص",
        ["AcademicLevelOption"] = "مستوى دراسي",
        ["Instructor"] = "مدرب"
    };
    var actionLabel = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Create"] = "إنشاء",
        ["Update"] = "تعديل",
        ["Edit"] = "تعديل",
        ["Delete"] = "حذف",
        ["Accept"] = "قبول",
        ["Reject"] = "رفض",
        ["Issue"] = "إصدار",
        ["IssueBulk"] = "إصدار جماعي",
        ["Cancel"] = "إلغاء",
        ["Login"] = "تسجيل دخول",
        ["Restore"] = "استعادة",
        ["Reopen"] = "إعادة فتح",
        ["Publish"] = "نشر",
        ["Archive"] = "أرشفة",
        ["ApplyExemption"] = "إعفاء",
        ["BulkCreate"] = "إنشاء جماعي",
        ["BulkAction"] = "إجراء جماعي"
    };
}
<div class="page-header">
    <partial name="_PageHeader" />
</div>

@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="a-note a-note--warning mb-4" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <div>
            <h6 class="alert-heading">تعذّر جلب السجلات من قاعدة البيانات</h6>
            <p class="mb-1 small">@errorMsg</p>
            <p class="mb-0 small">
                إجمالي السجلات في الجدول: <strong>@totalCount</strong> — دورك: <strong>@actorRole</strong>.
            </p>
        </div>
    </div>
}
else
{
    <div class="a-note a-note--info mb-4" role="status">
        <i class="bi bi-database-check" aria-hidden="true"></i>
        <div>عدد السجلات الظاهرة في الصفحة: <strong>@logs.Count</strong> من إجمالي <strong>@totalCount</strong> سجل في قاعدة البيانات.</div>
    </div>
}

<form method="get" class="a-toolbar" role="search" aria-label="تصفية سجل العمليات">
    <div class="a-toolbar__field">
        <label class="a-field__label" for="auditEntity">نوع العنصر</label>
        <select id="auditEntity" name="entityType" class="form-select">
            <option value="">الكل</option>
            @foreach (var et in availableEntities)
            {
                var label = entityLabel.TryGetValue(et, out var l) ? l : et;
                <option value="@et" selected="@(string.Equals(entityType, et, StringComparison.OrdinalIgnoreCase))">@label</option>
            }
        </select>
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="auditAction">العملية</label>
        <select id="auditAction" name="action" class="form-select">
            <option value="">الكل</option>
            @foreach (var a in availableActions)
            {
                var label = actionLabel.TryGetValue(a, out var l) ? l : a;
                <option value="@a" selected="@(string.Equals(action, a, StringComparison.OrdinalIgnoreCase))">@label</option>
            }
        </select>
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> تصفية</button>
        @if (!string.IsNullOrEmpty(entityType) || !string.IsNullOrEmpty(action))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">إعادة تعيين</a>
        }
    </div>
</form>

<div class="a-card">
    <div class="a-card__body a-card__body--flush">
        <div class="a-table-wrap">
            <table class="table a-table table-hover align-middle">
                <thead>
                    <tr>
                        <th>التاريخ والوقت</th>
                        <th>المستخدم</th>
                        <th>العملية</th>
                        <th>نوع العنصر</th>
                        <th>رقم العنصر</th>
                        <th>التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (logs.Any())
                    {
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td class="small">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><strong>@log.UserName</strong></td>
                                <td>
                                    @if (actionLabel.TryGetValue(log.Action, out var albl))
                                    {
                                        var badgeClass = log.Action switch {
                                            "Create" => "bg-success",
                                            "Update" or "Edit" => "bg-primary",
                                            "Delete" => "bg-danger",
                                            "Accept" => "bg-info",
                                            "Reject" => "bg-warning text-dark",
                                            "Issue" or "IssueBulk" => "bg-dark",
                                            "Cancel" => "bg-secondary",
                                            "Login" => "bg-light text-dark",
                                            _ => "bg-light text-dark"
                                        };
                                        <span class="badge @badgeClass">@albl</span>
                                    }
                                    else
                                    {
                                        <span class="a-badge a-badge--neutral">@log.Action</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var etLabel = entityLabel.TryGetValue(log.EntityType, out var el) ? el : log.EntityType;
                                    }
                                    <span>@etLabel</span>
                                </td>
                                <td>@(log.EntityId?.ToString() ?? "-")</td>
                                <td class="small text-muted">@(log.NewValues ?? log.OldValues ?? "-")</td>
                            </tr>
                        }
                    }
                    else if (totalCount > 0)
                    {
                        <tr>
                            <td colspan="6" class="p-0">
                                <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-funnel", Title = "لا توجد سجلات مطابقة", Text = $"لا يوجد سجل مطابق للفلتر الحالي (الإجمالي في الجدول: {totalCount}). جرّب توسيع نطاق الفلتر.", ActionText = "إعادة تعيين الفلتر", ActionHref = Url.Action("Index") })" />
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-0">
                                <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-journal-text", Title = "لا توجد سجلات حتى الآن", Text = "ستظهر عمليات النظام هنا فور تنفيذها." })" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (logs.Count >= 200)
        {
            <div class="a-note a-note--neutral small mt-3 mb-0">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <div>تم عرض أحدث 200 سجل. استخدم الفلاتر لتقريب البحث.</div>
            </div>
        }
    </div>
</div>

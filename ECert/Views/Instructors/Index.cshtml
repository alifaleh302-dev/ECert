@model List<Instructor>
@{
    ViewData["Title"] = "إدارة المدربين";
    ViewData["PageIcon"] = "bi-person-badge";
    ViewData["PageDesc"] = "إضافة وإدارة بيانات المدربين وصورهم الشخصية";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> إضافة مدرب</a>
    </div>
</div>

<form method="get" class="a-toolbar" role="search">
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label visually-hidden" for="pageSearch">بحث</label>
        <div class="a-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="pageSearch" type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو التخصص..." />
        </div>
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search)) { <a asp-action="Index" class="btn btn-outline-secondary">مسح</a> }
    </div>
</form>

<div class="row g-4">
    @if (Model.Any())
    {
        @foreach (var inst in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(inst.PhotoUrl))
                            {
                                <img src="@inst.PhotoUrl" class="rounded-circle" width="80" height="80" style="object-fit:cover" alt="@inst.FullName" />
                            }
                            else
                            {
                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width:80px;height:80px;font-size:2rem">
                                    @inst.FullName[0]
                                </div>
                            }
                        </div>
                        <h5>@inst.FullName</h5>
                        <p class="text-muted mb-1"><i class="bi bi-award"></i> @inst.Specialization</p>
                        <p class="text-muted small mb-2">عدد الدورات: @inst.Courses.Count</p>
                        @if (!string.IsNullOrEmpty(inst.Phone))
                        {
                            <p class="small mb-0"><i class="bi bi-telephone"></i> @inst.Phone</p>
                        }
                        @if (!string.IsNullOrEmpty(inst.Email))
                        {
                            <p class="small mb-0"><i class="bi bi-envelope"></i> @inst.Email</p>
                        }
                        <div class="mt-2">
                            @if (inst.IsActive) { <span class="badge bg-success">نشط</span> }
                            else { <span class="badge bg-secondary">غير نشط</span> }
                        </div>
                    </div>
                    <div class="card-footer bg-white text-center">
                        <a asp-action="Edit" asp-route-id="@inst.InstructorId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> تعديل</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-person-badge", Title = "لا يوجد مدربون", Text = "لم يُضف أي مدرب مطابق بعد. جرّب تعديل البحث أو أضف مدربًا جديدًا.", ActionText = "إضافة مدرب", ActionHref = Url.Action("Create") })" />
                </div>
            </div>
        </div>
    }
</div>

@{
    ViewData["Title"] = "لوحة الإعلامي";
    ViewData["PageIcon"] = "bi-newspaper";
    ViewData["PageDesc"] = "إدارة المنشورات والأخبار ومتابعة حالة النشر";
    Layout = "_AdminLayout";

    var recentPosts = ViewBag.RecentPosts as List<ECert.Models.Post> ?? new();

    var kpis = new List<KpiCard>
    {
        new() { Label = "المنشورات", Value = ViewBag.TotalPosts?.ToString() ?? "0", Icon = "bi-newspaper", Tone = "brand", Href = Url.Action("Index", "PostsManage") },
        new() { Label = "منشورات منشورة", Value = ViewBag.PublishedPosts?.ToString() ?? "0", Icon = "bi-check-circle", Tone = "success" },
        new() { Label = "مسودات", Value = ViewBag.DraftPosts?.ToString() ?? "0", Icon = "bi-pencil", Tone = "warning", Hint = "بانتظار النشر" },
        new() { Label = "الأخبار", Value = ViewBag.TotalNews?.ToString() ?? "0", Icon = "bi-megaphone", Tone = "info", Href = Url.Action("Index", "NewsManage") },
        new() { Label = "أخبار منشورة", Value = ViewBag.PublishedNews?.ToString() ?? "0", Icon = "bi-broadcast", Tone = "neutral" },
    };

    var quickLinks = new (string Ctrl, string Action, string Label, string Icon)[]
    {
        ("PostsManage", "Create", "إضافة منشور", "bi-plus-circle"),
        ("NewsManage", "Create", "إضافة خبر", "bi-megaphone"),
        ("PostsManage", "Index", "إدارة المنشورات", "bi-newspaper"),
        ("NewsManage", "Index", "إدارة الأخبار", "bi-list-ul"),
    };
}

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<section class="a-kpis" aria-label="مؤشرات المحتوى">
    @foreach (var kpi in kpis)
    {
        <partial name="_KpiCard" model="kpi" />
    }
</section>

<section class="a-card mb-4" aria-label="إجراءات سريعة">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-lightning-charge" aria-hidden="true"></i> إجراءات سريعة</h2>
    </div>
    <div class="a-card__body">
        <div class="a-quicklinks">
            @foreach (var link in quickLinks)
            {
                <a class="a-quicklink" asp-controller="@link.Ctrl" asp-action="@link.Action">
                    <i class="bi @link.Icon" aria-hidden="true"></i>
                    <span>@link.Label</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="a-card" aria-label="أحدث المحتوى">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-clock-history" aria-hidden="true"></i> أحدث المحتوى</h2>
    </div>
    @if (recentPosts.Any())
    {
        <div class="a-table-wrap">
            <table class="a-table">
                <thead>
                    <tr>
                        <th scope="col">العنوان</th>
                        <th scope="col">النوع</th>
                        <th scope="col">الحالة</th>
                        <th scope="col">التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in recentPosts)
                    {
                        <tr>
                            <td class="a-table__primary">@p.Title</td>
                            <td>@(p.PostType == "News" ? "خبر" : "منشور")</td>
                            <td>
                                @switch (p.Status)
                                {
                                    case "Published":
                                        <span class="a-badge a-badge--success">منشور</span>
                                        break;
                                    case "Draft":
                                        <span class="a-badge a-badge--warning">مسودة</span>
                                        break;
                                    case "Archived":
                                        <span class="a-badge a-badge--neutral">مؤرشف</span>
                                        break;
                                    default:
                                        <span class="a-badge a-badge--neutral">@p.Status</span>
                                        break;
                                }
                            </td>
                            <td class="a-table__num">@p.CreatedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-journal-x", Title = "لا يوجد محتوى بعد", Text = "ابدأ بإضافة منشور أو خبر ليظهر هنا." })" />
    }
</section>

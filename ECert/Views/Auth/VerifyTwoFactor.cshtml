@model TwoFactorViewModel
@{
    ViewData["Title"] = "التحقق بخطوتين";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>التحقق بخطوتين - لوحة الإدارة</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light">
    <main class="container" style="max-width: 460px; margin-top: 8vh;">
        <div class="a-card">
            <div class="a-card__header">
                <h1 class="a-card__title"><i class="bi bi-shield-lock" aria-hidden="true"></i> التحقق بخطوتين</h1>
            </div>
            <div class="a-card__body">
                <p class="a-hint mb-3">أُرسل رمز مكوّن من ستة أرقام إلى حسابك في تليجرام. أدخله لإتمام الدخول.</p>
                <form asp-action="VerifyTwoFactor" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>
                    <div class="a-field">
                        <label asp-for="Code" class="a-field__label a-label--required"></label>
                        <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code"
                               maxlength="6" pattern="[0-9]{6}" autofocus dir="ltr" />
                        <span asp-validation-for="Code" class="a-error"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-3"><i class="bi bi-check2-circle"></i> تأكيد الدخول</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>

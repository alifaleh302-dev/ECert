@model ECert.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
    ViewData["PageIcon"] = "bi-shield-lock";
    ViewData["PageDesc"] = "يجب تغيير كلمة المرور قبل متابعة استخدام النظام";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<div class="a-card a-card--narrow">
    <div class="a-card__body">
        <div class="a-note a-note--info mb-4">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>اختر كلمة مرور لا تقل عن 8 أحرف وتحتوي على حرف ورقم على الأقل.</span>
        </div>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div class="a-field">
                <label asp-for="CurrentPassword" class="a-label"></label>
                <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="a-error"></span>
            </div>
            <div class="a-field">
                <label asp-for="NewPassword" class="a-label"></label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="a-error"></span>
            </div>
            <div class="a-field">
                <label asp-for="ConfirmPassword" class="a-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="a-error"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-2">
                <i class="bi bi-check2" aria-hidden="true"></i> حفظ كلمة المرور
            </button>
        </form>
    </div>
</div>

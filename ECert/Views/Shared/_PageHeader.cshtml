@* Unified page header. Reads from ViewData: Title, PageIcon, PageDesc. *@
<div class="page-header__title-row">
    @if (!string.IsNullOrEmpty(ViewData["PageIcon"]?.ToString()))
    {
        <div class="page-header-icon" aria-hidden="true">
            <i class="bi @ViewData["PageIcon"]"></i>
        </div>
    }
    <div>
        <h1 class="page-header__title">@ViewData["Title"]</h1>
        @if (!string.IsNullOrEmpty(ViewData["PageDesc"]?.ToString()))
        {
            <p class="page-desc">@ViewData["PageDesc"]</p>
        }
    </div>
</div>

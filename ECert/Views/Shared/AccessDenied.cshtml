@using ECert.Services
@{
    ViewData["Title"] = "غير مصرح";
    var canOpenAdmin = User.HasAnyAdminPermission();
    Layout = User.Identity?.IsAuthenticated == true && canOpenAdmin ? "_AdminLayout" : "_Layout";
}
<div class="text-center py-5">
    <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
    <h2 class="mt-3">غير مصرح بالوصول</h2>
    <p class="text-muted fs-5">ليس لديك صلاحية للوصول إلى هذه الصفحة.</p>
    @if (canOpenAdmin)
    {
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">
            <i class="bi bi-house"></i> العودة إلى لوحة التحكم
        </a>
    }
    else
    {
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
            <i class="bi bi-house"></i> العودة إلى الموقع
        </a>
    }
</div>

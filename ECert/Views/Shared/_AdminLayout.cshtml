@using System.Security.Claims
@{
    var roleName = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
    bool HasPerm(string p) => User.HasClaim(c => c.Type == "Permission" && c.Value == p);
    bool IsSuperAdmin = roleName == "SuperAdmin";

    string dashController = roleName switch
    {
        "SuperAdmin" => "Dashboard",
        "Admin" => "ManagerDashboard",
        "Media" => "MediaDashboard",
        "Finance" => "FinanceDashboard",
        _ => "Dashboard"
    };

    string roleLabel = roleName switch
    {
        "SuperAdmin" => "مدير عام",
        "Admin" => "إداري",
        "Media" => "إعلامي",
        "Finance" => "مالي",
        _ => "مستخدم"
    };

    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

    var displayName = User.Identity?.Name ?? "مستخدم";
    var initial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim().Substring(0, 1);
    var pageTitle = ViewData["Title"]?.ToString() ?? "";

    // Navigation is declared as data so the markup below stays readable and the
    // permission rules live in one place instead of being duplicated per link.
    var groups = new List<(string Key, string Label, string Icon, List<(string Ctrl, string Label, string Icon)> Items)>
    {
        ("training", "إدارة التدريب", "bi-mortarboard", new()
        {
            ("Registrations", "التسجيلات", "bi-clipboard-check"),
            ("CoursesManage", "الدورات", "bi-book"),
            ("CategoriesManage", "الفئات", "bi-grid-3x3-gap"),
            ("Instructors", "المدربون", "bi-person-badge"),
            ("Certificates", "الشهادات", "bi-award"),
            ("CertificateDesigns", "تصاميم الشهادات", "bi-palette"),
        }),
        ("finance", "الإدارة المالية", "bi-wallet2", new()
        {
            ("Invoices", "الفواتير", "bi-receipt"),
            ("Payments", "الدفعات", "bi-cash-stack"),
            ("Cashbox", "الصندوق", "bi-safe"),
            ("Reports", "تقارير الإيرادات", "bi-graph-up-arrow"),
        }),
        ("content", "المحتوى الإعلامي", "bi-megaphone", new()
        {
            ("PostsManage", "المنشورات", "bi-journal-richtext"),
            ("NewsManage", "الأخبار", "bi-newspaper"),
            ("HomepageManage", "الصفحة الرئيسية", "bi-house-gear"),
        }),
        ("system", "إدارة النظام", "bi-gear", new()
        {
            ("Users", "المستخدمون", "bi-people"),
            ("Roles", "الأدوار والصلاحيات", "bi-shield-lock"),
            ("AuditLog", "سجل العمليات", "bi-journal-text"),
            ("AcademicCatalog", "البيانات الجامعية", "bi-mortarboard"),
            ("PhoneCountries", "مفاتيح الهواتف", "bi-phone"),
        }),
    };

    // Only render a link when the signed-in role actually holds the permission.
    bool CanSee(string ctrl) => ctrl switch
    {
        "Registrations" => IsSuperAdmin || HasPerm("manage-registrations"),
        "CoursesManage" => IsSuperAdmin || HasPerm("manage-courses"),
        "CategoriesManage" => IsSuperAdmin || HasPerm("manage-courses"),
        "Instructors" => IsSuperAdmin || HasPerm("manage-instructors"),
        "Certificates" => IsSuperAdmin || HasPerm("manage-certificates"),
        "CertificateDesigns" => IsSuperAdmin || HasPerm("manage-certificate-designs"),
        "Invoices" => IsSuperAdmin || HasPerm("view-invoices") || HasPerm("manage-finance"),
        "Payments" => IsSuperAdmin || HasPerm("manage-payments"),
        "Cashbox" => IsSuperAdmin || HasPerm("manage-cashbox"),
        "Reports" => IsSuperAdmin || HasPerm("view-reports"),
        "PostsManage" => IsSuperAdmin || HasPerm("manage-posts"),
        "NewsManage" => IsSuperAdmin || HasPerm("manage-news"),
        "HomepageManage" => IsSuperAdmin,
        "Users" => IsSuperAdmin || HasPerm("manage-users"),
        "Roles" => IsSuperAdmin,
        "AuditLog" => IsSuperAdmin || HasPerm("view-audit-log"),
        "AcademicCatalog" => IsSuperAdmin,
        "PhoneCountries" => IsSuperAdmin,
        _ => IsSuperAdmin
    };

    var visibleGroups = groups
        .Select(g => (g.Key, g.Label, g.Icon, Items: g.Items.Where(i => CanSee(i.Ctrl)).ToList()))
        .Where(g => g.Items.Count > 0)
        .ToList();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة الإدارة</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        // Apply the saved theme before first paint to avoid a flash of the wrong palette.
        (function () {
            try {
                var saved = localStorage.getItem('ecert-admin-theme');
                if (saved) document.documentElement.setAttribute('data-theme', saved);
            } catch (e) { /* storage unavailable — fall back to the default theme */ }
        })();
    </script>
</head>
<body>
    <div class="admin-shell">
        <a href="#adminContent" class="visually-hidden-focusable position-absolute top-0 start-0 m-3 btn btn-primary btn-sm">تخطي إلى المحتوى</a>

        <!-- Sidebar -->
        <aside class="admin-nav" id="adminNav" aria-label="التنقل الرئيسي">
            <button type="button" class="admin-nav__close" id="navClose" aria-label="إغلاق القائمة">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>

            <div class="admin-nav__brand">
                <span class="admin-nav__brand-mark" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
                <div class="admin-nav__brand-text">
                    <p class="admin-nav__brand-title">مركز التدريب</p>
                    <span class="admin-nav__brand-role">@roleLabel</span>
                </div>
            </div>

            <div class="admin-nav__scroll">
                <a class="admin-nav__link @(IsActive(dashController) ? "is-active" : "")"
                   asp-controller="@dashController" asp-action="Index">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i> لوحة التحكم
                </a>

                @foreach (var group in visibleGroups)
                {
                    bool groupActive = group.Items.Any(i => IsActive(i.Ctrl));
                    <button type="button" class="admin-nav__toggle" data-nav-group="@group.Key"
                            aria-expanded="@(groupActive ? "true" : "false")" aria-controls="navGroup-@group.Key">
                        <i class="bi @group.Icon" aria-hidden="true"></i>
                        <span>@group.Label</span>
                        <i class="bi bi-chevron-down admin-nav__chevron" aria-hidden="true"></i>
                    </button>
                    <div class="admin-nav__submenu @(groupActive ? "is-open" : "")" id="navGroup-@group.Key">
                        <div>
                            @foreach (var item in group.Items)
                            {
                                <a class="admin-nav__link @(IsActive(item.Ctrl) ? "is-active" : "")"
                                   asp-controller="@item.Ctrl" asp-action="Index">
                                    <i class="bi @item.Icon" aria-hidden="true"></i> @item.Label
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="admin-nav__footer">
                <a class="admin-nav__link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-globe2" aria-hidden="true"></i> عرض الموقع العام
                </a>
            </div>
        </aside>

        <div class="admin-scrim" id="navScrim" hidden></div>

        <!-- Main -->
        <div class="admin-main">
            <header class="admin-topbar" aria-label="شريط أدوات لوحة الإدارة">
                <div class="admin-topbar__start">
                    <button type="button" class="admin-iconbtn admin-iconbtn--mobile" id="navToggle"
                            aria-controls="adminNav" aria-expanded="false" aria-label="فتح القائمة">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>

                    <nav class="admin-crumbs" aria-label="مسار التنقل">
                        <a asp-controller="@dashController" asp-action="Index">الرئيسية</a>
                        @if (!string.IsNullOrEmpty(pageTitle))
                        {
                            <i class="bi bi-chevron-left admin-crumbs__sep" aria-hidden="true"></i>
                            <span class="admin-crumbs__current" aria-current="page">@pageTitle</span>
                        }
                    </nav>
                </div>

                <div class="admin-topbar__end">
                    <button type="button" class="admin-iconbtn" id="themeToggle"
                            aria-label="تبديل المظهر الليلي" title="تبديل المظهر">
                        <i class="bi bi-moon-stars" aria-hidden="true"></i>
                    </button>

                    <span class="admin-topbar__divider" aria-hidden="true"></span>

                    <div class="admin-usermenu">
                        <button type="button" class="admin-usermenu__trigger" id="userMenuTrigger"
                                aria-haspopup="true" aria-expanded="false" aria-controls="userMenuPanel">
                            <span class="admin-avatar" aria-hidden="true">@initial</span>
                            <span class="admin-usermenu__meta">
                                <span class="admin-usermenu__name">@displayName</span>
                                <span class="admin-usermenu__role">@roleLabel</span>
                            </span>
                            <i class="bi bi-chevron-down" aria-hidden="true" style="font-size:.7rem;opacity:.6"></i>
                        </button>

                        <div class="admin-usermenu__panel" id="userMenuPanel" role="menu">
                            <div class="admin-usermenu__head">
                                <strong>@displayName</strong>
                                <span>@roleLabel</span>
                            </div>
                            <a class="admin-usermenu__item" role="menuitem" asp-controller="@dashController" asp-action="Index">
                                <i class="bi bi-speedometer2" aria-hidden="true"></i> لوحة التحكم
                            </a>
                            <a class="admin-usermenu__item" role="menuitem" asp-controller="Auth" asp-action="ChangePassword">
                                <i class="bi bi-key" aria-hidden="true"></i> تغيير كلمة المرور
                            </a>
                            <a class="admin-usermenu__item" role="menuitem" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-globe2" aria-hidden="true"></i> الموقع العام
                            </a>
                            <a class="admin-usermenu__item admin-usermenu__item--danger" role="menuitem"
                               asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-left" aria-hidden="true"></i> تسجيل الخروج
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <main class="admin-content" id="adminContent">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="status">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                        <div class="flex-grow-1">@TempData["Success"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
                        <div class="flex-grow-1">@TempData["Error"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

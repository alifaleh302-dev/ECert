@model TraineeFormViewModel
@{
    ViewData["Title"] = "تعديل بيانات المتدرب";
    ViewData["PageIcon"] = "bi-pencil-square";
    ViewData["PageDesc"] = "صحّح بيانات المتدرب دون المساس بالفاتورة أو الرسوم أو حالة الطلب";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Details" asp-route-id="@Model.RegistrationId" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للتفاصيل</a>
    </div>
</div>

<div class="a-card">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-pencil-square" aria-hidden="true"></i> تعديل بيانات المتدرب</h2>
        <div class="d-flex align-items-center gap-2">
            <span class="a-badge @(Model.Status switch { "Accepted" => "a-badge--success", "Pending" => "a-badge--warning", "Rejected" => "a-badge--danger", _ => "a-badge--neutral" })">
                @(Model.Status switch { "Pending" => "معلق", "Accepted" => "مقبول", "Rejected" => "مرفوض", _ => Model.Status })
            </span>
            <span class="a-badge a-badge--neutral"><span class="a-code">@Model.RequestNumber</span></span>
        </div>
    </div>
    <div class="a-card__body">
        <div class="a-note a-note--warning mb-4">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <div>هنا تُعدَّل البيانات الشخصية والدورة فقط. حالة الطلب والفاتورة والرسوم لها إجراءاتها الخاصة في صفحة التفاصيل.</div>
        </div>
        <partial name="_TraineeForm" model="Model" />
    </div>
</div>

@section Styles {
    <link href="~/css/registrations.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/trainee-form.js" asp-append-version="true"></script>
}

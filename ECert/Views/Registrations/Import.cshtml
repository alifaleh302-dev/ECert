@model ECert.ViewModels.RegistrationImportPageViewModel
@{
    ViewData["Title"] = "استيراد المتدربين";
    ViewData["PageIcon"] = "bi-person-vcard";
    ViewData["PageDesc"] = "رفع بيانات متدربين لدورة معينة من ملف Excel مع تحقق ومراجعة قبل الحفظ";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للتسجيلات</a>
        <a asp-action="DownloadImportTemplate" asp-route-courseId="@Model.CourseId" class="btn btn-outline-primary"><i class="bi bi-download"></i> تنزيل القالب</a>
    </div>
</div>

<div class="a-note a-note--info mb-4">
    <i class="bi bi-shield-check" aria-hidden="true"></i>
    <div>
        <strong>استيراد آمن قبل الحفظ.</strong>
        اختر الدورة أولاً ثم ارفع ملف XLSX. إذا كانت الدورة جامعية فسيتم التحقق من الجامعة والكلية والتخصص والمستوى الدراسي طبقاً للبيانات الموجودة داخل النظام.
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="a-note a-note--danger mb-4" role="alert"><div asp-validation-summary="All"></div></div>
}

@if (Model.Preview is null)
{
    <div class="a-card">
        <div class="a-card__header">
            <h2 class="a-card__title"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> رفع ملف المتدربين</h2>
        </div>
        <div class="a-card__body">
            <form asp-action="Import" method="post" enctype="multipart/form-data" class="a-form__grid">
                @Html.AntiForgeryToken()
                <div class="a-field a-field--full">
                    <label asp-for="CourseId" class="a-field__label a-label--required">الدورة المستهدفة</label>
                    <select asp-for="CourseId" class="form-select" required>
                        <option value="">-- اختر الدورة --</option>
                        @foreach (var course in Model.Courses)
                        {
                            <option value="@course.CourseId">@course.CourseName@(course.RequiresAcademicDetails ? " — تتطلب بيانات جامعية" : string.Empty)</option>
                        }
                    </select>
                </div>
                <div class="a-field">
                    <label asp-for="ImportStatus" class="a-field__label">الحالة بعد الاستيراد</label>
                    <select asp-for="ImportStatus" class="form-select">
                        <option value="Pending">معلق</option>
                        <option value="Accepted">مقبول مباشرة</option>
                    </select>
                </div>
                <div class="a-field">
                    <label class="a-field__label">الدورة الجامعية</label>
                    <div class="a-readonly">@(Model.CourseRequiresAcademicDetails ? "نعم، يلزم التحقق الأكاديمي" : "لا")</div>
                </div>
                <div class="a-field a-field--full">
                    <label asp-for="File" class="a-field__label a-label--required">ملف XLSX</label>
                    <input asp-for="File" type="file" class="form-control" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                    <div class="a-hint">الحد الأقصى 10 ميجابايت. استخدم القالب المرفق، ويمكنك تنزيل قالب مخصص بعد اختيار الدورة.</div>
                </div>
                <div class="a-field a-field--full">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> فحص ومعاينة الملف</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <section class="a-kpis mb-4" aria-label="ملخص الملف">
        <partial name="_KpiCard" model="@(new KpiCard { Label = "الدورة", Value = Model.Preview.CourseName, Icon = "bi-journal-bookmark", Tone = "brand" })" />
        <partial name="_KpiCard" model="@(new KpiCard { Label = "إجمالي الصفوف", Value = Model.Preview.TotalRows.ToString(), Icon = "bi-list-ol", Tone = "info" })" />
        <partial name="_KpiCard" model="@(new KpiCard { Label = "صفوف سليمة", Value = Model.Preview.ValidRows.ToString(), Icon = "bi-check-circle", Tone = "success" })" />
        <partial name="_KpiCard" model="@(new KpiCard { Label = "صفوف تحتاج مراجعة", Value = Model.Preview.InvalidRows.ToString(), Icon = "bi-exclamation-triangle", Tone = "danger" })" />
    </section>

    @if (Model.Preview.InvalidRows > 0)
    {
        <div class="a-note a-note--danger mb-4" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div>لا يمكن الاعتماد قبل إصلاح جميع الصفوف المعلّمة. عدّل الملف ثم ارفعه مرة أخرى.</div></div>
    }
    else
    {
        <div class="a-note a-note--success mb-4" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i><div>جميع الصفوف اجتازت التحقق. راجع البيانات ثم اعتمد الاستيراد بحالة <strong>@(Model.Preview.ImportStatus == "Accepted" ? "مقبول مباشرة" : "معلق")</strong>.</div></div>
    }

    <div class="a-card">
        <div class="a-card__body a-card__body--flush">
            <div class="a-table-wrap">
                <table class="table a-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>الصف</th>
                            <th>الاسم بالعربية</th>
                            <th>الاسم بالإنجليزية</th>
                            <th>الجوال</th>
                            <th>البيانات الجامعية</th>
                            <th>التحقق</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Preview.Rows)
                    {
                        var academicSummary = string.Join(" / ", new[] { row.University, row.College, row.Specialization, row.AcademicLevel }.Where(v => !string.IsNullOrWhiteSpace(v)));
                        <tr class="@(row.IsValid ? "" : "table-danger")">
                            <td>@row.RowNumber</td>
                            <td>@row.FullNameArabic</td>
                            <td dir="ltr">@row.FullNameEnglish</td>
                            <td dir="ltr">@(row.NormalizedPhone ?? row.Phone)</td>
                            <td>@(string.IsNullOrWhiteSpace(academicSummary) ? "—" : academicSummary)</td>
                            <td>@if (row.IsValid) { <span class="a-badge a-badge--success">سليم</span> } else { <span class="a-error">@string.Join("، ", row.Errors)</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <a asp-action="Import" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat"></i> رفع ملف آخر</a>
        @if (Model.Preview.CanCommit)
        {
            <form asp-action="ConfirmImport" method="post" onsubmit="return confirm('سيتم إنشاء جميع التسجيلات المعروضة دفعة واحدة. هل تريد المتابعة؟');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@Model.Preview.Token" />
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> اعتماد استيراد @Model.Preview.ValidRows متدرب</button>
            </form>
        }
    </div>
}

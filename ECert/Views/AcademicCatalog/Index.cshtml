@model ECert.Controllers.AcademicCatalogPageViewModel
@using ECert.Controllers
@{
    Layout = "_SettingsLayout";
    ViewData["Title"] = "البيانات الجامعية";
    ViewData["SelectedKey"] = Model.Selected?.Key;

    var selected = Model.Selected;
    var addKind = Model.AddKind;
    var addParent = Model.AddParent;

    // One tuple per kind: the four add forms and the four edit forms differ only in field and
    // action names, so they are described once here instead of duplicated four times below.
    var addForm = addKind switch
    {
        AcademicNode.University => (Action: "CreateUniversity", ParentField: (string?)null, NameField: "universityName", Label: "الجامعة", MaxLength: 160),
        AcademicNode.College => (Action: "CreateCollege", ParentField: "universityId", NameField: "collegeName", Label: "الكلية", MaxLength: 160),
        AcademicNode.Specialization => (Action: "CreateSpecialization", ParentField: "collegeId", NameField: "specializationName", Label: "التخصص", MaxLength: 160),
        _ => (Action: "CreateLevel", ParentField: "academicSpecializationId", NameField: "levelName", Label: "المستوى", MaxLength: 80)
    };

    var updateForm = selected?.Kind switch
    {
        AcademicNode.University => (Action: "UpdateUniversity", IdField: "universityId", ParentField: (string?)null, NameField: "universityName", Label: "الجامعة", MaxLength: 160, Delete: "DeleteUniversity"),
        AcademicNode.College => (Action: "UpdateCollege", IdField: "collegeId", ParentField: "universityId", NameField: "collegeName", Label: "الكلية", MaxLength: 160, Delete: "DeleteCollege"),
        AcademicNode.Specialization => (Action: "UpdateSpecialization", IdField: "academicSpecializationId", ParentField: "collegeId", NameField: "specializationName", Label: "التخصص", MaxLength: 160, Delete: "DeleteSpecialization"),
        _ => (Action: "UpdateLevel", IdField: "academicLevelOptionId", ParentField: "academicSpecializationId", NameField: "levelName", Label: "المستوى", MaxLength: 80, Delete: "DeleteLevel")
    };

    string Count(int value, string one, string two, string many) => value switch
    {
        1 => $"1 {one}",
        2 => two,
        _ => $"{value} {many}"
    };

    var newNodeLabel = addKind switch
    {
        AcademicNode.University => "جامعة جديدة",
        AcademicNode.College => "كلية جديدة",
        AcademicNode.Specialization => "تخصص جديد",
        _ => "مستوى جديد"
    };
}

@* Keeps the page postable even when it renders no form at all (empty catalog). *@
@Html.AntiForgeryToken()

<div class="ac-toolbar">
    <div class="ac-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <label class="visually-hidden" for="acSearch">بحث في الجامعات والكليات والتخصصات</label>
        <input id="acSearch" type="search" class="form-control" autocomplete="off"
               placeholder="ابحث عن جامعة، كلية، تخصص…" />
    </div>
    <span class="ac-search__hint" id="acSearchHint" role="status"></span>
    <a class="btn btn-primary" asp-action="Index" asp-route-add="@AcademicNode.University">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> إضافة جامعة
    </a>
</div>

<div class="ac-split">
    <section class="a-card ac-tree" aria-label="الهيكل الأكاديمي">
        <div class="ac-tree__head">
            <div class="ac-tree__heading">
                <h2 class="a-card__title"><i class="bi bi-diagram-3" aria-hidden="true"></i> الهيكل الأكاديمي</h2>
                <p class="ac-tree__counts">
                    @Count(Model.UniversityCount, "جامعة", "جامعتان", "جامعات")
                    ·
                    @Count(Model.CollegeCount, "كلية", "كليتان", "كليات")
                    ·
                    @Count(Model.SpecializationCount, "تخصص", "تخصصان", "تخصصات")
                    ·
                    @Count(Model.LevelCount, "مستوى", "مستويان", "مستويات")
                </p>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-ac-expand>توسيع الكل</button>
        </div>
        <div class="ac-tree__body" id="acTree" role="tree">
            @if (Model.Roots.Count == 0)
            {
                <p class="ac-empty-line">لا توجد جامعات بعد. ابدأ بإضافة جامعة.</p>
            }
            else
            {
                <ul class="ac-tree__root">
                    @foreach (var node in Model.Roots)
                    {
                        <partial name="_TreeNode" model="node" />
                    }
                </ul>
            }
        </div>
        <p class="ac-tree__foot">اضغط عنصراً لعرضه وتعديله · زر + يضيف عنصراً بداخله</p>
    </section>

    <section class="a-card ac-detail" id="acDetail">
        @if (addKind is not null)
        {
            <div class="ac-detail__head">
                <nav class="ac-path" aria-label="المسار">
                    <span>الجامعات</span>
                    <span class="ac-path__sep" aria-hidden="true">/</span>
                    @if (addParent is not null)
                    {
                        <span>@addParent.Path</span>
                        <span class="ac-path__sep" aria-hidden="true">/</span>
                    }
                    <strong>@newNodeLabel</strong>
                </nav>
                <span class="a-badge a-badge--success">جديد</span>
            </div>
            <div class="ac-detail__body">
                <h2 class="ac-detail__title">إضافة @(addKind == AcademicNode.University ? "جامعة" : addParent!.ChildLabel)</h2>
                @if (addParent is not null)
                {
                    <p class="ac-hint">سيُضاف داخل «@addParent.Name» تلقائياً — بلا حاجة لاختيار الأب من قائمة.</p>
                }
                <form method="post" asp-action="@addForm.Action" class="ac-form">
                    @Html.AntiForgeryToken()
                    @if (addForm.ParentField is not null)
                    {
                        <input type="hidden" name="@addForm.ParentField" value="@addParent!.Id" />
                    }
                    <label class="form-label" for="acNewName">اسم @addForm.Label</label>
                    <input id="acNewName" name="@addForm.NameField" class="form-control"
                           maxlength="@addForm.MaxLength" required autofocus
                           placeholder="مثال: @(addKind == AcademicNode.University ? "جامعة صنعاء" : addKind == AcademicNode.College ? "كلية الهندسة" : addKind == AcademicNode.Specialization ? "هندسة مدنية" : "المستوى الأول")" />
                    @if (addKind == AcademicNode.Level)
                    {
                        <label class="form-label mt-3" for="acNewOrder">ترتيب العرض</label>
                        <input id="acNewOrder" name="sortOrder" type="number" min="0" max="999" value="0"
                               class="form-control ac-input--short" />
                        <p class="ac-hint">الأرقام الأصغر تظهر أولاً.</p>
                    }
                    <div class="ac-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg" aria-hidden="true"></i> إضافة
                        </button>
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-selected="@addParent?.Key">إلغاء</a>
                    </div>
                </form>
            </div>
        }
        else if (selected is not null)
        {
            <div class="ac-detail__head">
                <nav class="ac-path" aria-label="المسار">
                    <span>الجامعات</span>
                    <span class="ac-path__sep" aria-hidden="true">/</span>
                    <span>@selected.Path</span>
                </nav>
                <span class="a-badge @(selected.IsActive ? "a-badge--success" : "a-badge--neutral")">
                    @(selected.IsActive ? "مفعّل" : "موقوف")
                </span>
            </div>
            <div class="ac-detail__body">
                <form method="post" asp-action="@updateForm.Action" class="ac-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="@updateForm.IdField" value="@selected.Id" />
                    @if (updateForm.ParentField is not null)
                    {
                        <input type="hidden" name="@updateForm.ParentField" value="@selected.Parent!.Id" />
                    }
                    <label class="form-label" for="acName">اسم @updateForm.Label</label>
                    <input id="acName" name="@updateForm.NameField" value="@selected.Name" class="form-control"
                           maxlength="@updateForm.MaxLength" required />
                    @if (selected.Kind == AcademicNode.Level)
                    {
                        <p class="ac-hint">يظهر هذا الاسم في قائمة المستويات أثناء تسجيل الطالب.</p>
                        <label class="form-label mt-3" for="acOrder">ترتيب العرض</label>
                        <input id="acOrder" name="sortOrder" type="number" min="0" max="999"
                               value="@selected.SortOrder" class="form-control ac-input--short" />
                        <p class="ac-hint">الأرقام الأصغر تظهر أولاً.</p>
                    }

                    <div class="ac-switch">
                        <div>
                            <strong>مفعّل</strong>
                            <p class="ac-hint mb-0">
                                @(selected.IsActive
                                    ? "يظهر في التسجيلات والقوائم المنسدلة."
                                    : "مخفي عن التسجيلات الجديدة، وبياناته محفوظة.")
                            </p>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="acActive" name="isActive" value="true" checked="@selected.IsActive" />
                            <label class="visually-hidden" for="acActive">تفعيل @updateForm.Label</label>
                        </div>
                    </div>

                    <div class="ac-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg" aria-hidden="true"></i> حفظ التغييرات
                        </button>
                    </div>
                </form>

                @if (selected.ChildKind is not null)
                {
                    <hr class="ac-divider" />
                    <div class="ac-children__head">
                        <h3>@selected.Plural <span class="ac-muted">(@selected.Children.Count)</span></h3>
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Index" asp-route-selected="@selected.Key"
                           asp-route-add="@selected.ChildKind" asp-route-parentId="@selected.Id">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> إضافة @selected.ChildLabel
                        </a>
                    </div>
                    @if (selected.Children.Count == 0)
                    {
                        <p class="ac-empty-line">لا توجد @selected.ChildPlural بعد. أضف أول @selected.ChildLabel من الزر أعلاه.</p>
                    }
                    else
                    {
                        <ul class="ac-children">
                            @foreach (var child in selected.Children)
                            {
                                <li>
                                    <a class="ac-child" asp-action="Index" asp-route-selected="@child.Key">
                                        <span class="ac-dot @(child.IsActive ? "" : "ac-dot--off")" aria-hidden="true"></span>
                                        <span class="ac-child__name">@child.Name</span>
                                        @if (child.Children.Count > 0)
                                        {
                                            <span class="ac-child__meta">@child.ChildrenCountText</span>
                                        }
                                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                }

                <form method="post" asp-action="@updateForm.Delete" class="ac-danger"
                      data-confirm="هل تريد حذف @updateForm.Label «@selected.Name»؟ لا يمكن التراجع."
                      data-confirm-tone="danger">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@selected.Id" />
                    <div class="ac-danger__text">
                        <strong>حذف @updateForm.Label</strong>
                        <span>لا يمكن التراجع. يُمنع الحذف إذا كان العنصر مرتبطاً بسجلات أو عناصر تابعة.</span>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash" aria-hidden="true"></i> حذف
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="ac-empty">
                <span class="ac-empty__icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                <h3>لا يوجد عنصر محدد</h3>
                <p>اختر عنصراً من الهيكل الأكاديمي، أو أضف جامعة جديدة للبدء.</p>
                <a class="btn btn-primary" asp-action="Index" asp-route-add="@AcademicNode.University">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> إضافة جامعة
                </a>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/academic-catalog.js" asp-append-version="true"></script>
}

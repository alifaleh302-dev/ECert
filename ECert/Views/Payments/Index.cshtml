@{
    ViewData["Title"] = "إدارة الدفعات";
    ViewData["PageIcon"] = "bi-cash-stack";
    ViewData["PageDesc"] = "متابعة سجل دفعات المتدربين وطرق السداد";
    Layout = "_AdminLayout";
    var payments = ViewBag.Payments as List<ECert.Models.Payment> ?? new();
}
<div class="page-header">
    <partial name="_PageHeader" />
</div>

<form method="get" class="a-toolbar" role="search" aria-label="بحث وتصفية الدفعات">
    <div class="a-toolbar__field">
        <label class="a-field__label" for="payStudent">اسم الطالب</label>
        <input id="payStudent" type="text" name="studentName" value="@ViewBag.StudentName" class="form-control" placeholder="اسم الطالب..." />
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="payCourse">اسم الدورة</label>
        <input id="payCourse" type="text" name="courseName" value="@ViewBag.CourseName" class="form-control" placeholder="اسم الدورة..." />
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="payInvoice">رقم الفاتورة</label>
        <input id="payInvoice" type="text" name="invoiceNumber" value="@ViewBag.InvoiceNumber" class="form-control" placeholder="INV-..." />
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="payMethod">طريقة الدفع</label>
        <select id="payMethod" name="method" class="form-select">
            <option value="">الكل</option>
            <option value="Cash" selected="@(ViewBag.Method == "Cash")">نقد</option>
            <option value="BankTransfer" selected="@(ViewBag.Method == "BankTransfer")">محافظ إلكترونية</option>
            <option value="EWallet" selected="@(ViewBag.Method == "EWallet")">محفظة إلكترونية</option>
            <option value="Card" selected="@(ViewBag.Method == "Card")">محافظ إلكترونية</option>
        </select>
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="payStatus">حالة الدفعة</label>
        <select id="payStatus" name="status" class="form-select">
            <option value="">الكل</option>
            <option value="Active" selected="@(ViewBag.Status == "Active")">نشطة</option>
            <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">ملغية</option>
        </select>
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="payFrom">من تاريخ</label>
        <input id="payFrom" type="date" name="dateFrom" value="@(((DateTime?)ViewBag.DateFrom)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="a-toolbar__field">
        <label class="a-field__label" for="payTo">إلى تاريخ</label>
        <input id="payTo" type="date" name="dateTo" value="@(((DateTime?)ViewBag.DateTo)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        <a asp-action="Index" class="btn btn-outline-secondary">مسح</a>
        <a asp-action="ExportXlsx" asp-route-search="@ViewBag.Search" asp-route-method="@ViewBag.Method" asp-route-dateFrom="@(((DateTime?)ViewBag.DateFrom)?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(((DateTime?)ViewBag.DateTo)?.ToString("yyyy-MM-dd"))" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير</a>
    </div>
</form>

@if (payments.Any())
{
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr><th>الفاتورة</th><th>اسم الطالب</th><th>المبلغ</th><th>طريقة الدفع</th><th>التاريخ</th><th>الموظف</th><th>ملاحظات</th><th>الحالة</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in payments)
                        {
                            <tr>
                                <td><code>@p.Invoice?.InvoiceNumber</code></td>
                                <td>
                                    <strong>@(p.Invoice?.TraineeNameArabic ?? p.Invoice?.TraineeName)</strong>
                                    <span class="d-block text-muted small" dir="ltr">@(p.Invoice?.TraineeNameEnglish ?? p.Invoice?.TraineeName)</span>
                                </td>
                                <td class="fw-bold">@p.Amount.ToString("N0") ريال</td>
                                <td>
                                    @switch (p.PaymentMethod)
                                    {
                                        case "Cash":
                                            @:<span><i class="bi bi-cash"></i> نقد</span>
                                            break;
                                        case "BankTransfer":
                                            @:<span><i class="bi bi-wallet2"></i> محافظ إلكترونية</span>
                                            break;
                                        case "EWallet":
                                            @:<span><i class="bi bi-wallet2"></i> محفظة</span>
                                            break;
                                        case "Card":
                                            @:<span><i class="bi bi-wallet2"></i> محافظ إلكترونية</span>
                                            break;
                                        default: <span>@p.PaymentMethod</span> break;
                                    }
                                    @if (!string.IsNullOrEmpty(p.ReferenceNumber))
                                    {
                                        <br /><small class="text-muted"><code>@p.ReferenceNumber</code></small>
                                    }
                                </td>
                                <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td>@p.RecordedBy</td>
                                <td class="small text-muted">@p.Notes</td>
                                <td>
                                    @if (p.IsCancelled)
                                    {
                                        <span class="badge bg-danger">ملغية</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">نشطة</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Delete" method="post" style="display:inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الدفعة؟ سيتم تحديث رصيد الفاتورة تلقائياً.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.PaymentId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-cash-stack", Title = "لا توجد دفعات", Text = "لا توجد دفعة مطابقة للبحث أو الفلتر الحالي." })" />
        </div>
    </div>
}

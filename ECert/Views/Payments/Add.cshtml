@model AddPaymentViewModel
@{
    ViewData["Title"] = "تسجيل دفعة";
    ViewData["PageIcon"] = "bi-cash-coin";
    ViewData["PageDesc"] = "سجّل دفعة على الفاتورة وحدّد طريقة الدفع";
    Layout = "_AdminLayout";
    var invoice = ViewBag.Invoice as Invoice;
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@invoice?.InvoiceId" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للفاتورة</a>
    </div>
</div>

<div class="a-card a-card--narrow">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-cash-stack" aria-hidden="true"></i> دفعة جديدة</h2>
    </div>
    <div class="a-card__body">
        <div class="a-note a-note--info mb-4">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <div>
                <strong>الفاتورة:</strong> @invoice?.InvoiceNumber — <strong>المتدرب:</strong> @invoice?.TraineeName<br />
                <strong>الدورة:</strong> @invoice?.CourseName — <strong>المتبقي:</strong> @((invoice?.RemainingAmount ?? 0m).ToString("N0")) ريال
            </div>
        </div>
        <form asp-action="Add" method="post" id="paymentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="InvoiceId" />
            <div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>

            <div class="a-field">
                <label asp-for="Amount" class="a-label a-label--required"></label>
                <div class="input-group">
                    <input asp-for="Amount" type="number" step="0.01" class="form-control" max="@invoice?.RemainingAmount" placeholder="0.00" />
                    <span class="input-group-text">ريال</span>
                </div>
                <span asp-validation-for="Amount" class="a-error"></span>
            </div>
            <div class="a-field">
                <label asp-for="PaymentMethod" class="a-label a-label--required"></label>
                <select asp-for="PaymentMethod" class="form-select" id="paymentMethod">
                    <option value="Cash">نقد</option>
                    <option value="BankTransfer">تحويل بنكي</option>
                    <option value="EWallet">محفظة إلكترونية</option>
                    <option value="Card">بطاقة</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="a-error"></span>
            </div>
            <div class="a-field" id="referenceGroup" hidden>
                <label asp-for="ReferenceNumber" class="a-label"></label>
                <input asp-for="ReferenceNumber" class="form-control" placeholder="مثال: TX-98541236" />
                <span class="a-hint">رقم السند أو رقم العملية (إجباري للطرق الإلكترونية).</span>
                <span asp-validation-for="ReferenceNumber" class="a-error"></span>
            </div>
            <div class="a-field">
                <label asp-for="Notes" class="a-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="ملاحظات إضافية (اختياري)"></textarea>
                <span asp-validation-for="Notes" class="a-error"></span>
            </div>

            <div class="a-form__actions">
                <button type="submit" class="btn btn-success btn-lg w-100"><i class="bi bi-check-circle"></i> تسجيل الدفعة</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const methodSelect = document.getElementById('paymentMethod');
    const refGroup = document.getElementById('referenceGroup');
    const refInput = document.getElementById('ReferenceNumber');

    function toggleReference() {
        const method = methodSelect.value;
        if (method === 'Cash') {
            refGroup.hidden = true;
            refInput.removeAttribute('required');
        } else {
            refGroup.hidden = false;
            refInput.setAttribute('required', 'required');
        }
    }

    methodSelect.addEventListener('change', toggleReference);
    toggleReference();

    document.getElementById('paymentForm').addEventListener('submit', function(e) {
        const method = methodSelect.value;
        if (method !== 'Cash' && (!refInput.value || refInput.value.trim() === '')) {
            e.preventDefault();
            alert('رقم السند مطلوب عند اختيار طريقة دفع إلكترونية');
            refInput.focus();
        }
    });
});
</script>
}

@{
    ViewData["Title"] = "الصندوق";
    ViewData["PageIcon"] = "bi-safe";
    ViewData["PageDesc"] = "ترحيل أرصدة الدورات إلى الصندوق وعرض إجمالي الصندوق والسحوبات";
    Layout = "_AdminLayout";

    var transfers = ViewBag.Transfers as List<CashboxTransfer> ?? new();
    var withdrawals = ViewBag.Withdrawals as List<CashboxWithdrawal> ?? new();
    decimal totalCollected = ViewBag.TotalCollected is decimal tc ? tc : 0m;
    decimal totalTransferred = ViewBag.TotalTransferred is decimal tt ? tt : 0m;
    decimal totalWithdrawn = ViewBag.TotalWithdrawn is decimal tw ? tw : 0m;
    decimal fundRemaining = ViewBag.FundRemaining is decimal fr ? fr : 0m;
    decimal untransferredTotal = ViewBag.UntransferredTotal is decimal ut ? ut : 0m;
    var byCourse = ViewBag.TransfersByCourse as Dictionary<int, decimal> ?? new();
    var coursesMap = new Dictionary<int, string>();
    if (ViewBag.Courses is List<Course> cList)
        foreach (var cc in cList) coursesMap[cc.CourseId] = cc.CourseName;
    bool canTransfer = ViewBag.CanTransfer is bool ct && ct;
    bool canWithdraw = ViewBag.CanWithdraw is bool cw && cw;
}
<div class="page-header">
    <partial name="_PageHeader" />
    @if (canTransfer)
    {
        <div class="page-actions">
            <a asp-controller="Reports" asp-action="CourseRevenue" class="btn btn-outline-success">
                <i class="bi bi-graph-up-arrow"></i> تقرير الإيرادات (للترحيل)
            </a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white h-100">
            <div class="card-body text-center">
                <h3>@totalCollected.ToString("N0")</h3>
                <small><i class="bi bi-cash-stack"></i> إجمالي المحصَّل من الدورات</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body text-center">
                <h3>@totalTransferred.ToString("N0")</h3>
                <small><i class="bi bi-safe"></i> إجمالي المرحَّل للصندوق</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark h-100">
            <div class="card-body text-center">
                <h3>@untransferredTotal.ToString("N0")</h3>
                <small><i class="bi bi-exclamation-circle"></i> رصيد دون ترحيل</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-dark text-white h-100">
            <div class="card-body text-center">
                <h3>@fundRemaining.ToString("N0")</h3>
                <small><i class="bi bi-bank"></i> الصندوق المتاح (المرحَّل − المسحوب)</small>
            </div>
        </div>
    </div>
</div>

@if (canWithdraw)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-cash-withdraw"></i> سحب من الصندوق — لمدير النظام فقط</h6></div>
        <div class="card-body">
            <form asp-action="Withdraw" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label small">المبلغ (ريال)</label>
                    <input type="number" name="amount" min="0.01" step="0.01" max="@fundRemaining.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                </div>
                <div class="col-md-7">
                    <label class="form-label small">السبب / البيان</label>
                    <input type="text" name="reason" maxlength="500" class="form-control" placeholder="مثلاً: مصروفات تشغيلية شهرية" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-danger w-100"
                            onclick="return confirm('تأكيد سحب المبلغ من الصندوق العام؟');">
                        <i class="bi bi-dash-circle"></i> سحب
                    </button>
                </div>
            </form>
            <small class="text-muted mt-2 d-block">الصندوق المتاح للسحب الآن: <strong>@fundRemaining.ToString("N0")</strong> ريال</small>
        </div>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-arrow-left-circle"></i> عمليات ترحيل الأرصدة من الدورات</h6></div>
    <div class="card-body">
        @if (transfers.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>الدورة</th>
                            <th>المبلغ</th>
                            <th>الملاحظة</th>
                            <th>أنشأها</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in transfers)
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td>
                                    @if (t.CourseId.HasValue && coursesMap.TryGetValue(t.CourseId.Value, out var cn))
                                    {
                                        <span>@cn</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">— تحويل عام —</span>
                                    }
                                </td>
                                <td class="text-success fw-bold">@t.Amount.ToString("N0") ريال</td>
                                <td class="small text-muted">@t.Note</td>
                                <td class="small">@t.CreatedBy</td>
                                <td class="small">@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-center text-muted py-3 mb-0">لا توجد عمليات ترحيل حتى الآن.</p>
        }
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-cash-withdraw"></i> عمليات السحب من الصندوق</h6></div>
    <div class="card-body">
        @if (withdrawals.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>المبلغ</th>
                            <th>السبب / البيان</th>
                            <th>سحبها</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in withdrawals)
                        {
                            <tr>
                                <td>@w.Id</td>
                                <td class="text-danger fw-bold">@w.Amount.ToString("N0") ريال</td>
                                <td>@w.Reason</td>
                                <td class="small">@w.CreatedBy</td>
                                <td class="small">@w.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-center text-muted py-3 mb-0">لا توجد عمليات سحب حتى الآن.</p>
        }
    </div>
</div>

@model Course
@{
    ViewData["Title"] = $"{Model.CourseNameEnglish} / {Model.CourseNameArabic}";
}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
        <li class="breadcrumb-item"><a asp-controller="PublicCourses" asp-action="Index">الدورات</a></li>
        <li class="breadcrumb-item active"><span dir="ltr">@Model.CourseNameEnglish</span> / @Model.CourseNameArabic</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/course-placeholder.svg" : Model.ImageUrl)" class="course-hero-image mb-4" loading="eager" decoding="async" alt="صورة دورة @Model.CourseNameEnglish / @Model.CourseNameArabic" onerror="this.onerror=null;this.src='/images/course-placeholder.svg';" />
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2>
                        <span dir="ltr">@Model.CourseNameEnglish</span>
                        <span class="d-block text-muted fs-5 mt-1">@Model.CourseNameArabic</span>
                    </h2>
                    @switch (Model.Status)
                    {
                        case "OpenForRegistration":
                            @:<span class="badge bg-success fs-6">مفتوحة للتسجيل</span>
                            break;
                        case "Published":
                            @:<span class="badge bg-primary fs-6">منشورة</span>
                            break;
                        case "InProgress":
                            @:<span class="badge bg-warning text-dark fs-6">جارية</span>
                            break;
                        case "Completed":
                            @:<span class="badge bg-secondary fs-6">منتهية</span>
                            break;
                    }
                </div>
                <span class="badge bg-info mb-3">@Model.Category?.CategoryName</span>

                @if (!string.IsNullOrEmpty(Model.FullDescription))
                {
                    <h5 class="mt-4">وصف الدورة</h5>
                    <p>@Model.FullDescription</p>
                }

                @if (!string.IsNullOrEmpty(Model.Objectives))
                {
                    <h5 class="mt-4">أهداف الدورة</h5>
                    <p style="white-space: pre-line;">@Model.Objectives</p>
                }

                @if (!string.IsNullOrEmpty(Model.Content))
                {
                    <h5 class="mt-4">محتوى الدورة</h5>
                    <p style="white-space: pre-line;">@Model.Content</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 sticky-course-info">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title">معلومات الدورة</h5>
                <hr />
                <p><i class="bi bi-calendar"></i> <strong>البداية:</strong> @Model.StartDate?.ToString("yyyy-MM-dd")</p>
                <p><i class="bi bi-hourglass-split"></i> <strong>المدة:</strong> @Model.DurationText</p>
                <p><i class="bi bi-geo-alt"></i> <strong>المكان:</strong> @Model.Location</p>
                @if (!string.IsNullOrEmpty(Model.DiscountType) && Model.DiscountValue > 0)
                {
                    <p class="fs-5"><i class="bi bi-tag"></i> <span class="text-muted text-decoration-line-through">@Model.Price.ToString("N0") @Currency.Symbol</span> <span class="fw-bold text-danger fs-4">@Model.FinalPrice.ToString("N0") @Currency.Symbol</span></p>
                    <small class="text-danger">(خصم @Model.DiscountValue.ToString("N0")@(Model.DiscountType == "Percentage" ? "%" : $" {Currency.Symbol}"))</small>
                }
                else
                {
                    <p class="fs-4 fw-bold text-primary"><i class="bi bi-tag"></i> @Model.Price.ToString("N0") @Currency.Symbol</p>
                }
                <hr />
                @if (Model.Status == "OpenForRegistration")
                {
                    <a asp-controller="Registration" asp-action="Register" asp-route-courseId="@Model.CourseId" class="btn btn-primary w-100 btn-lg">سجّل الآن</a>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="card-title mb-0">المدربون</h5>
                    <span class="badge text-bg-primary">@Model.AssignedInstructors.Count</span>
                </div>
                <div class="d-grid gap-3">
                    @foreach (var instructor in Model.AssignedInstructors)
                    {
                        <div class="border rounded-3 p-3 text-center">
                            <i class="bi bi-person-circle text-primary" style="font-size: 2.4rem;"></i>
                            <h6 class="mt-2 mb-1">@instructor.FullName</h6>
                            @if (!string.IsNullOrWhiteSpace(instructor.Specialization))
                            {
                                <p class="text-muted small mb-2">@instructor.Specialization</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(instructor.Bio))
                            {
                                <p class="small mb-0">@instructor.Bio</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

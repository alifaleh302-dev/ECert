    // ---------- Drag from library onto the canvas ----------
    // The library items stay click-to-add (they drop at a default slot); dragging one places it
    // exactly where the pointer lands, which is how designers expect a palette to behave.
    function canvasPointFromEvent(ev) {
        const r = canvasEl.getBoundingClientRect();
        const s = scale();
        return { x: (ev.clientX - r.left) / s, y: (ev.clientY - r.top) / s };
    }
    function makeLibraryDraggable(node, payload) {
        if (!node) return;
        node.setAttribute('draggable', 'true');
        node.addEventListener('dragstart', e => {
            e.dataTransfer.setData('application/x-ecert-element', JSON.stringify(payload));
            e.dataTransfer.effectAllowed = 'copy';
        });
    }
    [
        ['addTextBtn', { type: 'text' }],
        ['addDividerBtn', { type: 'divider' }],
        ['addQrBtn', { type: 'qr' }],
        ['addBarcodeBtn', { type: 'barcode' }],
        ['addPartnerLogoBtn', { type: 'partner_logo' }],
        ['addPartnerSignatureBtn', { type: 'partner_signature' }],
        ['addSignatureBtn', { type: 'instructor_signature' }]
    ].forEach(([id, payload]) => makeLibraryDraggable($(id), payload));
    document.querySelectorAll('.quick-field').forEach(b => makeLibraryDraggable(b, { type: 'field', fieldKey: b.dataset.field }));
    canvasEl.addEventListener('dragover', e => {
        if (!e.dataTransfer.types.includes('application/x-ecert-element')) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy';
        canvasEl.classList.add('drag-over');
    });
    canvasEl.addEventListener('dragleave', e => {
        if (!canvasEl.contains(e.relatedTarget)) canvasEl.classList.remove('drag-over');
    });
    canvasEl.addEventListener('drop', e => {
        canvasEl.classList.remove('drag-over');
        const raw = e.dataTransfer.getData('application/x-ecert-element');
        if (!raw) return;
        e.preventDefault();
        let payload;
        try { payload = JSON.parse(raw); } catch { return; }
        const point = canvasPointFromEvent(e);
        addElement(payload.type, payload.fieldKey, point);
    });


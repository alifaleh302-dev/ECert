        else if (e.key === 'ArrowUp') { e.preventDefault(); cmdkActive = Math.max(cmdkActive - 1, 0); filterCommands(e.target.value); }
        else if (e.key === 'Enter') { e.preventDefault(); runCommand(cmdkActive); }
        else if (e.key === 'Escape') { e.preventDefault(); closeCommandPalette(); }

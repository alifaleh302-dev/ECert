        $('cmdkInput').focus();
    }
    function closeCommandPalette() { cmdk.style.display = 'none'; }
    function filterCommands(q) {
        const needle = (q || '').trim().toLowerCase();
        cmdkFiltered = needle ? COMMANDS.filter(c => c.label.toLowerCase().includes(needle) || c.id.includes(needle)) : COMMANDS;
        cmdkActive = Math.min(cmdkActive, Math.max(0, cmdkFiltered.length - 1));
        $('cmdkList').innerHTML = cmdkFiltered.length
            ? cmdkFiltered.map((c, i) => '<button type="button" class="ped-cmdk-item' + (i === cmdkActive ? ' active' : '') + '" data-i="' + i + '"><i class="bi ' + c.icon + '"></i><span>' + c.label + '</span>' + (c.kbd ? '<span class="ped-kbd">' + c.kbd + '</span>' : '') + '</button>').join('')
            : '<div class="ped-empty">لا توجد أوامر مطابقة</div>';
    }
    function runCommand(i) {
        const cmd = cmdkFiltered[i];
        if (!cmd) return;
        closeCommandPalette();
        cmd.run();
    }


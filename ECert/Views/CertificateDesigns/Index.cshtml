        if (!el) return;
        pushHistory();
        el.isUnderline = !el.isUnderline;
        $('underlineBtn').classList.toggle('on', el.isUnderline);
        updateNode(el, selected);
    });
    $('selectedLineHeight').addEventListener('input', e => { updateSelected('lineHeight', e.target.value, false); $('lineHeightLabel').textContent = (Number(e.target.value) || 130) + '%'; });
    $('selectedLineHeight').addEventListener('change', e => updateSelected('lineHeight', e.target.value, true));
    $('selectedLetterSpacing').addEventListener('input', e => { updateSelected('letterSpacing', e.target.value, false); $('letterSpacingLabel').textContent = (Number(e.target.value) || 0) + 'px'; });
    $('selectedLetterSpacing').addEventListener('change', e => updateSelected('letterSpacing', e.target.value, true));
    document.querySelectorAll('#presetGrid .ped-preset').forEach(b => b.addEventListener('click', () => applyPreset(b.dataset.preset)));
    $('groupBtn').addEventListener('click', groupSelected);
    $('ungroupBtn').addEventListener('click', ungroupSelected);
    $('selectedLocked').addEventListener('change', e => {
        const el = elements[selected];
        if (!el) return;
        pushHistory();
        el.isLocked = e.target.checked;
        if (el.isLocked) {
            selection = selection.filter(idx => idx !== selected);
            selected = selection.length ? selection[selection.length - 1] : -1;
        }
        render();
        renderSelection();
    });
    $('selectedX').addEventListener('change', e => updateSelected('x', e.target.value, true));
    $('selectedY').addEventListener('change', e => updateSelected('y', e.target.value, true));
    $('selectedWidth').addEventListener('change', e => updateSelected('width', e.target.value, true));
    $('selectedHeight').addEventListener('change', e => updateSelected('height', e.target.value, true));
    $('selectedVisible').addEventListener('change', e => updateSelected('isVisible', e.target.checked, true));

    // canvas property inputs
    $('canvasWidthInput').addEventListener('change', e => { canvasW = clamp(e.target.value, 800, 1600); pushHistory(); render(); syncCanvasInputs(); });
    $('canvasHeightInput').addEventListener('change', e => { canvasH = clamp(e.target.value, 500, 1200); pushHistory(); render(); syncCanvasInputs(); });
    document.querySelectorAll('#sizePresets button').forEach(b => b.addEventListener('click', () => {
        pushHistory();
        canvasW = Number(b.dataset.w); canvasH = Number(b.dataset.h);
        render(); syncCanvasInputs(); refreshPropsPanel();
    }));
    $('backgroundColor').addEventListener('input', e => { updateCanvasProp('backgroundColor', e.target.value, false); $('backgroundColorHex').textContent = e.target.value.toLowerCase(); });
    $('backgroundColor').addEventListener('change', e => updateCanvasProp('backgroundColor', e.target.value, true));
    $('borderColor').addEventListener('input', e => { updateCanvasProp('borderColor', e.target.value, false); $('borderColorHex').textContent = e.target.value.toLowerCase(); });
    $('borderColor').addEventListener('change', e => updateCanvasProp('borderColor', e.target.value, true));
    $('borderWidth').addEventListener('change', e => updateCanvasProp('borderWidth', clamp(e.target.value, 0, 24), true));
    $('borderRadius').addEventListener('change', e => updateCanvasProp('borderRadius', clamp(e.target.value, 0, 80), true));
    $('optGrid').addEventListener('change', e => { gridOn = e.target.checked; document.getElementById('pedApp').classList.toggle('grid-on', gridOn); $('gridToggle').classList.toggle('on', gridOn); });
    $('optSnap').addEventListener('change', e => { snapOn = e.target.checked; $('snapToggle').classList.toggle('on', snapOn); });

    // keyboard shortcuts
    document.addEventListener('keydown', e => {
        const typing = isTypingTarget(document.activeElement);
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openCommandPalette(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !e.shiftKey) { e.preventDefault(); undo(); return; }
        if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'y' || (e.key.toLowerCase() === 'z' && e.shiftKey))) { e.preventDefault(); redo(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'd') { e.preventDefault(); duplicateSelected(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'a') { e.preventDefault(); selectAll(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key === '0') { e.preventDefault(); resetZoom(); return; }
        if (typing) return;
        // Clipboard and lock keys must not hijack native text editing, so they run only outside inputs.
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'c') { e.preventDefault(); copySelected(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'x') { e.preventDefault(); cutSelected(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'v') { e.preventDefault(); pasteClipboard(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'l') { e.preventDefault(); if (selected >= 0) toggleLock(selected); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'g' && e.shiftKey) { e.preventDefault(); ungroupSelected(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'g') { e.preventDefault(); groupSelected(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'i') { e.preventDefault(); $('italicBtn').click(); return; }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'u') { e.preventDefault(); $('underlineBtn').click(); return; }
        if (e.key === 'F2') { e.preventDefault(); if (selected >= 0) beginInlineEdit(selected); return; }
        if (e.key === '?' || (e.shiftKey && e.key === '/')) { e.preventDefault(); showShortcuts(); return; }
        // Bracket keys send the element to the back/front, matching the layers toolbar.
        if (e.key === '[') { e.preventDefault(); toExtreme(false); return; }
        if (e.key === ']') { e.preventDefault(); toExtreme(true); return; }
        // Alt shortcuts mirror the align/distribute/tidy toolbar without stealing plain letters.
        if (e.altKey && !e.ctrlKey && !e.metaKey) {
            const k = e.key.toLowerCase();
            if (e.shiftKey && ['arrowleft', 'arrowright', 'arrowup', 'arrowdown'].includes(k)) {
                e.preventDefault();
                // RTL canvas: the "left" button sits on the right, so map the visual arrow directly.
                if (k === 'arrowleft') alignWithinSelection('right');
                if (k === 'arrowright') alignWithinSelection('left');
                if (k === 'arrowup') alignWithinSelection('top');
                if (k === 'arrowdown') alignWithinSelection('bottom');
                return;
            }
            if (k === 'h') { e.preventDefault(); alignWithinSelection('hcenter'); return; }
            if (k === 'v') { e.preventDefault(); alignWithinSelection('vcenter'); return; }
            if (k === 't') { e.preventDefault(); tidyUp(); return; }
        }
        if (e.altKey && (e.ctrlKey || e.metaKey)) {
            if (e.key.toLowerCase() === 'h') { e.preventDefault(); distribute('h'); return; }
            if (e.key.toLowerCase() === 'v') { e.preventDefault(); distribute('v'); return; }
        }
        // Shift+1 fits the canvas, Shift+2 zooms to the selection — the familiar viewport keys.
        if (e.shiftKey && e.key === '!') { e.preventDefault(); zoomFit(); return; }
        if (e.shiftKey && e.key === '@@') { e.preventDefault(); zoomToSelection(); return; }
        if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); deleteSelected(); return; }
        if (e.key === 'Escape') { hideContextMenu(); closeCommandPalette(); hideShortcuts(); deselect(); return; }
        if (panning) return;
        if (selection.length && ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(e.key)) {
            e.preventDefault();
            // Locked elements are excluded from keyboard nudges just like they are from dragging.
            const movable = selection.filter(i => elements[i] && !elements[i].isLocked);
            if (!movable.length) return;
            pushHistory();
            const step = e.shiftKey ? 10 : 1;
            let dx = 0, dy = 0;
            if (e.key === 'ArrowLeft') dx = -step;
            if (e.key === 'ArrowRight') dx = step;
            if (e.key === 'ArrowUp') dy = -step;
            if (e.key === 'ArrowDown') dy = step;
            // Clamp the whole group so nudging never pushes an element off-canvas.
            let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
            movable.forEach(i => {
                const el = elements[i];
                minX = Math.min(minX, el.x + dx); minY = Math.min(minY, el.y + dy);
                maxX = Math.max(maxX, el.x + dx + el.width); maxY = Math.max(maxY, el.y + dy + el.height);
            });
            if (minX < 0) dx -= minX;
            if (minY < 0) dy -= minY;
            if (maxX > canvasW) dx -= (maxX - canvasW);
            if (maxY > canvasH) dy -= (maxY - canvasH);
            movable.forEach(i => {
                elements[i].x += dx;
                elements[i].y += dy;
                updateNode(elements[i], i);
            });
            renderSelectionOverlays();
            refreshPropsPanel();
            updateToolbarState();
        }
    });

    // ---------- Init ----------
    // Rulers must follow the viewport, so repaint them whenever the canvas area scrolls or resizes.
    areaEl.addEventListener('scroll', renderRulers, { passive: true });
    window.addEventListener('resize', renderRulers);
    elements.forEach((el, i) => { el.rotation = el.rotation || 0; el.zIndex = (el.zIndex === undefined || el.zIndex === null) ? i : el.zIndex; });
    normalizeZ();
    pushHistory();
    syncCanvasInputs();
    render();
    refreshLayers();
    refreshPropsPanel();
    updateToolbarState();
    document.getElementById('pedApp').classList.toggle('grid-on', gridOn);
    document.getElementById('pedApp').classList.toggle('rulers-on', rulersOn);
    renderRulers();
    // The initial pushHistory above is the baseline, not a user edit.
    dirty = false;
})();
</script>

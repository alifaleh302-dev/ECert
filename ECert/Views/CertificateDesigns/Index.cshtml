@using System.Text.Json
@model ECert.Models.ViewModels.CertificateDesignEditorViewModel

@{
    ViewData["Title"] = "مصمم الشهادات";
    Layout = "_AdminLayout";
    // Serialize only editor-safe scalar fields; CertificateDesignElement.Design is a back-reference
    // and must never be sent to the browser because it creates a circular EF object graph.
    var templateJson = JsonSerializer.Serialize(Model.Design.Elements
        .OrderBy(e => e.SortOrder)
        .Select(e => new
        {
            e.CertificateDesignElementId,
            e.ElementType,
            e.FieldKey,
            e.Content,
            e.X,
            e.Y,
            e.Width,
            e.Height,
            e.FontSize,
            e.FontFamily,
            e.FontColor,
            e.FontWeight,
            e.TextAlign,
            e.IsItalic,
            e.IsUnderline,
            e.LineHeight,
            e.LetterSpacing,
            e.GroupId,
            e.IsVisible,
            e.IsLocked,
            e.ZIndex,
            e.Rotation,
            e.Opacity,
            e.SortOrder
        }), new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
    var fieldGroups = new[]
    {
        new { Label = "بيانات الشهادة", Keys = new[] { "certificate_number", "issue_date", "status", "verification_code", "verification_url", "issued_by" } },
        new { Label = "بيانات المتدرب", Keys = new[] { "trainee_name", "trainee_name_arabic", "trainee_name_english" } },
        new { Label = "بيانات الدورة", Keys = new[] { "course_name", "course_name_arabic", "course_name_english" } }
    };
}


@section Styles {
    <link href="~/css/certificate-design-editor.css" rel="stylesheet" asp-append-version="true" />
}

<div class="ped-app" id="pedApp">
    <!-- ============ Toolbar ============ -->
    <div class="ped-toolbar">
        <div class="tb-group">
            <div class="ped-designs">
                <button type="button" class="ped-btn-ghost" id="designsToggle" title="قائمة التصاميم"><i class="bi bi-collection"></i><span class="txt">@Model.Design.Name</span> <i class="bi bi-chevron-down" style="font-size:.7rem;"></i></button>
                <div class="ped-designs-menu" id="designsMenu">
                    <div class="ped-panel-head" style="padding:.35rem .6rem;">تصاميم القوالب</div>
                    @foreach (var item in Model.Designs)
                    {
                        <a class="ds-item @(item.CertificateDesignId == Model.Design.CertificateDesignId ? "active" : "")" asp-action="Index" asp-route-id="@item.CertificateDesignId">
                            <i class="bi @(item.IsPublished ? "bi-broadcast ds-i-live" : "bi-file-earmark")" style="font-size:.95rem;"></i>
                            <span style="flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.Name</span>
                            <span class="ped-badge @(item.IsPublished ? "live" : "draft")">@(item.IsPublished ? "منشور" : "مسودة")</span>
                        </a>
                    }
                    <div class="ds-divider"></div>
                    <a class="ds-item" asp-action="New"><i class="bi bi-plus-circle ds-i-accent"></i><span style="font-weight:700;">تصميم جديد</span></a>
                    @if (Model.Design.CertificateDesignId > 0 && !Model.Design.IsPublished)
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Design.CertificateDesignId" method="post" class="ds-delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ds-item ds-item--danger"
                                    onclick="return confirm('سيتم حذف هذا التصميم نهائياً. هل تريد المتابعة؟')">
                                <i class="bi bi-trash3"></i><span style="font-weight:700;">حذف هذا التصميم</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="undoBtn" title="تراجع (Ctrl+Z)" disabled><i class="bi bi-arrow-counterclockwise"></i></button>
            <button type="button" class="ped-tbtn" id="redoBtn" title="إعادة (Ctrl+Y)" disabled><i class="bi bi-arrow-clockwise"></i></button>
            <button type="button" class="ped-tbtn" id="duplicateBtn" title="تكرار العنصر (Ctrl+D)" disabled><i class="bi bi-files"></i></button>
            <button type="button" class="ped-tbtn danger" id="deleteBtn" title="حذف (Del)" disabled><i class="bi bi-trash3"></i></button>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="alignLeft" title="محاذاة لليمين (Alt+Shift+سهم)"><i class="bi bi-arrow-bar-right"></i></button>
            <button type="button" class="ped-tbtn" id="alignHCenter" title="توسيط أفقي"><i class="bi bi-hr"></i></button>
            <button type="button" class="ped-tbtn" id="alignRight" title="محاذاة لليسار"><i class="bi bi-arrow-bar-left"></i></button>
            <button type="button" class="ped-tbtn" id="alignTop" title="محاذاة للأعلى"><i class="bi bi-arrow-bar-up"></i></button>
            <button type="button" class="ped-tbtn" id="alignVCenter" title="توسيط عمودي"><i class="bi bi-vr"></i></button>
            <button type="button" class="ped-tbtn" id="alignBottom" title="محاذاة للأسفل"><i class="bi bi-arrow-bar-down"></i></button>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="alignSelLeft" title="محاذاة العناصر لبعضها يميناً"><i class="bi bi-distribute-vertical"></i></button>
            <button type="button" class="ped-tbtn" id="alignSelHCenter" title="توسيط العناصر أفقياً لبعضها"><i class="bi bi-align-center"></i></button>
            <button type="button" class="ped-tbtn" id="alignSelTop" title="محاذاة العناصر لبعضها أعلى"><i class="bi bi-distribute-horizontal"></i></button>
            <button type="button" class="ped-tbtn" id="distributeH" title="توزيع أفقي متساوٍ"><i class="bi bi-arrows-expand"></i></button>
            <button type="button" class="ped-tbtn" id="distributeV" title="توزيع عمودي متساوٍ"><i class="bi bi-arrows-expand-vertical"></i></button>
            <button type="button" class="ped-tbtn" id="tidyBtn" title="ترتيب أنيق للتحديد"><i class="bi bi-magic"></i></button>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="toFront" title="إلى المقدمة"><i class="bi bi-layers"></i></button>
            <button type="button" class="ped-tbtn" id="forward" title="تقديم للأمام"><i class="bi bi-arrow-up-short"></i></button>
            <button type="button" class="ped-tbtn" id="backward" title="إرجاع للخلف"><i class="bi bi-arrow-down-short"></i></button>
            <button type="button" class="ped-tbtn" id="toBack" title="إلى الخلف"><i class="bi bi-layers-half"></i></button>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="groupBtn" title="تجميع (Ctrl+G)" disabled><i class="bi bi-bounding-box-circles"></i></button>
            <button type="button" class="ped-tbtn" id="ungroupBtn" title="فك التجميع (Ctrl+Shift+G)" disabled><i class="bi bi-bounding-box"></i></button>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="gridToggle" title="إظهار الشبكة"><i class="bi bi-grid-3x3-gap"></i></button>
            <button type="button" class="ped-tbtn on" id="snapToggle" title="الالتقاط الذكي"><i class="bi bi-magnet"></i></button>
            <button type="button" class="ped-tbtn on" id="rulerToggle" title="إظهار المساطر"><i class="bi bi-rulers"></i></button>
            <button type="button" class="ped-tbtn" id="safeAreaToggle" title="منطقة الأمان للطباعة"><i class="bi bi-border-inner"></i></button>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="cmdkBtn" title="لوحة الأوامر (Ctrl+K)"><i class="bi bi-command"></i></button>
            <button type="button" class="ped-tbtn" id="shortcutsBtn" title="الاختصارات (؟)"><i class="bi bi-question-lg"></i></button>
        </div>

        <div class="tb-group">
            <button type="button" class="ped-tbtn" id="zoomOut" title="تصغير (Ctrl + عجلة الفأرة)"><i class="bi bi-dash-lg"></i></button>
            <button type="button" class="ped-zoom-label" id="zoomLabel" title="إعادة إلى 100%">70%</button>
            <button type="button" class="ped-tbtn" id="zoomIn" title="تكبير (Ctrl + عجلة الفأرة)"><i class="bi bi-plus-lg"></i></button>
            <button type="button" class="ped-tbtn" id="zoomFit" title="ملاءمة العرض (Shift+1)"><i class="bi bi-arrows-fullscreen"></i></button>
            <button type="button" class="ped-tbtn" id="zoomSelection" title="تكبير على التحديد (Shift+2)"><i class="bi bi-bounding-box-circles"></i></button>
        </div>

        <div class="tb-group" style="margin-inline-start:auto;">
            <button type="button" class="ped-btn-ghost" id="previewToggle" title="معاينة الشهادة النهائية"><i class="bi bi-eye"></i><span class="txt">معاينة</span></button>
            <button type="button" class="ped-btn-primary" id="saveDraftBtn"><i class="bi bi-save2"></i><span class="txt">حفظ كمسودة</span></button>
            <button type="button" class="ped-btn-success" id="publishBtn"><i class="bi bi-broadcast"></i><span class="txt">حفظ ونشر</span></button>
        </div>
    </div>

    <!-- ============ Body ============ -->
    <div class="ped-body">
        <!-- Library & Layers -->
        <aside class="ped-panel left" id="leftPanel">
            <div class="ped-panel-head"><i class="bi bi-collection-play"></i> لوحة العناصر</div>
            <div class="ped-panel-section">
                <div class="ped-add-row">
                    <button type="button" class="ped-add-btn" id="addTextBtn"><i class="bi bi-type"></i> نص</button>
                    <button type="button" class="ped-add-btn" id="addDividerBtn"><i class="bi bi-dash-lg"></i> فاصل</button>
                    <button type="button" class="ped-add-btn" id="addQrBtn"><i class="bi bi-qr-code"></i> رمز QR</button>
                    <button type="button" class="ped-add-btn" id="addBarcodeBtn"><i class="bi bi-upc-scan"></i> باركود</button>
                    <button type="button" class="ped-add-btn" id="addPartnerLogoBtn"><i class="bi bi-building"></i> شعار الشريك</button>
                    <button type="button" class="ped-add-btn" id="addPartnerSignatureBtn"><i class="bi bi-vector-pen"></i> توقيع الشريك</button>
                    <button type="button" class="ped-add-btn" id="addSignatureBtn"><i class="bi bi-person-check"></i> توقيع المدرب</button>
                </div>
                <div class="ped-group-title">حقول ديناميكية (تتعبأ تلقائياً عند التحقق)</div>
                @foreach (var group in fieldGroups)
                {
                    <div class="ped-group-title">@group.Label</div>
                    @foreach (var key in group.Keys.Where(key => Model.FieldLabels.ContainsKey(key)))
                    {
                        <button type="button" class="ped-field-chip quick-field" data-field="@key"><i class="bi bi-link-45deg"></i> @Model.FieldLabels[key]</button>
                    }
                }
            </div>
            <div class="ped-panel-section">
                <div class="ped-group-title">أنماط جاهزة للنص</div>
                <div class="ped-preset-grid" id="presetGrid">
                    <button type="button" class="ped-preset" data-preset="title"><span style="font-size:1rem;font-weight:800;">عنوان</span></button>
                    <button type="button" class="ped-preset" data-preset="subtitle"><span style="font-size:.85rem;font-weight:600;">عنوان فرعي</span></button>
                    <button type="button" class="ped-preset" data-preset="name"><span style="font-size:.95rem;font-weight:800;">اسم المتدرب</span></button>
                    <button type="button" class="ped-preset" data-preset="body"><span style="font-size:.78rem;font-weight:400;">نص عادي</span></button>
                    <button type="button" class="ped-preset" data-preset="caption"><span style="font-size:.68rem;font-weight:400;letter-spacing:.08em;">تسمية</span></button>
                    <button type="button" class="ped-preset" data-preset="quote"><span style="font-size:.8rem;font-style:italic;">اقتباس</span></button>
                </div>
            </div>
            <div class="ped-panel-head"><i class="bi bi-stack"></i> الطبقات <span class="float-start small text-muted fw-normal" id="layerCount"></span></div>
            <div class="ped-panel-section" style="flex:1;">
                <div id="layersList"></div>
            </div>
        </aside>

        <!-- Canvas -->
        <main class="ped-canvas-area" id="canvasArea">
            <div class="ped-ruler ped-ruler-h" id="rulerH"></div>
            <div class="ped-ruler ped-ruler-v" id="rulerV"></div>
            <div class="ped-ruler-corner"></div>
            <div class="ped-stage" id="canvasStage">
                <div class="ped-canvas" id="certificateCanvas">
                    <div class="ped-grid" id="gridOverlay"></div>
                    <div class="ped-safe-area" id="safeArea"><span class="ped-safe-area-label">منطقة الأمان</span></div>
                    <div class="ped-measure" id="measureLayer"></div>
                    <div class="ped-marquee" id="marqueeBox"></div>
                    <div class="ped-guide g-x" id="guideX"></div>
                    <div class="ped-guide g-y" id="guideY"></div>
                    <div class="ped-inline-edit" id="inlineEditWrap" style="display:none;">
                        <textarea class="ped-inline-input" id="inlineEdit" rows="1"></textarea>
                    </div>
                </div>
            </div>
            <div class="ped-cursor" id="cursorTag" style="display:none;"></div>
        </main>

        <!-- Properties -->
        <aside class="ped-panel right" id="rightPanel">
            <div class="ped-panel-head" id="propsTitle"><i class="bi bi-sliders2"></i> إعدادات القالب</div>

            <div class="ped-panel-section" id="canvasProps">
                <div class="ped-prop">
                    <label for="templateName">اسم القالب</label>
                    <input class="ped-input" id="templateName" name="Name" form="templateForm" maxlength="120" value="@Model.Design.Name" required />
                </div>
                <div class="ped-prop">
                    <label>مقاس اللوحة <span class="pv" id="sizeLabel"></span></label>
                    <div class="ped-grid-2">
                        <div><label class="small text-muted" style="font-size:.68rem;">العرض (px)</label><input class="ped-input" type="number" id="canvasWidthInput" min="800" max="1600" /></div>
                        <div><label class="small text-muted" style="font-size:.68rem;">الارتفاع (px)</label><input class="ped-input" type="number" id="canvasHeightInput" min="500" max="1200" /></div>
                    </div>
                    <div class="ped-size-presets" id="sizePresets">
                        <button type="button" data-w="1120" data-h="792">أفقي A4</button>
                        <button type="button" data-w="792" data-h="1120">عمودي</button>
                        <button type="button" data-w="1200" data-h="800">عريض</button>
                        <button type="button" data-w="900" data-h="900">مربع</button>
                    </div>
                </div>
                <div class="ped-prop">
                    <label for="backgroundColor">لون الخلفية</label>
                    <div class="ped-color-row">
                        <input type="color" class="ped-color-input" id="backgroundColor" value="@Model.Design.BackgroundColor" />
                        <span class="ped-color-hex" id="backgroundColorHex">@Model.Design.BackgroundColor</span>
                    </div>
                </div>
                <div class="ped-prop">
                    <label>صورة القالب (خلفية مرفوعة)</label>
                    <input type="file" class="ped-input" id="backgroundImageInput" name="backgroundImage" form="templateForm" accept="image/png,image/jpeg,image/webp" />
                    <div class="ped-help mt-1">تُرسم خلف العناصر. الصيغ: PNG أو JPG أو WEBP وبحد أقصى 5 ميغابايت.</div>
                    <div id="backgroundPreviewWrap" class="mt-2" style="display:none;">
                        <img id="backgroundPreview" alt="معاينة خلفية القالب" style="width:100%;border-radius:8px;border:1px solid var(--ped-line);" />
                        <button type="button" class="ped-btn-ghost mt-1" id="removeBackgroundBtn" style="width:100%;justify-content:center;"><i class="bi bi-trash3"></i><span class="txt">إزالة الصورة</span></button>
                    </div>
                </div>
                <div class="ped-prop">
                    <label for="borderColor">لون الإطار</label>
                    <div class="ped-color-row">
                        <input type="color" class="ped-color-input" id="borderColor" value="@Model.Design.BorderColor" />
                        <span class="ped-color-hex" id="borderColorHex">@Model.Design.BorderColor</span>
                    </div>
                </div>
                <div class="ped-grid-2">
                    <div class="ped-prop"><label for="borderWidth">سماكة الإطار</label><input class="ped-input" type="number" id="borderWidth" min="0" max="24" value="@Model.Design.BorderWidth" /></div>
                    <div class="ped-prop"><label for="borderRadius">انحناء الزوايا</label><input class="ped-input" type="number" id="borderRadius" min="0" max="80" value="@Model.Design.BorderRadius" /></div>
                </div>
                <div class="ped-prop">
                    <label class="small text-muted">خيارات المساعدة</label>
                    <div style="display:flex;gap:1rem;">
                        <label class="ped-switch"><input type="checkbox" id="optGrid" checked /> الشبكة</label>
                        <label class="ped-switch"><input type="checkbox" id="optSnap" checked /> الالتقاط</label>
                    </div>
                </div>
            </div>

            <div class="ped-panel-section d-none" id="elementProps">
                <div style="display:flex;align-items:center;gap:.45rem;margin-bottom:.6rem;">
                    <span class="ped-badge" id="elTypeBadge">نص</span>
                    <span class="small text-muted" id="elIndexLabel"></span>
                </div>
                <div class="ped-prop d-none" id="contentWrap">
                    <label for="selectedContent">النص الثابت</label>
                    <textarea class="ped-textarea" id="selectedContent" rows="2" maxlength="1000"></textarea>
                </div>
                <div class="ped-prop d-none" id="fieldWrap">
                    <label for="selectedFieldKey">الحقل الديناميكي</label>
                    <select class="ped-select" id="selectedFieldKey">
                        @foreach (var group in fieldGroups)
                        {
                            <optgroup label="@group.Label">
                                @foreach (var key in group.Keys.Where(key => Model.FieldLabels.ContainsKey(key)))
                                {
                                    <option value="@key">@Model.FieldLabels[key]</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                <div class="ped-prop d-none" id="partnerSlotWrap">
                    <label for="selectedPartnerSlot">ترتيب الجهة الداعمة</label>
                    <select class="ped-select" id="selectedPartnerSlot"></select>
                    <div class="ped-help mt-1">يربط هذا العنصر بجهة داعمة محددة حسب ترتيبها في صفحة الدورة. أضف عنصراً لكل جهة لعرض عدة جهات.</div>
                </div>
                <div class="ped-prop d-none" id="barcodeWrap">
                    <label for="selectedBarcodeSource">محتوى الباركود</label>
                    <select class="ped-select" id="selectedBarcodeSource">
                        @foreach (var source in ECert.Services.CertificateDesignService.BarcodeSources)
                        {
                            <option value="@source.Key">@source.Value</option>
                        }
                    </select>
                    <div class="ped-help mt-1">يُشفَّر بصيغة Code 128 ويدعم الحروف والأرقام والشرطات.</div>
                </div>
                <div class="ped-prop">
                    <label>الخط <span class="pv" id="fontFamilyLabel">Tajawal</span></label>
                    <select class="ped-select" id="selectedFontFamily">
                        <option value="Tajawal">Tajawal</option>
                        <option value="Arial">Arial</option>
                        <option value="Tahoma">Tahoma</option>
                        <option value="Georgia">Georgia</option>
                        <option value="Courier New">Courier New</option>
                    </select>
                </div>
                <div class="ped-grid-2">
                    <div class="ped-prop"><label>الحجم</label><input class="ped-input" type="number" id="selectedFontSize" min="8" max="96" /></div>
                    <div class="ped-prop"><label>الوزن</label><select class="ped-select" id="selectedWeight"><option value="400">عادي</option><option value="500">متوسط</option><option value="600">نصف عريض</option><option value="700">عريض</option><option value="800">ثقيل</option></select></div>
                </div>
                <div class="ped-prop">
                    <label>النمط</label>
                    <div class="ped-seg" id="styleSeg">
                        <button type="button" id="italicBtn" title="مائل (Ctrl+I)"><i class="bi bi-type-italic"></i></button>
                        <button type="button" id="underlineBtn" title="تسطير (Ctrl+U)"><i class="bi bi-type-underline"></i></button>
                    </div>
                </div>
                <div class="ped-grid-2">
                    <div class="ped-prop"><label>تباعد الأسطر <span class="pv" id="lineHeightLabel">130%</span></label><input class="ped-input" type="range" id="selectedLineHeight" min="80" max="300" step="5" style="padding:0;" /></div>
                    <div class="ped-prop"><label>تباعد الحروف <span class="pv" id="letterSpacingLabel">0px</span></label><input class="ped-input" type="range" id="selectedLetterSpacing" min="-10" max="40" step="1" style="padding:0;" /></div>
                </div>
                <div class="ped-prop">
                    <label for="selectedColor">لون النص</label>
                    <div class="ped-color-row">
                        <input type="color" class="ped-color-input" id="selectedColor" />
                        <span class="ped-color-hex" id="selectedColorHex">#172033</span>
                    </div>
                </div>
                <div class="ped-prop">
                    <label>المحاذاة</label>
                    <div class="ped-seg" id="alignSeg">
                        <button type="button" data-align="right"><i class="bi bi-text-right"></i></button>
                        <button type="button" data-align="center"><i class="bi bi-text-center"></i></button>
                        <button type="button" data-align="left"><i class="bi bi-text-left"></i></button>
                    </div>
                </div>
                <div class="ped-prop">
                    <label>التدوير <span class="pv" id="rotationLabel">0°</span></label>
                    <input class="ped-input" type="range" id="selectedRotation" min="-180" max="180" step="1" style="padding:0;" />
                </div>
                <div class="ped-prop">
                    <label>الشفافية <span class="pv" id="opacityLabel">100%</span></label>
                    <input class="ped-input" type="range" id="selectedOpacity" min="10" max="100" step="1" style="padding:0;" />
                </div>
                <div class="ped-grid-2">
                    <div class="ped-prop"><label>س X</label><input class="ped-input" type="number" id="selectedX" /></div>
                    <div class="ped-prop"><label>ص Y</label><input class="ped-input" type="number" id="selectedY" /></div>
                    <div class="ped-prop"><label>العرض</label><input class="ped-input" type="number" id="selectedWidth" min="20" /></div>
                    <div class="ped-prop"><label>الارتفاع</label><input class="ped-input" type="number" id="selectedHeight" min="20" /></div>
                </div>
                <div class="ped-prop" style="display:flex;align-items:center;justify-content:space-between;gap:.5rem;">
                    <label class="ped-switch" style="margin:0;"><input type="checkbox" id="selectedVisible" checked /> إظهار العنصر</label>
                    <label class="ped-switch" style="margin:0;"><input type="checkbox" id="selectedLocked" /> قفل العنصر</label>
                </div>
                <div class="ped-help mt-2 pt-2" style="border-top:1px dashed var(--ped-line);">
                    <i class="bi bi-keyboard"></i> اختصارات: <span class="ped-kbd">Ctrl+K</span> لوحة الأوامر · <span class="ped-kbd">Ctrl+C/V/X</span> نسخ/لصق/قص · <span class="ped-kbd">F2</span> تسمية · <span class="ped-kbd">Ctrl+L</span> قفل · <span class="ped-kbd">Del</span> حذف · <span class="ped-kbd">Alt+Shift+سهم</span> محاذاة · <span class="ped-kbd">Alt+T</span> ترتيب أنيق · <span class="ped-kbd">؟</span> كل الاختصارات
                </div>
            </div>
        </aside>
    </div>

    <!-- context menu -->
    <div class="ped-menu" id="ctxMenu" style="display:none;"></div>

    <!-- command palette -->
    <div class="ped-cmdk" id="cmdk" style="display:none;">
        <div class="ped-cmdk-box" role="dialog" aria-label="لوحة الأوامر">
            <div class="ped-cmdk-head">
                <i class="bi bi-command"></i>
                <input class="ped-cmdk-input" id="cmdkInput" type="text" placeholder="اكتب أمراً… (محاذاة، توزيع، قفل، تكرار)" autocomplete="off" />
                <span class="ped-kbd">Esc</span>
            </div>
            <div class="ped-cmdk-list" id="cmdkList"></div>
        </div>
    </div>

    <!-- shortcuts sheet -->
    <div class="ped-sheet" id="shortcutsSheet" style="display:none;">
        <div class="ped-sheet-box" role="dialog" aria-label="الاختصارات">
            <div class="ped-sheet-head">
                <span><i class="bi bi-keyboard"></i> اختصارات لوحة المفاتيح</span>
                <button type="button" class="ly-btn" id="shortcutsClose" title="إغلاق"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="ped-sheet-body" id="shortcutsBody"></div>
        </div>
    </div>

    <!-- form -->
    <form id="templateForm" asp-action="Save" method="post" enctype="multipart/form-data" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CertificateDesignId" value="@Model.Design.CertificateDesignId" />
        <input type="hidden" name="CanvasWidth" id="hfCanvasWidth" value="@Model.Design.CanvasWidth" />
        <input type="hidden" name="CanvasHeight" id="hfCanvasHeight" value="@Model.Design.CanvasHeight" />
        <input type="hidden" name="BackgroundColor" id="hfBackgroundColor" value="@Model.Design.BackgroundColor" />
        <input type="hidden" name="BorderColor" id="hfBorderColor" value="@Model.Design.BorderColor" />
        <input type="hidden" name="BorderWidth" id="hfBorderWidth" value="@Model.Design.BorderWidth" />
        <input type="hidden" name="BorderRadius" id="hfBorderRadius" value="@Model.Design.BorderRadius" />
        <input type="hidden" name="RemoveBackgroundImage" id="hfRemoveBackground" value="false" />
        <input type="hidden" name="Publish" id="publishInput" value="false" />
        <input type="hidden" name="ElementsJson" id="elementsJson" />
    </form>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success mt-3 mb-0 border-0 shadow-sm">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger mt-3 mb-0 border-0 shadow-sm">@error</div> }

<script>
(() => {
    'use strict';
    // ---------- State ----------
    const canvasEl = document.getElementById('certificateCanvas');
    const stageEl = document.getElementById('canvasStage');
    const areaEl = document.getElementById('canvasArea');
    const form = document.getElementById('templateForm');
    const elementsInput = document.getElementById('elementsJson');
    const publishInput = document.getElementById('publishInput');
    const guideX = document.getElementById('guideX');
    const guideY = document.getElementById('guideY');
    const measureLayer = document.getElementById('measureLayer');
    const marqueeBox = document.getElementById('marqueeBox');
    const rulerH = document.getElementById('rulerH');
    const rulerV = document.getElementById('rulerV');
    const ctxMenu = document.getElementById('ctxMenu');
    const cmdk = document.getElementById('cmdk');
    const inlineEdit = document.getElementById('inlineEdit');
    const inlineEditWrap = document.getElementById('inlineEditWrap');

    let canvasW = @Model.Design.CanvasWidth;
    let canvasH = @Model.Design.CanvasHeight;
    let cProps = {
        backgroundColor: '@Model.Design.BackgroundColor',
        borderColor: '@Model.Design.BorderColor',
        borderWidth: @Model.Design.BorderWidth,
        borderRadius: @Model.Design.BorderRadius
    };
    let zoom = 0.7;
    let selected = -1;
    let selection = [];
    let gridOn = true;
    let snapOn = true;
    let rulersOn = true;
    let safeAreaOn = false;
    let clipboard = [];
    let dirty = false;
    let previewMode = false;
    let panning = false;
    let backgroundImageUrl = @Html.Raw(JsonSerializer.Serialize(Model.Design.BackgroundImageUrl));
    let elements = @Html.Raw(templateJson);
    if (!Array.isArray(elements)) elements = [];

    const sampleValues = {
        certificate_number: 'EC-2026-0042', trainee_name: 'أحمد محمد العتيبي', course_name: 'القيادة الاستراتيجية وإدارة فرق العمل',
        issue_date: '2026/08/14', status: 'سارية ومعتمدة', verification_code: 'EXAMPLE-VERIFY-CODE', verification_url: 'ecert.example/v/sample',
        issued_by: 'مركز التدريب المهني', trainee_name_arabic: 'أحمد محمد العتيبي', trainee_name_english: 'Ahmed Mohammed Alotaibi',
        course_name_arabic: 'القيادة الاستراتيجية وإدارة فرق العمل', course_name_english: 'Strategic Leadership and Team Management'
    };

    const FIELD_LABELS = {};
    @foreach (var group in fieldGroups)
    {
        @foreach (var key in group.Keys.Where(key => Model.FieldLabels.ContainsKey(key)))
        {
            <text>FIELD_LABELS['@key'] = '@Model.FieldLabels[key]';</text>
        }
    }
    const BARCODE_LABELS = {};
    @foreach (var source in ECert.Services.CertificateDesignService.BarcodeSources)
    {
        <text>BARCODE_LABELS['@source.Key'] = '@source.Value';</text>
    }

    // ---------- History ----------
    let history = [];
    let historyIndex = -1;
    const MAX_HISTORY = 60;
    function snapshot() { return JSON.stringify({ canvasW, canvasH, cProps, elements, backgroundImageUrl }); }
    function pushHistory() {
        dirty = true;
        const snap = snapshot();
        history = history.slice(0, historyIndex + 1);
        history.push(snap);
        if (history.length > MAX_HISTORY) history.shift();
        historyIndex = history.length - 1;
        updateToolbarState();
    }
    function undo() { if (historyIndex <= 0) return; historyIndex--; dirty = true; restore(history[historyIndex]); }
    function redo() { if (historyIndex >= history.length - 1) return; historyIndex++; dirty = true; restore(history[historyIndex]); }
    function restore(snap) {
        const s = JSON.parse(snap);
        canvasW = s.canvasW; canvasH = s.canvasH; cProps = s.cProps; elements = s.elements;
        backgroundImageUrl = s.backgroundImageUrl || null;
        selected = -1;
        selection = [];
        syncCanvasInputs();
        render();
        refreshLayers();
        updateToolbarState();
    }
    function updateToolbarState() {
        document.getElementById('undoBtn').disabled = historyIndex <= 0;
        document.getElementById('redoBtn').disabled = historyIndex >= history.length - 1;
        const hasSel = selection.length > 0;
        ['duplicateBtn', 'deleteBtn', 'alignLeft', 'alignHCenter', 'alignRight', 'alignTop', 'alignVCenter', 'alignBottom', 'toFront', 'forward', 'backward', 'toBack'].forEach(id => {
            document.getElementById(id).disabled = !hasSel;
        });
        // Selection-relative tools need at least two (align/tidy) or three (distribute) elements.
        ['alignSelLeft', 'alignSelHCenter', 'alignSelTop', 'tidyBtn'].forEach(id => {
            document.getElementById(id).disabled = selection.length < 2;
        });
        ['distributeH', 'distributeV'].forEach(id => {
            document.getElementById(id).disabled = selection.length < 3;
        });
        // Grouping needs two movable elements; ungrouping needs at least one grouped member.
        const movableCount = selection.filter(i => elements[i] && !elements[i].isLocked).length;
        document.getElementById('groupBtn').disabled = movableCount < 2;
        document.getElementById('ungroupBtn').disabled = !selection.some(i => elements[i] && elements[i].groupId);
    }

    // ---------- Helpers ----------
    const $ = id => document.getElementById(id);
    const clamp = (n, min, max) => Math.max(min, Math.min(max, Number(n) || 0));
    function isTypingTarget(t) {
        if (!t || !t.tagName) return false;
        const tag = t.tagName.toUpperCase();
        return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || t.isContentEditable;
    }
    const isPartnerSlot = type => type === 'partner_logo' || type === 'partner_signature';
    function slotOf(el) {
        if (el.elementType === 'instructor_signature') return -1;
        const n = parseInt(el.fieldKey, 10);
        return Number.isFinite(n) && n >= 0 ? n : 0;
    }
    function scale() { const r = canvasEl.getBoundingClientRect(); return r.width / canvasW; }
    function contentFor(el) {
        if (el.elementType === 'field') return sampleValues[el.fieldKey] || 'بيان ديناميكي';
        if (el.elementType === 'divider') return '';
        if (el.elementType === 'qr') return '';
        // Artwork placeholders are drawn by CSS, so keep the node text empty.
        if (el.elementType === 'partner_logo') return '';
        if (el.elementType === 'partner_signature') return '';
        if (el.elementType === 'instructor_signature') return '';
        if (el.elementType === 'barcode') return sampleValues[el.fieldKey] || 'EC-2026-0042';
        return el.content || 'نص جديد';
    }
    function labelFor(el) {
        if (el.elementType === 'field') return FIELD_LABELS[el.fieldKey] || el.fieldKey || 'بيان';
        if (el.elementType === 'divider') return 'فاصل بصري';
        if (el.elementType === 'qr') return 'رمز QR للتحقق';
        if (el.elementType === 'partner_logo') return 'شعار الجهة الداعمة #' + (slotOf(el) + 1);
        if (el.elementType === 'partner_signature') return 'توقيع الجهة الداعمة #' + (slotOf(el) + 1);
        if (el.elementType === 'instructor_signature') return 'توقيع المدرب';
        if (el.elementType === 'barcode') return 'باركود: ' + (BARCODE_LABELS[el.fieldKey] || 'رقم الشهادة');
        return (el.content || 'نص').replace(/\s+/g, ' ').slice(0, 22);
    }
    function styleFor(el) {
        const s = {
            left: el.x + 'px', top: el.y + 'px', width: el.width + 'px', height: el.height + 'px',
            fontSize: el.fontSize + 'px', color: el.fontColor || '#172033',
            fontFamily: '"' + (el.fontFamily || 'Tajawal') + '", Arial, sans-serif',
            fontWeight: el.fontWeight || '600', zIndex: el.zIndex || 1,
            opacity: (el.opacity === undefined ? 100 : el.opacity) / 100,
            transform: 'rotate(' + (el.rotation || 0) + 'deg)',
            fontStyle: el.isItalic ? 'italic' : 'normal',
            textDecoration: el.isUnderline ? 'underline' : 'none',
            lineHeight: ((el.lineHeight === undefined || el.lineHeight <= 0) ? 130 : el.lineHeight) / 100,
            letterSpacing: (el.letterSpacing || 0) + 'px'
        };
        if (el.elementType === 'divider') {
            s.borderTop = '2px solid ' + (el.fontColor || '#172033');
            s.height = '0px';
            s.display = 'block';
        } else if (el.elementType === 'barcode') {
            s.justifyContent = 'center';
            s.fontFamily = "'Courier New', monospace";
            s.letterSpacing = '2px';
        } else if (el.elementType === 'partner_logo' || el.elementType === 'partner_signature' || el.elementType === 'instructor_signature') {
            s.justifyContent = 'center';
            s.fontSize = Math.max(20, Math.min(el.width, el.height) * 0.5) + 'px';
            s.color = el.fontColor || '#94a3b8';
        } else {
            s.textAlign = el.textAlign || 'center';
            s.justifyContent = (el.textAlign === 'right') ? 'flex-start' : (el.textAlign === 'left') ? 'flex-end' : 'center';
        }
        return s;
    }

    // ---------- Snapping ----------
    const SNAP = 6;
    function computeSnap(x, y, w, h) {
        const xs = [0, canvasW / 2, canvasW];
        const ys = [0, canvasH / 2, canvasH];
        elements.forEach((el, i) => {
            if (i === selected || !el.isVisible) return;
            xs.push(el.x, el.x + el.width / 2, el.x + el.width);
            ys.push(el.y, el.y + el.height / 2, el.y + el.height);
        });
        const edges = [[x, x + w / 2, x + w], [y, y + h / 2, y + h]];
        const targets = [xs, ys];
        const out = { x, y, w, h, gx: null, gy: null };
        for (let a = 0; a < 2; a++) {
            let best = null;
            for (const t of targets[a]) {
                for (const e of edges[a]) {
                    const d = t - e;
                    if (Math.abs(d) < SNAP && (!best || Math.abs(d) < Math.abs(best.d))) best = { d, t };
                }
            }
            if (best) {
                if (a === 0) { out.x += best.d; out.gx = best.t; } else { out.y += best.d; out.gy = best.t; }
            }
        }
        return out;
    }
    function renderGuides(gx, gy) {
        const s = scale();
        guideX.style.display = gx !== null ? 'block' : 'none';
        guideY.style.display = gy !== null ? 'block' : 'none';
        if (gx !== null) guideX.style.left = (gx * s) + 'px';
        if (gy !== null) guideY.style.top = (gy * s) + 'px';
    }
    function clearGuides() { guideX.style.display = 'none'; guideY.style.display = 'none'; }

    // A small coordinate read-out that trails the pointer while dragging, so the user can place an
    // element precisely without reading the properties panel.
    const cursorTag = document.getElementById('cursorTag');
    function showCursorTag(ev, x, y) {
        const rect = areaEl.getBoundingClientRect();
        cursorTag.textContent = Math.round(x) + ' , ' + Math.round(y);
        cursorTag.style.left = (ev.clientX - rect.left + 14) + 'px';
        cursorTag.style.top = (ev.clientY - rect.top + 16) + 'px';
        cursorTag.style.display = 'block';
    }
    function hideCursorTag() { cursorTag.style.display = 'none'; }

    // ---------- Smart measurement ----------
    // Distance read-outs to the nearest sibling edges, mirroring the red measurement
    // guides professional editors show while you drag (Figma: "Measure distances between layers").
    function nearestEdges(x, y, w, h) {
        const cx = x + w / 2, cy = y + h / 2;
        let left = null, right = null, top = null, bottom = null;
        elements.forEach((el, i) => {
            if (i === selected || !el.isVisible) return;
            // Horizontal neighbours share vertical space with the dragged element.
            if (el.y < y + h && el.y + el.height > y) {
                const elRight = el.x + el.width;
                if (elRight <= cx && (!left || elRight > left.x + left.width)) left = el;
                if (el.x >= cx && (!right || el.x < right.x)) right = el;
            }
            // Vertical neighbours share horizontal space.
            if (el.x < x + w && el.x + el.width > x) {
                const elBottom = el.y + el.height;
                if (elBottom <= cy && (!top || elBottom > top.y + top.height)) top = el;
                if (el.y >= cy && (!bottom || el.y < bottom.y)) bottom = el;
            }
        });
        return { left, right, top, bottom };
    }
    function clearMeasures() { measureLayer.replaceChildren(); }
    function renderMeasures(x, y, w, h) {
        clearMeasures();
        if (!snapOn) return;
        const s = scale();
        const nb = nearestEdges(x, y, w, h);
        const addBadge = (bx, by, text) => {
            const d = document.createElement('div');
            d.className = 'ped-measure-badge';
            d.style.left = (bx * s) + 'px';
            d.style.top = (by * s) + 'px';
            d.textContent = Math.round(text);
            measureLayer.appendChild(d);
        };
        const addLine = (x1, y1, x2, y2) => {
            const horizontal = Math.abs(y2 - y1) < Math.abs(x2 - x1);
            const d = document.createElement('div');
            d.className = 'ped-measure-line' + (horizontal ? ' h' : ' v');
            d.style.left = (Math.min(x1, x2) * s) + 'px';
            d.style.top = (Math.min(y1, y2) * s) + 'px';
            if (horizontal) d.style.width = (Math.abs(x2 - x1) * s) + 'px';
            else d.style.height = (Math.abs(y2 - y1) * s) + 'px';
            measureLayer.appendChild(d);
        };
        // Horizontal gaps, drawn along the element's vertical centre.
        const my = y + h / 2;
        if (nb.left) {
            const gap = x - (nb.left.x + nb.left.width);
            addLine(nb.left.x + nb.left.width, my, x, my);
            addBadge((nb.left.x + nb.left.width + x) / 2, my, gap);
        }
        if (nb.right) {
            const gap = nb.right.x - (x + w);
            addLine(x + w, my, nb.right.x, my);
            addBadge((x + w + nb.right.x) / 2, my, gap);
        }
        // Vertical gaps, drawn along the element's horizontal centre.
        const mx = x + w / 2;
        if (nb.top) {
            const gap = y - (nb.top.y + nb.top.height);
            addLine(mx, nb.top.y + nb.top.height, mx, y);
            addBadge(mx, (nb.top.y + nb.top.height + y) / 2, gap);
        }
        if (nb.bottom) {
            const gap = nb.bottom.y - (y + h);
            addLine(mx, y + h, mx, nb.bottom.y);
            addBadge(mx, (y + h + nb.bottom.y) / 2, gap);
        }
    }

    // ---------- Viewport (zoom & pan) ----------
    function zoomAround(nextZoom, clientX, clientY) {
        const before = areaEl.getBoundingClientRect();
        const px = clientX - before.left + areaEl.scrollLeft;
        const py = clientY - before.top + areaEl.scrollTop;
        const z0 = zoom;
        zoom = clamp(nextZoom, 0.25, 3);
        render();
        const ratio = zoom / z0;
        areaEl.scrollLeft = px * ratio - (clientX - before.left);
        areaEl.scrollTop = py * ratio - (clientY - before.top);
    }
    function resetZoom() { zoom = 1; render(); }
    function zoomToSelection() {
        const el = elements[selected];
        if (!el) return zoomFit();
        const availW = areaEl.clientWidth - 120;
        const availH = areaEl.clientHeight - 120;
        zoom = clamp(Math.min(availW / el.width, availH / el.height), 0.25, 3);
        render();
        centerOn(el.x + el.width / 2, el.y + el.height / 2);
    }
    function zoomFit() {
        const availW = areaEl.clientWidth - 80;
        const availH = areaEl.clientHeight - 110;
        zoom = clamp(Math.min(availW / canvasW, availH / canvasH), 0.25, 3);
        render();
        areaEl.scrollLeft = 0;
        areaEl.scrollTop = 0;
    }
    function centerOn(cx, cy) {
        areaEl.scrollLeft = cx * zoom - areaEl.clientWidth / 2;
        areaEl.scrollTop = cy * zoom - areaEl.clientHeight / 2;
    }

    // ---------- Render ----------
    function render() {
        canvasEl.innerHTML = '';
        canvasEl.style.width = canvasW + 'px';
        canvasEl.style.height = canvasH + 'px';
        canvasEl.style.transform = 'scale(' + zoom + ')';
        canvasEl.style.backgroundColor = cProps.backgroundColor;
        canvasEl.style.border = cProps.borderWidth + 'px solid ' + cProps.borderColor;
        canvasEl.style.borderRadius = cProps.borderRadius + 'px';
        stageEl.style.width = (canvasW * zoom) + 'px';
        stageEl.style.height = (canvasH * zoom) + 'px';

        if (backgroundImageUrl) {
            const bg = document.createElement('img');
            bg.className = 'ped-bg-image';
            bg.src = backgroundImageUrl;
            bg.alt = '';
            bg.style.position = 'absolute';
            bg.style.inset = '0';
            bg.style.width = '100%';
            bg.style.height = '100%';
            bg.style.objectFit = 'fill';
            bg.style.zIndex = '0';
            bg.style.pointerEvents = 'none';
            canvasEl.appendChild(bg);
        }

        const grid = document.createElement('div');
        grid.className = 'ped-grid';
        grid.style.backgroundSize = (28 * zoom) + 'px ' + (28 * zoom) + 'px';
        canvasEl.appendChild(grid);
        guideX.style.display = 'none';
        guideY.style.display = 'none';
        canvasEl.appendChild(guideX);
        canvasEl.appendChild(guideY);
        clearMeasures();
        canvasEl.appendChild(measureLayer);
        canvasEl.appendChild(marqueeBox);

        // order by array position (zIndex normalized)
        const ordered = elements.map((el, i) => ({ el, i })).filter(o => o.el.isVisible);
        for (const o of ordered) {
            const node = document.createElement('div');
            node.className = 'ped-el' + (o.el.elementType === 'divider' ? ' el-divider' : '') + (o.el.elementType === 'qr' ? ' el-qr' : '') + (o.el.elementType === 'barcode' ? ' el-barcode' : '') + (o.el.elementType === 'partner_logo' ? ' el-partner-logo' : '') + (o.el.elementType === 'partner_signature' ? ' el-partner-signature' : '') + (o.el.elementType === 'instructor_signature' ? ' el-signature' : '');
            node.dataset.index = o.i;
            Object.assign(node.style, styleFor(o.el));
            node.textContent = contentFor(o.el);
            node.addEventListener('pointerdown', e => startDrag(e, o.i));
            node.addEventListener('dblclick', e => { e.preventDefault(); select(o.i); beginInlineEdit(o.i); });
            canvasEl.appendChild(node);
        }

        if (selection.length > 1) renderSelectionOverlays();
        else if (selected >= 0 && elements[selected] && elements[selected].isVisible) drawOverlay(selected);
        $('zoomLabel').textContent = Math.round(zoom * 100) + '%';
        if (previewMode) document.querySelectorAll('.ped-el').forEach(n => n.style.cursor = 'default');
        renderRulers();
    }

    function drawOverlay(index) {
        const el = elements[index];
        const ov = document.createElement('div');
        ov.className = 'ped-overlay';
        ov.style.left = el.x + 'px';
        ov.style.top = el.y + 'px';
        ov.style.width = el.width + 'px';
        ov.style.height = (el.elementType === 'divider' ? 4 : el.height) + 'px';
        ov.style.transform = 'rotate(' + (el.rotation || 0) + 'deg)';
        ov.style.transformOrigin = 'center';
        const box = document.createElement('div');
        box.className = 'ped-box';
        ov.appendChild(box);
        if (!previewMode) {
            const handles = [['nw'], ['n'], ['ne'], ['e'], ['se'], ['s'], ['sw'], ['w']];
            handles.forEach(([pos]) => {
                const h = document.createElement('div');
                h.className = 'ped-handle h-' + pos;
                h.addEventListener('pointerdown', e => startResize(e, pos));
                ov.appendChild(h);
            });
            const rl = document.createElement('div');
            rl.className = 'ped-rotate-line';
            ov.appendChild(rl);
            const rt = document.createElement('div');
            rt.className = 'ped-rotate';
            rt.innerHTML = '<i class="bi bi-arrow-repeat"></i>';
            rt.addEventListener('pointerdown', e => startRotate(e));
            ov.appendChild(rt);
            const dim = document.createElement('div');
            dim.className = 'ped-dim';
            dim.textContent = el.width + ' × ' + el.height;
            ov.appendChild(dim);
        }
        canvasEl.appendChild(ov);
    }

    // ---------- Interactions ----------
    function startDrag(e, index) {
        if (previewMode || e.button !== 0) return;
        // Space-drag pans the viewport, so it must not also move the element underneath.
        if (spaceDown || panning) return;
        // A locked element ignores direct manipulation; it is still selectable from the layers panel.
        if (elements[index] && elements[index].isLocked) return;
        e.preventDefault();
        const additive = e.shiftKey;
        // Shift toggles membership; a plain click on an unselected element selects just it, while a
        // plain click inside an existing multi-selection keeps the group so it can be dragged whole.
        if (additive) {
            select(index, true);
            return;
        }
        if (selection.indexOf(index) < 0) select(index);
        // Locked members are dropped from the drag set; the rest still move together.
        const group = selection.filter(i => elements[i] && !elements[i].isLocked);
        if (!group.length) return;
        pushHistory();
        const startX = e.clientX, startY = e.clientY;
        const origins = group.map(i => ({ i, x: elements[i].x, y: elements[i].y }));
        const s = () => scale();
        let snapNow = snapOn && !e.ctrlKey && !e.metaKey;
        const move = ev => {
            const snapping = snapNow && !ev.ctrlKey && !ev.metaKey;
            const dx = (ev.clientX - startX) / s();
            const dy = (ev.clientY - startY) / s();
            if (group.length === 1) {
                const el = elements[group[0]];
                const nx = origins[0].x + dx, ny = origins[0].y + dy;
                const r = snapping
                    ? computeSnap(nx, ny, el.width, el.height)
                    : { x: nx, y: ny, gx: null, gy: null };
                el.x = clamp(Math.round(r.x), 0, canvasW - 10);
                el.y = clamp(Math.round(r.y), 0, canvasH - 10);
                renderGuides(snapping ? r.gx : null, snapping ? r.gy : null);
                renderMeasures(el.x, el.y, el.width, el.height);
            } else {
                // Group move: every element shifts by the same delta, and the bounds clamp the
                // whole cluster so nothing is pushed off-canvas.
                let ddx = Math.round(dx), ddy = Math.round(dy);
                let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
                origins.forEach(o => {
                    const el = elements[o.i];
                    minX = Math.min(minX, o.x + ddx); minY = Math.min(minY, o.y + ddy);
                    maxX = Math.max(maxX, o.x + ddx + el.width); maxY = Math.max(maxY, o.y + ddy + el.height);
                });
                if (minX < 0) ddx -= minX;
                if (minY < 0) ddy -= minY;
                if (maxX > canvasW) ddx -= (maxX - canvasW);
                if (maxY > canvasH) ddy -= (maxY - canvasH);
                origins.forEach(o => { elements[o.i].x = o.x + ddx; elements[o.i].y = o.y + ddy; });
                renderSelectionNodes(group);
                clearGuides();
            }
            renderSelectionOverlays();
            showCursorTag(ev, elements[group[0]].x, elements[group[0]].y);
        };
        const up = () => {
            window.removeEventListener('pointermove', move);
            window.removeEventListener('pointerup', up);
            clearGuides();
            clearMeasures();
            hideCursorTag();
            refreshLayers();
            updateToolbarState();
        };
        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
    }

    function renderSelectionNodes(group) {
        group.forEach(i => updateNode(elements[i], i));
    }
    function renderSelectionOverlays() {
        canvasEl.querySelectorAll('.ped-overlay').forEach(o => o.remove());
        if (selection.length > 1) {
            const b = selectionBounds();
            selection.forEach(i => drawBox(i, false));
            if (b) drawGroupBox(b);
        } else if (selection.length === 1) {
            drawOverlay(selection[0]);
        }
    }

    // Group resize scales every selected element proportionally inside the new bounds.
    function startGroupResize(e, pos) {
        if (previewMode || e.button !== 0) return;
        e.preventDefault();
        e.stopPropagation();
        const b = selectionBounds();
        if (!b) return;
        pushHistory();
        const startX = e.clientX, startY = e.clientY;
        const orig = selection.filter(i => elements[i] && !elements[i].isLocked)
            .map(i => ({ i, x: elements[i].x, y: elements[i].y, w: elements[i].width, h: elements[i].height }));
        if (!orig.length) return;
        const s = () => scale();
        const MIN = 24;
        const move = ev => {
            const dx = (ev.clientX - startX) / s();
            const dy = (ev.clientY - startY) / s();
            let nx = b.x, ny = b.y, nw = b.width, nh = b.height;
            if (pos.includes('e')) nw = b.width + dx;
            if (pos.includes('s')) nh = b.height + dy;
            if (pos.includes('w')) { nw = b.width - dx; nx = b.x + dx; }
            if (pos.includes('n')) { nh = b.height - dy; ny = b.y + dy; }
            if (nw < MIN) { if (pos.includes('w')) nx = b.x + b.width - MIN; nw = MIN; }
            if (nh < MIN) { if (pos.includes('n')) ny = b.y + b.height - MIN; nh = MIN; }
            const sx = nw / b.width, sy = nh / b.height;
            orig.forEach(o => {
                const el = elements[o.i];
                el.x = Math.round(nx + (o.x - b.x) * sx);
                el.y = Math.round(ny + (o.y - b.y) * sy);
                el.width = Math.max(20, Math.round(o.w * sx));
                el.height = Math.max(20, Math.round(o.h * sy));
                if (el.elementType === 'divider') el.height = 4;
                updateNode(el, o.i);
            });
            renderSelectionOverlays();
        };
        const up = () => {
            window.removeEventListener('pointermove', move);
            window.removeEventListener('pointerup', up);
            refreshLayers();
            updateToolbarState();
        };
        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
    }

    function startResize(e, pos) {
        if (previewMode || e.button !== 0) return;
        e.preventDefault();
        e.stopPropagation();
        pushHistory();
        const el = elements[selected];
        const startX = e.clientX, startY = e.clientY;
        const orig = { x: el.x, y: el.y, w: el.width, h: el.height };
        const s = () => scale();
        const MIN = 18;
        const move = ev => {
            const dx = (ev.clientX - startX) / s();
            const dy = (ev.clientY - startY) / s();
            let nx = orig.x, ny = orig.y, nw = orig.w, nh = orig.h;
            if (pos.includes('e')) nw = orig.w + dx;
            if (pos.includes('s')) nh = orig.h + dy;
            if (pos.includes('w')) { nw = orig.w - dx; nx = orig.x + dx; }
            if (pos.includes('n')) { nh = orig.h - dy; ny = orig.y + dy; }
            if (nw < MIN) { if (pos.includes('w')) nx = orig.x + orig.w - MIN; nw = MIN; }
            if (nh < MIN) { if (pos.includes('n')) ny = orig.y + orig.h - MIN; nh = MIN; }
            // Holding Shift keeps the original aspect ratio, the convention every design
            // tool shares for corner handles.
            if (ev.shiftKey && orig.h > 0 && (pos === 'nw' || pos === 'ne' || pos === 'se' || pos === 'sw')) {
                const ratio = orig.w / orig.h;
                nh = nw / ratio;
                if (pos.includes('n')) ny = orig.y + orig.h - nh;
            }
            const snapping = snapOn && !ev.ctrlKey && !ev.metaKey;
            let r = { x: nx, y: ny, w: nw, h: nh, gx: null, gy: null };
            if (snapping) {
                const sx = computeSnap(nx, ny, nw, nh);
                if (sx.x !== nx || sx.w !== nw) { nx = sx.x; nw = sx.w; }
                if (sx.y !== ny || sx.h !== nh) { ny = sx.y; nh = sx.h; }
                r = sx;
            }
            el.x = clamp(Math.round(nx), 0, canvasW - 10);
            el.y = clamp(Math.round(ny), 0, canvasH - 10);
            el.width = clamp(Math.round(nw), MIN, canvasW);
            el.height = clamp(Math.round(nh), MIN, canvasH);
            if (el.elementType === 'divider') el.height = 4;
            updateNode(el, selected);
            renderGuides(snapping ? r.gx : null, snapping ? r.gy : null);
            showCursorTag(ev, el.width, el.height);
        };
        const up = () => {
            window.removeEventListener('pointermove', move);
            window.removeEventListener('pointerup', up);
            clearGuides();
            hideCursorTag();
            refreshLayers();
            updateToolbarState();
        };
        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
    }

    function startRotate(e) {
        if (previewMode || e.button !== 0) return;
        e.preventDefault();
        e.stopPropagation();
        pushHistory();
        const el = elements[selected];
        const cx = el.x + el.width / 2, cy = el.y + el.height / 2;
        const s = () => scale();
        const fromPoint = ev => {
            const r = canvasEl.getBoundingClientRect();
            const px = (ev.clientX - r.left) / s() + canvasEl.getBoundingClientRect().left / s() * 0;
            const raw = Math.atan2(ev.clientY - (r.top + cy * s()), ev.clientX - (r.left + cx * s()));
            return raw * 180 / Math.PI;
        };
        const startAngle = fromPoint(e);
        const move = ev => {
            let deg = fromPoint(ev) - startAngle + (el.rotation || 0);
            if (e.shiftKey) deg = Math.round(deg / 15) * 15;
            el.rotation = clamp(Math.round(deg), -180, 180);
            updateNode(el, selected);
            $('rotationLabel').textContent = el.rotation + '°';
            $('selectedRotation').value = el.rotation;
        };
        const up = () => {
            window.removeEventListener('pointermove', move);
            window.removeEventListener('pointerup', up);
        };
        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
    }

    function updateNode(el, index) {
        const nodes = canvasEl.querySelectorAll('.ped-el[data-index="' + index + '"]');
        nodes.forEach(n => {
            Object.assign(n.style, styleFor(el));
            n.textContent = contentFor(el);
        });
        canvasEl.querySelectorAll('.ped-overlay').forEach(o => o.remove());
        if (selection.length > 1) renderSelectionOverlays();
        else if (selected >= 0 && elements[selected]) drawOverlay(selected);
    }

    // ---------- Selection ----------
    // `selected` stays the primary (last-clicked) element for the properties panel; `selection`
    // holds every element the user has picked so group move/resize/rotate can act on all of them.
    function selectionBounds() {
        if (!selection.length) return null;
        let x1 = Infinity, y1 = Infinity, x2 = -Infinity, y2 = -Infinity;
        selection.forEach(i => {
            const el = elements[i];
            if (!el) return;
            x1 = Math.min(x1, el.x); y1 = Math.min(y1, el.y);
            x2 = Math.max(x2, el.x + el.width); y2 = Math.max(y2, el.y + el.height);
        });
        return { x: x1, y: y1, width: x2 - x1, height: y2 - y1 };
    }
    function renderSelection() {
        canvasEl.querySelectorAll('.ped-overlay').forEach(o => o.remove());
        if (selection.length > 1) {
            const b = selectionBounds();
            selection.forEach(i => drawBox(i, false));
            if (b) drawGroupBox(b);
        } else if (selection.length === 1 && elements[selection[0]]) {
            drawOverlay(selection[0]);
        }
        refreshPropsPanel();
        refreshLayers();
        updateToolbarState();
    }
    function select(index, additive) {
        // Picking one member of a group selects the whole group (unless additive toggling removes it).
        if (additive) {
            const members = elements[index] && elements[index].groupId ? groupMembers(elements[index].groupId) : [index];
            const at = selection.indexOf(index);
            if (at >= 0) {
                selection = selection.filter(i => members.indexOf(i) < 0);
                selected = selection.length ? selection[selection.length - 1] : -1;
            } else {
                members.forEach(m => { if (selection.indexOf(m) < 0) selection.push(m); });
                selected = index;
            }
        } else {
            selection = elements[index] && elements[index].groupId ? groupMembers(elements[index].groupId) : [index];
            selected = index;
        }
        renderSelection();
    }
    function selectMany(indices) {
        selection = expandSelectionToGroups(indices);
        selected = selection.length ? selection[selection.length - 1] : -1;
        renderSelection();
    }
    function selectAll() {
        selectMany(elements.map((el, i) => i).filter(i => elements[i].isVisible));
    }
    function deselect() {
        selected = -1;
        selection = [];
        renderSelection();
    }
    function drawBox(index, withHandles) {
        const el = elements[index];
        if (!el) return;
        const ov = document.createElement('div');
        ov.className = 'ped-overlay ped-overlay-multi';
        ov.style.left = el.x + 'px';
        ov.style.top = el.y + 'px';
        ov.style.width = el.width + 'px';
        ov.style.height = (el.elementType === 'divider' ? 4 : el.height) + 'px';
        ov.style.transform = 'rotate(' + (el.rotation || 0) + 'deg)';
        ov.style.transformOrigin = 'center';
        const box = document.createElement('div');
        box.className = 'ped-box';
        ov.appendChild(box);
        if (withHandles) {
            const handles = [['nw'], ['n'], ['ne'], ['e'], ['se'], ['s'], ['sw'], ['w']];
            handles.forEach(([pos]) => {
                const h = document.createElement('div');
                h.className = 'ped-handle h-' + pos;
                h.addEventListener('pointerdown', e => startResize(e, pos));
                ov.appendChild(h);
            });
        }
        canvasEl.appendChild(ov);
    }
    function drawGroupBox(b) {
        const ov = document.createElement('div');
        ov.className = 'ped-overlay ped-group';
        ov.style.left = b.x + 'px';
        ov.style.top = b.y + 'px';
        ov.style.width = b.width + 'px';
        ov.style.height = b.height + 'px';
        const box = document.createElement('div');
        box.className = 'ped-group-box';
        ov.appendChild(box);
        const handles = [['nw'], ['n'], ['ne'], ['e'], ['se'], ['s'], ['sw'], ['w']];
        handles.forEach(([pos]) => {
            const h = document.createElement('div');
            h.className = 'ped-handle h-' + pos;
            h.addEventListener('pointerdown', e => startGroupResize(e, pos));
            ov.appendChild(h);
        });
        const dim = document.createElement('div');
        dim.className = 'ped-dim';
        dim.textContent = selection.length + ' عناصر';
        ov.appendChild(dim);
        canvasEl.appendChild(ov);
    }
    function marqueeSelect(x1, y1, x2, y2, additive) {
        const left = Math.min(x1, x2), right = Math.max(x1, x2);
        const top = Math.min(y1, y2), bottom = Math.max(y1, y2);
        const hits = elements.map((el, i) => i).filter(i => {
            const el = elements[i];
            if (!el || !el.isVisible) return false;
            // Intersection test: an element is selected when it overlaps the rubber band.
            return el.x < right && el.x + el.width > left && el.y < bottom && el.y + el.height > top;
        });
        const merged = additive ? Array.from(new Set(selection.concat(hits))) : hits;
        selectMany(merged);
    }
    canvasEl.addEventListener('pointerdown', e => {
        if (e.target === canvasEl || e.target.classList.contains('ped-grid') || e.target.classList.contains('ped-guide') || e.target.classList.contains('ped-measure')) {
            startMarquee(e);
        }
    });

    // ---------- Marquee ----------
    function startMarquee(e) {
        if (previewMode || e.button !== 0 || spaceDown) return;
        e.preventDefault();
        const r = canvasEl.getBoundingClientRect();
        const s = scale();
        const toCanvas = ev => ({
            x: (ev.clientX - r.left) / s,
            y: (ev.clientY - r.top) / s
        });
        const start = toCanvas(e);
        const additive = e.shiftKey;
        let moved = false;
        marqueeBox.style.display = 'block';
        const move = ev => {
            const p = toCanvas(ev);
            const x = Math.min(start.x, p.x), y = Math.min(start.y, p.y);
            const w = Math.abs(p.x - start.x), h = Math.abs(p.y - start.y);
            if (w > 2 || h > 2) moved = true;
            Object.assign(marqueeBox.style, {
                left: x + 'px', top: y + 'px', width: w + 'px', height: h + 'px'
            });
        };
        const up = ev => {
            window.removeEventListener('pointermove', move);
            window.removeEventListener('pointerup', up);
            marqueeBox.style.display = 'none';
            const p = toCanvas(ev);
            if (moved) marqueeSelect(start.x, start.y, p.x, p.y, additive);
            else if (!additive) deselect();
        };
        window.addEventListener('pointermove', move);
        window.addEventListener('pointerup', up);
    }

    // ---------- Add / Remove / Order ----------
    // `dropPoint` (canvas coordinates) is supplied when the user drags an item from the library
    // onto the canvas, so the element lands under the pointer instead of at a default slot.
    function addElement(type, fieldKey, dropPoint) {
        pushHistory();
        const count = elements.length;
        const isLogo = type === 'partner_logo';
        const isPartnerSig = type === 'partner_signature';
        const isSig = type === 'instructor_signature';
        const w = type === 'divider' ? 420 : (type === 'qr' ? 160 : (type === 'barcode' ? 320 : (isLogo ? 170 : (isPartnerSig ? 240 : (isSig ? 240 : 560)))));
        const h = type === 'divider' ? 4 : (type === 'qr' ? 160 : (type === 'barcode' ? 80 : (isLogo ? 170 : (isPartnerSig ? 90 : (isSig ? 90 : 58)))));
        // Partner slots are numbered per element type: logos run 0,1,… and signatures run 0,1,…
        // independently, because both index into the same course partner list. Sharing one counter
        // (the old behaviour) pushed signatures past the partner count, so they rendered nothing.
        const usedSlots = elements.filter(e => e.elementType === type).map(slotOf);
        const nextSlot = isPartnerSlot(type) ? (usedSlots.length ? Math.max(...usedSlots) + 1 : 0) : 0;
        const el = {
            elementType: type,
            fieldKey: type === 'field' ? (fieldKey || 'trainee_name')
                : (type === 'barcode' ? 'certificate_number'
                    : (isPartnerSlot(type) ? String(nextSlot) : '')),
            content: type === 'text' ? 'نص جديد' : '',
            x: dropPoint ? clamp(Math.round(dropPoint.x - w / 2), 0, canvasW - 20) : clamp(Math.round((canvasW - w) / 2), 0, canvasW - 20),
            y: dropPoint ? clamp(Math.round(dropPoint.y - h / 2), 0, canvasH - 20) : clamp(100 + (count % 6) * 82, 0, canvasH - 20),
            width: w, height: h,
            fontSize: type === 'text' ? 22 : 28,
            fontFamily: 'Tajawal', fontColor: '#172033', fontWeight: '600',
            textAlign: 'center', isVisible: true, zIndex: count, rotation: 0, opacity: 100, isLocked: false,
            isItalic: false, isUnderline: false, lineHeight: 130, letterSpacing: 0, groupId: null
        };
        elements.push(el);
        selected = elements.length - 1;
        render();
        refreshLayers();
        refreshPropsPanel();
        updateToolbarState();
    }
    function deleteSelected() {
        // Locked elements survive a delete; unlock them from the layers panel first. Deleting any
        // member of a group removes the whole group, matching how selection works.
        const expanded = expandSelectionToGroups(selection);
        const removable = expanded.filter(i => elements[i] && !elements[i].isLocked);
        if (!removable.length) return;
        pushHistory();
        // Delete from the highest index down so earlier splices do not shift later ones.
        removable.sort((a, b) => b - a).forEach(i => elements.splice(i, 1));
        selected = -1;
        selection = [];
        normalizeZ();
        render();
        refreshLayers();
        refreshPropsPanel();
        updateToolbarState();
    }
    function duplicateSelected() {
        if (!selection.length) return;
        pushHistory();
        const copies = [];
        selection.slice().sort((a, b) => a - b).forEach(i => {
            const copy = JSON.parse(JSON.stringify(elements[i]));
            copy.x = clamp(copy.x + 28, 0, canvasW - 20);
            copy.y = clamp(copy.y + 28, 0, canvasH - 20);
            elements.push(copy);
            copies.push(elements.length - 1);
        });
        normalizeZ();
        render();
        selectMany(copies);
        refreshLayers();
        refreshPropsPanel();
        updateToolbarState();
    }
    function normalizeZ() {
        elements.forEach((el, i) => { el.zIndex = i; el.sortOrder = i; });
    }
    function copySelected() {
        if (!selection.length) return;
        // Snapshot deep copies so later edits to the originals do not mutate the clipboard.
        clipboard = selection.slice().sort((a, b) => a - b).map(i => JSON.parse(JSON.stringify(elements[i])));
    }
    function cutSelected() {
        const removable = selection.filter(i => elements[i] && !elements[i].isLocked);
        if (!removable.length) return;
        copySelected();
        deleteSelected();
    }
    function pasteClipboard() {
        if (!clipboard.length) return;
        pushHistory();
        // Paste as a new, offset batch so the copies are visible and land on top of the stack.
        const copies = clipboard.map(src => {
            const copy = JSON.parse(JSON.stringify(src));
            copy.x = clamp(copy.x + 24, 0, canvasW - 20);
            copy.y = clamp(copy.y + 24, 0, canvasH - 20);
            copy.isLocked = false;
            elements.push(copy);
            return elements.length - 1;
        });
        normalizeZ();
        render();
        selectMany(copies);
        refreshLayers();
        refreshPropsPanel();
        updateToolbarState();
    }
    function moveOrder(dir) {
        if (selected < 0) return;
        pushHistory();
        const arr = elements;
        const i = selected, j = i + dir;
        if (j < 0 || j >= arr.length) return;
        [arr[i], arr[j]] = [arr[j], arr[i]];
        selected = j;
        normalizeZ();
        render();
        refreshLayers();
        refreshPropsPanel();
        updateToolbarState();
    }
    function toExtreme(front) {
        if (selected < 0) return;
        pushHistory();
        const el = elements.splice(selected, 1)[0];
        if (front) elements.push(el); else elements.unshift(el);
        selected = front ? elements.length - 1 : 0;
        normalizeZ();
        render();
        refreshLayers();
        refreshPropsPanel();
        updateToolbarState();
    }
    // ---------- Grouping ----------
    // A group is a shared token on the elements themselves, so it survives save/load without a
    // separate table. Clicking one member selects the whole group, and moves/resizes act on all.
    function groupMembers(groupId) {
        return elements.map((el, i) => i).filter(i => elements[i].groupId && elements[i].groupId === groupId);
    }
    function expandSelectionToGroups(indices) {
        const out = new Set();
        indices.forEach(i => {
            const el = elements[i];
            if (!el) return;
            if (el.groupId) groupMembers(el.groupId).forEach(m => out.add(m));
            else out.add(i);
        });
        return Array.from(out).sort((a, b) => a - b);
    }
    function groupSelected() {
        const indices = selection.filter(i => elements[i] && !elements[i].isLocked);
        if (indices.length < 2) return;
        pushHistory();
        const id = 'g' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
        indices.forEach(i => { elements[i].groupId = id; });
        refreshLayers();
        updateToolbarState();
    }
    function ungroupSelected() {
        const hasGroup = selection.some(i => elements[i] && elements[i].groupId);
        if (!hasGroup) return;
        pushHistory();
        selection.forEach(i => { if (elements[i]) elements[i].groupId = null; });
        refreshLayers();
        updateToolbarState();
    }
    // ---------- Style presets ----------
    // One-click typography so a designer does not hand-tune size/weight/spacing for every label.
    const STYLE_PRESETS = {
        title: { fontSize: 40, fontWeight: '800', letterSpacing: 0, lineHeight: 130, isItalic: false, isUnderline: false, textAlign: 'center' },
        subtitle: { fontSize: 26, fontWeight: '600', letterSpacing: 0, lineHeight: 140, isItalic: false, isUnderline: false, textAlign: 'center' },
        name: { fontSize: 34, fontWeight: '800', letterSpacing: 0, lineHeight: 130, isItalic: false, isUnderline: false, textAlign: 'center' },
        body: { fontSize: 18, fontWeight: '400', letterSpacing: 0, lineHeight: 160, isItalic: false, isUnderline: false, textAlign: 'center' },
        caption: { fontSize: 13, fontWeight: '400', letterSpacing: 2, lineHeight: 140, isItalic: false, isUnderline: false, textAlign: 'center' },
        quote: { fontSize: 20, fontWeight: '500', letterSpacing: 0, lineHeight: 160, isItalic: true, isUnderline: false, textAlign: 'center' }
    };
    function applyPreset(name) {
        const preset = STYLE_PRESETS[name];
        const targets = selection.filter(i => elements[i] && !elements[i].isLocked && elements[i].elementType !== 'divider');
        if (!preset || !targets.length) return;
        pushHistory();
        targets.forEach(i => Object.assign(elements[i], preset));
        render();
        renderSelection();
    }
    // ---------- Align / Distribute / Tidy ----------
    // Align to the canvas for a single element; align the group's bounds to the canvas when several
    // elements are selected (Figma: align to parent vs. to selection).
    function alignElement(kind) {
        if (!selection.length) return;
        pushHistory();
        if (selection.length === 1) {
            const el = elements[selection[0]];
            if (kind === 'left') el.x = 0;
            if (kind === 'hcenter') el.x = Math.round((canvasW - el.width) / 2);
            if (kind === 'right') el.x = canvasW - el.width;
            if (kind === 'top') el.y = 0;
            if (kind === 'vcenter') el.y = Math.round((canvasH - el.height) / 2);
            if (kind === 'bottom') el.y = canvasH - el.height;
            el.x = clamp(el.x, 0, canvasW - 20);
            el.y = clamp(el.y, 0, canvasH - 20);
            updateNode(el, selection[0]);
        } else {
            const b = selectionBounds();
            let dx = 0, dy = 0;
            if (kind === 'left') dx = -b.x;
            if (kind === 'hcenter') dx = Math.round((canvasW - b.width) / 2) - b.x;
            if (kind === 'right') dx = (canvasW - b.width) - b.x;
            if (kind === 'top') dy = -b.y;
            if (kind === 'vcenter') dy = Math.round((canvasH - b.height) / 2) - b.y;
            if (kind === 'bottom') dy = (canvasH - b.height) - b.y;
            selection.forEach(i => { elements[i].x += dx; elements[i].y += dy; });
            render();
            renderSelectionOverlays();
        }
        refreshPropsPanel();
        refreshLayers();
        updateToolbarState();
    }

    // Align the selected elements to each other: the extreme edges form the reference, and every
    // other element is brought to it (Figma: align to selection).
    function alignWithinSelection(kind) {
        if (selection.length < 2) return;
        pushHistory();
        const items = selection.map(i => ({ i, el: elements[i] }));
        if (kind === 'left') {
            const ref = Math.min(...items.map(o => o.el.x));
            items.forEach(o => { o.el.x = ref; });
        } else if (kind === 'right') {
            const ref = Math.max(...items.map(o => o.el.x + o.el.width));
            items.forEach(o => { o.el.x = ref - o.el.width; });
        } else if (kind === 'hcenter') {
            const ref = Math.round(items.reduce((s, o) => s + o.el.x + o.el.width / 2, 0) / items.length);
            items.forEach(o => { o.el.x = Math.round(ref - o.el.width / 2); });
        } else if (kind === 'top') {
            const ref = Math.min(...items.map(o => o.el.y));
            items.forEach(o => { o.el.y = ref; });
        } else if (kind === 'bottom') {
            const ref = Math.max(...items.map(o => o.el.y + o.el.height));
            items.forEach(o => { o.el.y = ref - o.el.height; });
        } else if (kind === 'vcenter') {
            const ref = Math.round(items.reduce((s, o) => s + o.el.y + o.el.height / 2, 0) / items.length);
            items.forEach(o => { o.el.y = Math.round(ref - o.el.height / 2); });
        }
        render();
        renderSelectionOverlays();
        refreshPropsPanel();
        refreshLayers();
        updateToolbarState();
    }

    // Even spacing between elements: the outermost two anchor the run and the rest are distributed
    // with equal gaps (Figma: distribute horizontal/vertical spacing).
    function distribute(kind) {
        if (selection.length < 3) return;
        pushHistory();
        const items = selection.map(i => ({ i, el: elements[i] }));
        if (kind === 'h') {
            items.sort((a, b) => a.el.x - b.el.x);
            const totalW = items.reduce((s, o) => s + o.el.width, 0);
            const span = (items[items.length - 1].el.x + items[items.length - 1].el.width) - items[0].el.x;
            const gap = (span - totalW) / (items.length - 1);
            let cursor = items[0].el.x;
            items.forEach(o => { o.el.x = Math.round(cursor); cursor += o.el.width + gap; });
        } else {
            items.sort((a, b) => a.el.y - b.el.y);
            const totalH = items.reduce((s, o) => s + o.el.height, 0);
            const span = (items[items.length - 1].el.y + items[items.length - 1].el.height) - items[0].el.y;
            const gap = (span - totalH) / (items.length - 1);
            let cursor = items[0].el.y;
            items.forEach(o => { o.el.y = Math.round(cursor); cursor += o.el.height + gap; });
        }
        render();
        renderSelectionOverlays();
        refreshPropsPanel();
        refreshLayers();
        updateToolbarState();
    }

    // Tidy up: pack the selection into an evenly spaced column and align it to the canvas centre —
    // the one-click "make this look deliberate" action (Figma: Tidy up).
    function tidyUp() {
        if (selection.length < 2) return;
        pushHistory();
        const items = selection.map(i => ({ i, el: elements[i] })).sort((a, b) => a.el.y - b.el.y);
        const gap = 24;
        const totalH = items.reduce((s, o) => s + o.el.height, 0) + gap * (items.length - 1);
        let y = Math.max(0, Math.round((canvasH - totalH) / 2));
        items.forEach(o => {
            o.el.x = Math.round((canvasW - o.el.width) / 2);
            o.el.y = y;
            y += o.el.height + gap;
        });
        render();
        renderSelectionOverlays();
        refreshPropsPanel();
        refreshLayers();
        updateToolbarState();
    }

    // ---------- Layers Panel ----------
    let layerDragFrom = -1;
    function refreshLayers() {
        const list = $('layersList');
        $('layerCount').textContent = elements.length + ' عنصر';
        if (!elements.length) {
            list.innerHTML = '<div class="ped-empty"><i class="bi bi-inbox"></i><div>لا توجد عناصر بعد<br/>أضف نصاً أو حقلاً من لوحة العناصر</div></div>';
            return;
        }
        list.innerHTML = '';
        for (let i = elements.length - 1; i >= 0; i--) {
            const el = elements[i];
            const row = document.createElement('div');
            row.className = 'ped-layer' + (selection.indexOf(i) >= 0 ? ' active' : '') + (el.isLocked ? ' locked' : '') + (el.isVisible === false ? ' hidden' : '');
            row.draggable = true;
            row.dataset.index = String(i);
            const icon = el.elementType === 'field' ? '<i class="bi bi-link-45deg"></i>' : el.elementType === 'divider' ? '<i class="bi bi-dash-lg"></i>' : el.elementType === 'qr' ? '<i class="bi bi-qr-code"></i>' : el.elementType === 'barcode' ? '<i class="bi bi-upc-scan"></i>' : el.elementType === 'partner_logo' ? '<i class="bi bi-building"></i>' : el.elementType === 'partner_signature' ? '<i class="bi bi-vector-pen"></i>' : el.elementType === 'instructor_signature' ? '<i class="bi bi-person-check"></i>' : '<i class="bi bi-type"></i>';
            row.innerHTML =
                '<i class="bi bi-grip-vertical ly-grip" aria-hidden="true"></i>' +
                '<div class="ly-icon">' + icon + '</div>' +
                '<div class="ly-name"></div>' +
                (el.groupId ? '<i class="bi bi-bounding-box-circles ly-group" title="ضمن مجموعة" aria-hidden="true"></i>' : '') +
                '<button type="button" class="ly-btn ly-lock' + (el.isLocked ? ' on' : '') + '" title="قفل/فتح"><i class="bi ' + (el.isLocked ? 'bi-lock-fill' : 'bi-unlock') + '"></i></button>' +
                '<button type="button" class="ly-btn ly-eye' + (el.isVisible ? '' : ' off') + '" title="إظهار/إخفاء"><i class="bi ' + (el.isVisible ? 'bi-eye' : 'bi-eye-slash') + '"></i></button>' +
                '<button type="button" class="ly-btn danger" title="حذف"><i class="bi bi-x-lg"></i></button>';
            // Assign as text: the label is derived from user-editable element content.
            row.querySelector('.ly-name').textContent = labelFor(el);
            // Double-click renames a plain text element in place (Figma: Enter/double-click to rename).
            row.querySelector('.ly-name').addEventListener('dblclick', e => {
                e.stopPropagation();
                if (el.elementType !== 'text') return;
                beginRename(row, i, el);
            });
            row.addEventListener('click', e => {
                e.stopPropagation();
                if (e.target.closest('.ly-lock')) {
                    pushHistory();
                    el.isLocked = !el.isLocked;
                    if (el.isLocked) {
                        // A locked element must not stay selected, or a stray drag would still move it.
                        selection = selection.filter(idx => idx !== i);
                        if (selected === i) selected = selection.length ? selection[selection.length - 1] : -1;
                    }
                    render(); renderSelection(); updateToolbarState();
                } else if (e.target.closest('.ly-eye')) {
                    pushHistory();
                    el.isVisible = !el.isVisible;
                    render(); refreshLayers(); updateToolbarState();
                } else if (e.target.closest('.ly-btn.danger')) { select(i); deleteSelected(); }
                else select(i, e.shiftKey);
            });
            row.addEventListener('dragstart', e => {
                layerDragFrom = i;
                e.dataTransfer.effectAllowed = 'move';
                try { e.dataTransfer.setData('text/plain', String(i)); } catch (_) { }
            });
            row.addEventListener('dragover', e => {
                if (layerDragFrom < 0) return;
                e.preventDefault();
                row.classList.add('drop-target');
            });
            row.addEventListener('dragleave', () => row.classList.remove('drop-target'));
            row.addEventListener('drop', e => {
                e.preventDefault();
                row.classList.remove('drop-target');
                if (layerDragFrom < 0 || layerDragFrom === i) return;
                pushHistory();
                const moved = elements.splice(layerDragFrom, 1)[0];
                elements.splice(i, 0, moved);
                layerDragFrom = -1;
                normalizeZ();
                render();
                select(elements.indexOf(moved));
                refreshLayers();
                refreshPropsPanel();
                updateToolbarState();
            });
            row.addEventListener('dragend', () => {
                layerDragFrom = -1;
                list.querySelectorAll('.drop-target').forEach(n => n.classList.remove('drop-target'));
            });
            list.appendChild(row);
        }
    }

    function beginRename(row, index, el) {
        const nameEl = row.querySelector('.ly-name');
        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'ly-rename';
        input.maxLength = 1000;
        input.value = el.content || '';
        nameEl.replaceWith(input);
        input.focus();
        input.select();
        let done = false;
        const commit = apply => {
            if (done) return;
            done = true;
            if (apply) {
                pushHistory();
                el.content = input.value;
                updateNode(el, index);
                refreshPropsPanel();
            }
            refreshLayers();
        };
        input.addEventListener('keydown', e => {
            e.stopPropagation();
            if (e.key === 'Enter') commit(true);
            if (e.key === 'Escape') commit(false);
        });
        input.addEventListener('blur', () => commit(true));
        input.addEventListener('click', e => e.stopPropagation());
        input.addEventListener('dblclick', e => e.stopPropagation());
    }

    // ---------- Inline text editing ----------
    // Double-clicking a text element on the canvas edits it in place, the way a designer expects,
    // instead of forcing a trip to the properties panel.
    let inlineEditIndex = -1;
    function beginInlineEdit(index) {
        const el = elements[index];
        if (!el || el.elementType !== 'text' || el.isLocked || previewMode) return;
        inlineEditIndex = index;
        const s = styleFor(el);
        Object.assign(inlineEditWrap.style, {
            left: el.x + 'px',
            top: el.y + 'px',
            width: el.width + 'px',
            height: (el.elementType === 'divider' ? 4 : el.height) + 'px',
            transform: 'rotate(' + (el.rotation || 0) + 'deg)',
            transformOrigin: 'center',
            zIndex: 10001
        });
        Object.assign(inlineEdit.style, {
            fontSize: s.fontSize,
            color: s.color,
            fontFamily: s.fontFamily,
            fontWeight: s.fontWeight,
            textAlign: el.textAlign || 'center'
        });
        inlineEdit.value = el.content || '';
        inlineEditWrap.style.display = 'block';
        inlineEdit.focus();
        inlineEdit.select();
    }
    function commitInlineEdit(apply) {
        if (inlineEditIndex < 0) return;
        const el = elements[inlineEditIndex];
        const index = inlineEditIndex;
        inlineEditIndex = -1;
        inlineEditWrap.style.display = 'none';
        if (apply && el && inlineEdit.value !== el.content) {
            pushHistory();
            el.content = inlineEdit.value;
            updateNode(el, index);
            refreshLayers();
            refreshPropsPanel();
        }
        inlineEdit.blur();
    }
    inlineEdit.addEventListener('keydown', e => {
        e.stopPropagation();
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); commitInlineEdit(true); }
        if (e.key === 'Escape') { e.preventDefault(); commitInlineEdit(false); }
    });
    inlineEdit.addEventListener('blur', () => { if (inlineEditIndex >= 0) commitInlineEdit(true); });

    // ---------- Properties Panel ----------
    function refreshPropsPanel() {
        const el = elements[selected];
        $('canvasProps').classList.toggle('d-none', !!el);
        $('elementProps').classList.toggle('d-none', !el);
        $('propsTitle').innerHTML = el
            ? '<i class="bi bi-bounding-box"></i> خصائص العنصر'
            : '<i class="bi bi-sliders2"></i> إعدادات القالب';
        syncCanvasInputs();
        if (!el) return;
        $('elTypeBadge').textContent = el.elementType === 'field' ? 'بيان ديناميكي' : el.elementType === 'divider' ? 'فاصل بصري' : el.elementType === 'qr' ? 'رمز QR' : el.elementType === 'barcode' ? 'باركود' : el.elementType === 'partner_logo' ? 'شعار الشريك' : el.elementType === 'partner_signature' ? 'توقيع الشريك' : el.elementType === 'instructor_signature' ? 'توقيع المدرب' : 'نص ثابت';
        $('elIndexLabel').textContent = 'العنصر #' + (selected + 1) + ' من ' + elements.length;
        $('contentWrap').classList.toggle('d-none', el.elementType !== 'text');
        $('fieldWrap').classList.toggle('d-none', el.elementType !== 'field');
        $('barcodeWrap').classList.toggle('d-none', el.elementType !== 'barcode');
        $('partnerSlotWrap').classList.toggle('d-none', !isPartnerSlot(el.elementType));
        if (isPartnerSlot(el.elementType)) buildPartnerSlotOptions(el);
        if (el.elementType === 'text') $('selectedContent').value = el.content || '';
        if (el.elementType === 'field') $('selectedFieldKey').value = el.fieldKey || 'trainee_name';
        if (el.elementType === 'barcode') $('selectedBarcodeSource').value = el.fieldKey || 'certificate_number';
        $('selectedFontFamily').value = el.fontFamily || 'Tajawal';
        $('fontFamilyLabel').textContent = el.fontFamily || 'Tajawal';
        $('selectedFontSize').value = el.fontSize;
        $('selectedWeight').value = el.fontWeight || '600';
        $('selectedColor').value = el.fontColor || '#172033';
        $('selectedColorHex').textContent = (el.fontColor || '#172033').toLowerCase();
        document.querySelectorAll('#alignSeg button').forEach(b => b.classList.toggle('on', b.dataset.align === (el.textAlign || 'center')));
        $('selectedRotation').value = el.rotation || 0;
        $('rotationLabel').textContent = (el.rotation || 0) + '°';
        $('selectedOpacity').value = el.opacity === undefined ? 100 : el.opacity;
        $('opacityLabel').textContent = (el.opacity === undefined ? 100 : el.opacity) + '%';
        $('italicBtn').classList.toggle('on', !!el.isItalic);
        $('underlineBtn').classList.toggle('on', !!el.isUnderline);
        const lh = (el.lineHeight === undefined || el.lineHeight <= 0) ? 130 : el.lineHeight;
        $('selectedLineHeight').value = lh;
        $('lineHeightLabel').textContent = lh + '%';
        const ls = el.letterSpacing || 0;
        $('selectedLetterSpacing').value = ls;
        $('letterSpacingLabel').textContent = ls + 'px';
        $('selectedLocked').checked = !!el.isLocked;
        $('selectedX').value = el.x; $('selectedY').value = el.y;
        $('selectedWidth').value = el.width; $('selectedHeight').value = el.height;
        $('selectedVisible').checked = el.isVisible !== false;
    }

    function buildPartnerSlotOptions(el) {
        const select = $('selectedPartnerSlot');
        // Slots are numbered per element type, so a logo can only target a logo slot and a
        // signature a signature slot.
        const count = Math.max(1, elements.filter(e => e.elementType === el.elementType).length);
        const current = slotOf(el);
        select.replaceChildren();
        for (let i = 0; i < count; i++) {
            const opt = document.createElement('option');
            opt.value = String(i);
            opt.textContent = 'الجهة الداعمة #' + (i + 1);
            select.appendChild(opt);
        }
        // Keep the element's own slot selectable even when it is beyond the current count.
        if (current >= count) {
            const opt = document.createElement('option');
            opt.value = String(current);
            opt.textContent = 'الجهة الداعمة #' + (current + 1);
            select.appendChild(opt);
        }
        select.value = String(current);
    }

    function syncCanvasInputs() {
        $('canvasWidthInput').value = canvasW;
        $('canvasHeightInput').value = canvasH;
        $('sizeLabel').textContent = canvasW + ' × ' + canvasH;
        document.querySelectorAll('#sizePresets button').forEach(b => b.classList.toggle('on', Number(b.dataset.w) === canvasW && Number(b.dataset.h) === canvasH));
        $('backgroundColor').value = cProps.backgroundColor;
        $('backgroundColorHex').textContent = cProps.backgroundColor.toLowerCase();
        $('borderColor').value = cProps.borderColor;
        $('borderColorHex').textContent = cProps.borderColor.toLowerCase();
        $('borderWidth').value = cProps.borderWidth;
        $('borderRadius').value = cProps.borderRadius;
        syncBackgroundPreview();
    }

    function syncBackgroundPreview() {
        const wrap = $('backgroundPreviewWrap');
        const img = $('backgroundPreview');
        if (backgroundImageUrl) {
            img.src = backgroundImageUrl;
            wrap.style.display = 'block';
        } else {
            img.removeAttribute('src');
            wrap.style.display = 'none';
        }
    }

    function updateSelected(prop, value, commit) {
        const el = elements[selected];
        if (!el) return;
        if (['fontSize', 'x', 'y', 'width', 'height'].includes(prop)) value = Number(value) || 0;
        el[prop] = value;
        if (prop === 'x') el.x = clamp(el.x, 0, canvasW - 20);
        if (prop === 'y') el.y = clamp(el.y, 0, canvasH - 20);
        if (prop === 'width') el.width = clamp(el.width, 20, canvasW);
        if (prop === 'height') el.height = clamp(el.height, 20, canvasH);
        if (prop === 'fontSize') el.fontSize = clamp(el.fontSize, 8, 96);
        if (prop === 'rotation') el.rotation = clamp(el.rotation, -180, 180);
        if (prop === 'opacity') el.opacity = clamp(el.opacity, 10, 100);
        if (prop === 'lineHeight') el.lineHeight = clamp(el.lineHeight, 80, 300);
        if (prop === 'letterSpacing') el.letterSpacing = clamp(el.letterSpacing, -10, 40);
        if (el.elementType === 'divider') el.height = 4;
        updateNode(el, selected);
        refreshLayers();
        if (commit) pushHistory();
    }

    // ---------- Canvas props ----------
    function updateCanvasProp(prop, value, commit) {
        cProps[prop] = value;
        render();
        syncCanvasInputs();
        if (commit) pushHistory();
    }

    // ---------- Preview / Zoom ----------
    function setPreview(on) {
        previewMode = on;
        if (on) { hideContextMenu(); closeCommandPalette(); hideShortcuts(); commitInlineEdit(false); }
        document.getElementById('pedApp').classList.toggle('preview-mode', on);
        document.getElementById('previewToggle').innerHTML = on
            ? '<i class="bi bi-pencil-square"></i><span class="txt">تعديل</span>'
            : '<i class="bi bi-eye"></i><span class="txt">معاينة</span>';
        render();
    }
    function applyZoom(z) {
        zoom = clamp(z, 0.25, 2);
        render();
    }

    // ---------- Save ----------
    function submitForm(publish) {
        ['hfCanvasWidth', 'hfCanvasHeight', 'hfBackgroundColor', 'hfBorderColor', 'hfBorderWidth', 'hfBorderRadius'].forEach(id => {
            const el = $(id);
            if (id === 'hfCanvasWidth') el.value = canvasW;
            if (id === 'hfCanvasHeight') el.value = canvasH;
            if (id === 'hfBackgroundColor') el.value = cProps.backgroundColor;
            if (id === 'hfBorderColor') el.value = cProps.borderColor;
            if (id === 'hfBorderWidth') el.value = cProps.borderWidth;
            if (id === 'hfBorderRadius') el.value = cProps.borderRadius;
        });
        publishInput.value = publish ? 'true' : 'false';
        elementsInput.value = JSON.stringify(elements.map((el, i) => ({ ...el, sortOrder: i })));
        dirty = false;
        form.submit();
    }

    // Warn before the tab is closed or the page is left with unsaved designer changes.
    window.addEventListener('beforeunload', e => {
        if (!dirty) return;
        e.preventDefault();
        e.returnValue = '';
    });

    // ---------- Background image ----------
    $('backgroundImageInput').addEventListener('change', e => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        backgroundImageUrl = URL.createObjectURL(file);
        $('hfRemoveBackground').value = 'false';
        syncBackgroundPreview();
        render();
        pushHistory();
    });
    $('removeBackgroundBtn').addEventListener('click', () => {
        backgroundImageUrl = null;
        $('backgroundImageInput').value = '';
        $('hfRemoveBackground').value = 'true';
        syncBackgroundPreview();
        render();
        pushHistory();
    });

    // ---------- Rulers ----------
    // Ticks are drawn in canvas units but positioned in screen space so they stay put while the
    // stage is scrolled; the selection band mirrors the element's span, like Figma's rulers.
    function renderRulers() {
        document.getElementById('pedApp').classList.toggle('rulers-on', rulersOn);
        if (!rulersOn) return;
        const tick = zoom >= 1.5 ? 20 : zoom >= 0.75 ? 50 : 100;
        const sel = selection.length ? selectionBounds() : null;
        drawRulerAxis(rulerH, 'h', canvasW, tick, sel ? [sel.x, sel.x + sel.width] : null);
        drawRulerAxis(rulerV, 'v', canvasH, tick, sel ? [sel.y, sel.y + sel.height] : null);
    }
    function drawRulerAxis(host, axis, length, tick, selRange) {
        // Measure the stage's on-screen origin relative to the viewport box; this already accounts
        // for scroll and padding, so ticks line up with the canvas at any scroll position.
        const areaRect = areaEl.getBoundingClientRect();
        const stageRect = stageEl.getBoundingClientRect();
        const origin = axis === 'h' ? (stageRect.left - areaRect.left) : (stageRect.top - areaRect.top);
        const span = length * zoom;
        const view = axis === 'h' ? areaEl.clientWidth : areaEl.clientHeight;
        const parts = ['<div class="ped-ruler-band"></div>'];
        for (let v = 0; v <= length; v += tick) {
            const pos = origin + v * zoom;
            if (pos < -40 || pos > view + 40) continue;
            const major = v % (tick * 5) === 0;
            parts.push('<div class="ped-ruler-tick' + (major ? ' major' : '') + '" style="' +
                (axis === 'h' ? 'left:' : 'top:') + pos + 'px"></div>');
            if (major) parts.push('<span class="ped-ruler-num" style="' +
                (axis === 'h' ? 'left:' : 'top:') + (pos + 3) + 'px">' + v + '</span>');
        }
        if (selRange) {
            const a = origin + selRange[0] * zoom;
            const b = origin + selRange[1] * zoom;
            parts.push('<div class="ped-ruler-sel" style="' +
                (axis === 'h' ? 'left:' : 'top:') + a + 'px;' +
                (axis === 'h' ? 'width:' : 'height:') + Math.max(2, b - a) + 'px"></div>');
        }
        // Keep the whole span available so the band reflects the real canvas extent.
        host.style.setProperty('--ped-ruler-span', span + 'px');
        host.innerHTML = parts.join('');
    }

    // ---------- Context menu ----------
    let ctxIndex = -1;
    function showContextMenu(x, y, index) {
        ctxIndex = index;
        if (index >= 0 && selection.indexOf(index) < 0) select(index);
        const el = index >= 0 ? elements[index] : null;
        const items = [];
        if (el) {
            items.push(['cut', 'قص', 'bi-scissors', 'Ctrl+X', false]);
            items.push(['copy', 'نسخ', 'bi-clipboard', 'Ctrl+C', false]);
            items.push(['duplicate', 'تكرار', 'bi-files', 'Ctrl+D', false]);
            items.push(['sep']);
            items.push(['front', 'إلى المقدمة', 'bi-layers', ']', false]);
            items.push(['forward', 'تقديم للأمام', 'bi-arrow-up-short', '', false]);
            items.push(['backward', 'إرجاع للخلف', 'bi-arrow-down-short', '', false]);
            items.push(['back', 'إلى الخلف', 'bi-layers-half', '[', false]);
            items.push(['sep']);
            items.push(['rename', 'إعادة تسمية', 'bi-input-cursor-text', 'F2', el.elementType !== 'text' || el.isLocked]);
            items.push(['lock', el.isLocked ? 'إلغاء القفل' : 'قفل', el.isLocked ? 'bi-unlock' : 'bi-lock', 'Ctrl+L', false]);
            items.push(['hide', el.isVisible ? 'إخفاء' : 'إظهار', el.isVisible ? 'bi-eye-slash' : 'bi-eye', '', false]);
            items.push(['sep']);
            items.push(['delete', 'حذف', 'bi-trash3', 'Del', el.isLocked]);
        }
        if (clipboard.length) items.push(['paste', 'لصق', 'bi-clipboard-plus', 'Ctrl+V', false]);
        if (!items.length) return;
        ctxMenu.innerHTML = items.map(([act, label, icon, kbd, disabled]) => {
            if (act === 'sep') return '<div class="ped-menu-sep"></div>';
            return '<button type="button" class="ped-menu-item' + (disabled ? ' disabled' : '') + '" data-act="' + act + '"' +
                (disabled ? ' disabled' : '') + '><i class="bi ' + icon + '"></i><span>' + label + '</span>' +
                (kbd ? '<span class="ped-kbd">' + kbd + '</span>' : '') + '</button>';
        }).join('');
        ctxMenu.style.display = 'block';
        const rect = areaEl.getBoundingClientRect();
        const w = ctxMenu.offsetWidth, h = ctxMenu.offsetHeight;
        ctxMenu.style.left = Math.min(x - rect.left, rect.width - w - 8) + 'px';
        ctxMenu.style.top = Math.min(y - rect.top, rect.height - h - 8) + 'px';
    }
    function hideContextMenu() { ctxMenu.style.display = 'none'; ctxIndex = -1; }
    function runContextAction(act) {
        const i = ctxIndex;
        hideContextMenu();
        if (act === 'paste') { pasteClipboard(); return; }
        if (i < 0) return;
        const el = elements[i];
        if (act === 'cut') cutSelected();
        else if (act === 'copy') copySelected();
        else if (act === 'duplicate') duplicateSelected();
        else if (act === 'delete') { select(i); deleteSelected(); }
        else if (act === 'rename') { if (el.elementType === 'text' && !el.isLocked) beginInlineEdit(i); }
        else if (act === 'lock') toggleLock(i);
        else if (act === 'hide') toggleVisibility(i);
        else if (act === 'front') toExtreme(true);
        else if (act === 'back') toExtreme(false);
        else if (act === 'forward') moveOrder(1);
        else if (act === 'backward') moveOrder(-1);
    }
    function toggleLock(index) {
        const el = elements[index];
        if (!el) return;
        pushHistory();
        el.isLocked = !el.isLocked;
        if (el.isLocked) {
            selection = selection.filter(idx => idx !== index);
            if (selected === index) selected = selection.length ? selection[selection.length - 1] : -1;
        }
        render(); renderSelection(); updateToolbarState();
    }
    function toggleVisibility(index) {
        const el = elements[index];
        if (!el) return;
        pushHistory();
        el.isVisible = !el.isVisible;
        render(); refreshLayers(); updateToolbarState();

@model CertificateIndexPageViewModel
@{
    ViewData["Title"] = "الشهادات الصادرة";
    ViewData["PageIcon"] = "bi-award";
    ViewData["PageDesc"] = "إدارة بيانات الشهادات وتصدير روابط التحقق الخاصة بالـ QR";
    Layout = "_AdminLayout";
}

<div class="page-header mb-4">
    <partial name="_PageHeader" />
    <div class="page-actions d-flex flex-wrap gap-2 mt-3">
        <a asp-action="Issue" class="btn btn-primary"><i class="bi bi-plus-circle"></i> إصدار شهادات</a>
        <a asp-action="ExportFiltered"
           asp-route-search="@Model.Search"
           asp-route-courseId="@Model.CourseId"
           asp-route-issueFrom="@(Model.IssueFrom?.ToString("yyyy-MM-dd"))"
           asp-route-issueTo="@(Model.IssueTo?.ToString("yyyy-MM-dd"))"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> تصدير النتائج الحالية
        </a>
    </div>
</div>

<div class="card shadow-sm mb-3 border-0">
    <div class="card-body">
        <form method="get" class="a-toolbar" role="search" aria-label="بحث وتصفية الشهادات">
            <div class="a-toolbar__field a-toolbar__field--grow">
                <label class="a-field__label" for="certSearch">بحث</label>
                <div class="a-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="certSearch" type="search" name="search" value="@Model.Search" class="form-control" placeholder="اسم الطالب أو رقم الشهادة أو المعرف العام" />
                </div>
            </div>
            <div class="a-toolbar__field">
                <label class="a-field__label" for="certCourse">الدورة</label>
                <select id="certCourse" name="courseId" class="form-select">
                    <option value="">كل الدورات</option>
                    @foreach (var course in Model.Courses)
                    {
                        if (Model.CourseId == course.CourseId)
                        {
                            <option value="@course.CourseId" selected>@course.CourseName</option>
                        }
                        else
                        {
                            <option value="@course.CourseId">@course.CourseName</option>
                        }
                    }
                </select>
            </div>
            <div class="a-toolbar__field">
                <label class="a-field__label" for="certFrom">تاريخ الإصدار من</label>
                <input id="certFrom" type="date" name="issueFrom" value="@(Model.IssueFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="a-toolbar__field">
                <label class="a-field__label" for="certTo">إلى</label>
                <input id="certTo" type="date" name="issueTo" value="@(Model.IssueTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="a-toolbar__actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary">مسح الفلاتر</a>
            </div>
            <p class="a-toolbar__meta">عدد النتائج: <strong>@Model.Certificates.Count</strong></p>
        </form>
    </div>
</div>

<form asp-action="ExportSelected" method="post" id="selectedExportForm">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h6 class="mb-1">بيانات الشهادات المصدرة</h6>
                <small class="text-muted">يمكن فتح الشهادة الموحدة وطباعتها من داخل النظام، كما يمكن تصدير بيانات الشهادة وروابط التحقق إلى Excel.</small>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-success btn-sm" id="exportSelectedBtn" disabled>
                    <i class="bi bi-file-earmark-excel"></i> تصدير المحدد
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Certificates.Any())
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="selectAllBtn"><i class="bi bi-check2-square"></i> تحديد الكل</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSelectionBtn"><i class="bi bi-square"></i> إلغاء التحديد</button>
                    <span class="small text-muted">المحدد حالياً: <strong id="selectedCount">0</strong></span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px;"><input type="checkbox" id="toggleAllRows" aria-label="تحديد جميع الشهادات الظاهرة" /></th>
                                <th>رقم الشهادة</th>
                                <th>اسم المتدرب</th>
                                <th>الدورة</th>
                                <th>تاريخ الإصدار</th>
                                <th>الحالة</th>
                                <th>رابط QR</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cert in Model.Certificates)
                            {
                                var verificationUrl = Model.VerificationUrls.TryGetValue(cert.CertificateId, out var url) ? url : "#";
                                <tr>
                                    <td>
                                        <input type="checkbox" class="row-checkbox" name="certificateIds" value="@cert.CertificateId" aria-label="تحديد الشهادة @cert.CertificateNumber" />
                                    </td>
                                    <td>
                                        <div><code>@cert.CertificateNumber</code></div>
                                        <div class="small text-muted">@cert.PublicId</div>
                                    </td>
                                    <td>
                                        <strong>@(cert.TraineeNameArabic ?? cert.TraineeName)</strong>
                                        <span class="d-block text-muted small" dir="ltr">@(cert.TraineeNameEnglish ?? cert.TraineeName)</span>
                                    </td>
                                    <td>@cert.CourseName</td>
                                    <td>@cert.IssueDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (cert.Status?.Trim().ToLowerInvariant() == "revoked")
                                        {
                                            <span class="badge text-bg-danger">ملغية</span>
                                        }
                                        else if (cert.Status?.Trim().ToLowerInvariant() == "valid")
                                        {
                                            <span class="badge text-bg-success">سارية</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-warning">غير معروفة</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-2">
                                            @if (!string.IsNullOrWhiteSpace(verificationUrl) && verificationUrl != "#")
                                            {
                                                <a href="@verificationUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" aria-label="فتح رابط التحقق للشهادة @cert.CertificateNumber">
                                                    <i class="bi bi-box-arrow-up-right"></i> فتح الرابط
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary copy-url-btn" data-url="@verificationUrl" aria-label="نسخ رابط التحقق للشهادة @cert.CertificateNumber">
                                                    <i class="bi bi-clipboard"></i> نسخ الرابط
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">الرابط غير متاح</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-award", Title = "لا توجد شهادات مطابقة", Text = "جرّب تعديل البحث أو الفلاتر للعثور على الشهادات المطلوبة." })" />
            }
        </div>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        const toggleAll = document.getElementById('toggleAllRows');
        const checkboxes = Array.from(document.querySelectorAll('.row-checkbox'));
        const selectedCount = document.getElementById('selectedCount');
        const exportBtn = document.getElementById('exportSelectedBtn');
        const selectAllBtn = document.getElementById('selectAllBtn');
        const clearSelectionBtn = document.getElementById('clearSelectionBtn');

        function updateSelectionState() {
            const checked = checkboxes.filter(x => x.checked).length;
            if (selectedCount) selectedCount.textContent = checked;
            if (exportBtn) exportBtn.disabled = checked === 0;
            if (toggleAll) toggleAll.checked = checkboxes.length > 0 && checked === checkboxes.length;
        }

        if (toggleAll) {
            toggleAll.addEventListener('change', function () {
                checkboxes.forEach(cb => cb.checked = toggleAll.checked);
                updateSelectionState();
            });
        }

        checkboxes.forEach(cb => cb.addEventListener('change', updateSelectionState));

        if (selectAllBtn) {
            selectAllBtn.addEventListener('click', function () {
                checkboxes.forEach(cb => cb.checked = true);
                updateSelectionState();
            });
        }

        if (clearSelectionBtn) {
            clearSelectionBtn.addEventListener('click', function () {
                checkboxes.forEach(cb => cb.checked = false);
                updateSelectionState();
            });
        }

        document.querySelectorAll('.copy-url-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const url = btn.getAttribute('data-url') || '';
                if (!url) return;
                try {
                    if (navigator.clipboard && window.isSecureContext) {
                        await navigator.clipboard.writeText(url);
                    } else {
                        const textArea = document.createElement('textarea');
                        textArea.value = url;
                        textArea.style.position = 'fixed';
                        textArea.style.opacity = '0';
                        document.body.appendChild(textArea);
                        textArea.focus();
                        textArea.select();
                        if (!document.execCommand('copy')) throw new Error('copy failed');
                        textArea.remove();
                    }
                    const original = btn.innerHTML;
                    btn.innerHTML = '<i class="bi bi-check2"></i> تم النسخ';
                    setTimeout(() => btn.innerHTML = original, 1500);
                } catch {
                    alert('تعذر نسخ الرابط تلقائياً. يمكنك تحديده ونسخه يدوياً.');
                }
            });
        });

        updateSelectionState();
    })();
</script>
}

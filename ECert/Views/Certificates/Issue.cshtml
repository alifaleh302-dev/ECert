@model CertificateIssuePageViewModel
@{
    ViewData["Title"] = "إصدار الشهادات";
    ViewData["PageIcon"] = "bi-award";
    ViewData["PageDesc"] = "إصدار جماعي للشهادات مع فلاتر الدورة وتاريخ التسجيل";
    Layout = "_AdminLayout";
}

<div class="page-header mb-4">
    <partial name="_PageHeader" />
    <div class="page-actions d-flex flex-wrap gap-2 mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة إلى الشهادات</a>
    </div>
</div>

<div class="alert alert-info border-0 shadow-sm">
    <i class="bi bi-info-circle"></i>
    ستظهر هنا فقط التسجيلات المقبولة في الدورات المكتملة والتي لم تُصدر لها شهادات بعد. يمكنك تحديد عدة متدربين وإصدار الشهادات دفعة واحدة.
</div>

<div class="card shadow-sm mb-3 border-0">
    <div class="card-body">
        <form method="get" class="a-toolbar" role="search" aria-label="تصفية المؤهلين لإصدار الشهادات">
            <div class="a-toolbar__field a-toolbar__field--grow">
                <label class="a-field__label" for="issueCourse">الدورة</label>
                <select id="issueCourse" name="courseId" class="form-select">
                    <option value="">كل الدورات المكتملة</option>
                    @foreach (var course in Model.Courses)
                    {
                        if (Model.CourseId == course.CourseId)
                        {
                            <option value="@course.CourseId" selected>@course.CourseName</option>
                        }
                        else
                        {
                            <option value="@course.CourseId">@course.CourseName</option>
                        }
                    }
                </select>
            </div>
            <div class="a-toolbar__field">
                <label class="a-field__label" for="issueFrom">تاريخ التسجيل من</label>
                <input id="issueFrom" type="date" name="registrationFrom" value="@(Model.RegistrationFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="a-toolbar__field">
                <label class="a-field__label" for="issueTo">إلى</label>
                <input id="issueTo" type="date" name="registrationTo" value="@(Model.RegistrationTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="a-toolbar__actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i> تطبيق</button>
                <a asp-action="Issue" class="btn btn-outline-secondary">مسح الفلاتر</a>
            </div>
            <p class="a-toolbar__meta">عدد المؤهلين حالياً: <strong>@Model.EligibleRegistrations.Count</strong></p>
        </form>
    </div>
</div>

<form asp-action="IssueBulk" method="post" id="bulkIssueForm">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h6 class="mb-1">المتدربون المؤهلون للحصول على شهادة</h6>
                <small class="text-muted">حدد المتدربين المؤهلين لإصدار الشهادات ثم استخدم تصدير البيانات عند الحاجة.</small>
            </div>
            <button type="button" class="btn btn-success" id="issueSelectedBtn" disabled>
                <i class="bi bi-award"></i> إصدار الشهادات للمحدد
            </button>
        </div>
        <div class="card-body">
            @if (Model.EligibleRegistrations.Any())
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="selectAllBtn"><i class="bi bi-check2-square"></i> تحديد الكل</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSelectionBtn"><i class="bi bi-square"></i> إلغاء التحديد</button>
                    <span class="small text-muted">العناصر المحددة: <strong id="selectedCount">0</strong></span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px;"><input type="checkbox" id="toggleAllRows" /></th>
                                <th>رقم الطلب</th>
                                <th>اسم المتدرب</th>
                                <th>الدورة</th>
                                <th>تاريخ التسجيل</th>
                                <th>تاريخ القبول</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model.EligibleRegistrations)
                            {
                                <tr>
                                    <td><input type="checkbox" class="row-checkbox" name="registrationIds" value="@reg.RegistrationId" /></td>
                                    <td><code>@reg.RequestNumber</code></td>
                                    <td><strong>@(reg.FullNameArabic ?? reg.FullName)</strong><span class="d-block text-muted small" dir="ltr">@(reg.FullNameEnglish ?? reg.FullName)</span></td>
                                    <td>@reg.Course?.CourseName</td>
                                    <td>@reg.RegistrationDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(reg.AcceptedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-award" style="font-size:3rem"></i>
                    <p class="mt-3 mb-0">لا يوجد متدربون مؤهلون حسب الفلاتر الحالية.</p>
                </div>
            }
        </div>
    </div>

    <div class="modal fade" id="issueCertificatesModal" tabindex="-1" aria-labelledby="issueCertificatesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="issueCertificatesModalLabel"><i class="bi bi-award text-success"></i> تأكيد إصدار الشهادات</h5>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">ستصدر <strong id="issueModalCount">0</strong> شهادة. اختر بادئة موحدة لهذه الدفعة لتسهيل تمييزها والبحث عنها لاحقاً.</p>
                    <label for="certificatePrefix" class="form-label">بادئة رقم الشهادة <span class="text-danger">*</span></label>
                    <input type="text" class="form-control text-uppercase" id="certificatePrefix" name="certificatePrefix" required maxlength="12" autocomplete="off" spellcheck="false" dir="auto" aria-describedby="certificatePrefixHelp" placeholder="مثال: PTM" />
                    <div id="certificatePrefixHelp" class="form-text">من 2 إلى 12 حرفاً أو رقماً، ويمكن استخدام الشرطة بين الأجزاء. لا تبدأ أو تنهِ البادئة بشرطة.</div>
                    <div class="alert alert-light border mt-3 mb-0 small" role="status">
                        <div class="text-muted mb-1">معاينة رقم الشهادة</div>
                        <code id="certificateNumberPreview">أدخل البادئة للمعاينة</code>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> إصدار الشهادات</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    (function () {
        const toggleAll = document.getElementById('toggleAllRows');
        const checkboxes = Array.from(document.querySelectorAll('.row-checkbox'));
        const selectedCount = document.getElementById('selectedCount');
        const issueBtn = document.getElementById('issueSelectedBtn');
        const selectAllBtn = document.getElementById('selectAllBtn');
        const clearSelectionBtn = document.getElementById('clearSelectionBtn');
        const form = document.getElementById('bulkIssueForm');
        const issueModalElement = document.getElementById('issueCertificatesModal');
        const prefixInput = document.getElementById('certificatePrefix');
        const prefixPreview = document.getElementById('certificateNumberPreview');
        const issueModalCount = document.getElementById('issueModalCount');
        const issueModal = issueModalElement && window.bootstrap ? new bootstrap.Modal(issueModalElement) : null;
        const prefixPattern = /^[\p{L}\p{N}]+(?:-[\p{L}\p{N}]+)*$/u;

        function updatePrefixPreview() {
            if (!prefixInput || !prefixPreview) return;

            const prefix = prefixInput.value.trim().toUpperCase();
            const valid = prefix.length >= 2 && prefix.length <= 12 && prefixPattern.test(prefix);
            prefixInput.setCustomValidity(prefix.length > 0 && !valid ? 'أدخل بادئة من 2 إلى 12 حرفاً أو رقماً، مع استخدام الشرطة بين الأجزاء فقط.' : '');
            prefixPreview.textContent = valid
                ? `${prefix}-${new Date().getUTCFullYear()}-XXXXXXXXXX`
                : 'أدخل بادئة صالحة للمعاينة';
        }

        function openIssueModal() {
            const checked = checkboxes.filter(x => x.checked).length;
            if (checked === 0) return;

            if (issueModalCount) issueModalCount.textContent = checked;
            updatePrefixPreview();

            if (issueModal) {
                issueModal.show();
                window.setTimeout(() => prefixInput?.focus(), 200);
            } else {
                form?.requestSubmit();
            }
        }

        function updateSelectionState() {
            const checked = checkboxes.filter(x => x.checked).length;
            if (selectedCount) selectedCount.textContent = checked;
            if (issueBtn) issueBtn.disabled = checked === 0;
            if (toggleAll) toggleAll.checked = checkboxes.length > 0 && checked === checkboxes.length;
        }

        if (toggleAll) {
            toggleAll.addEventListener('change', function () {
                checkboxes.forEach(cb => cb.checked = toggleAll.checked);
                updateSelectionState();
            });
        }

        checkboxes.forEach(cb => cb.addEventListener('change', updateSelectionState));

        if (selectAllBtn) {
            selectAllBtn.addEventListener('click', function () {
                checkboxes.forEach(cb => cb.checked = true);
                updateSelectionState();
            });
        }

        if (clearSelectionBtn) {
            clearSelectionBtn.addEventListener('click', function () {
                checkboxes.forEach(cb => cb.checked = false);
                updateSelectionState();
            });
        }

        if (issueBtn) issueBtn.addEventListener('click', openIssueModal);
        if (prefixInput) prefixInput.addEventListener('input', updatePrefixPreview);

        if (form) {
            form.addEventListener('submit', function (event) {
                const checked = checkboxes.filter(x => x.checked).length;
                if (checked === 0) {
                    event.preventDefault();
                    return;
                }

                updatePrefixPreview();
                if (!prefixInput || !prefixInput.value.trim() || !prefixInput.checkValidity()) {
                    event.preventDefault();
                    prefixInput?.reportValidity();
                }
            });
        }

        updateSelectionState();
    })();
</script>
}

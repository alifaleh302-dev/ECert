@using System.Globalization
@model ECert.Models.ViewModels.PublicCertificateVerificationViewModel

@{
    ViewData["Title"] = "نتيجة التحقق";
    var state = Model.IsValid ? "ok" : Model.CertificateFound ? "warn" : "bad";
    var iconClass = Model.IsValid ? "bi-patch-check-fill" : Model.CertificateFound ? "bi-exclamation-triangle-fill" : "bi-x-circle-fill";
    var statusTitle = Model.IsValid
        ? "شهادة سارية وموثّقة"
        : Model.CertificateFound
            ? "الشهادة غير قابلة للاعتماد"
            : "تعذّر العثور على الشهادة";
    var statusDesc = Model.CertificateFound
        ? Model.Message
        : "تأكد من كتابة رقم الشهادة أو رمز التحقق بشكل صحيح، ثم أعد المحاولة.";

    string Percentage(int value, int total)
        => $"{(value * 100d / Math.Max(total, 1)).ToString("0.###", CultureInfo.InvariantCulture)}%";

    string FontSize(int value)
        => $"{(value * 100d / Math.Max(Model.DesignCanvasWidth, 1)).ToString("0.###", CultureInfo.InvariantCulture)}cqw";

    var siteName = (ViewBag.SiteSettings as List<ECert.Models.SiteSetting>)
        ?.FirstOrDefault(s => s.Key == "SiteName")?.Value;
    if (string.IsNullOrWhiteSpace(siteName)) siteName = "مركز التدريب";
}

@section Styles {
    <link href="~/css/certificate-verify.css" rel="stylesheet" asp-append-version="true" />
}

<div class="cv-report">
    <header class="cv-report__head">
        <div class="cv-report__brand">
            <span class="cv-report__seal" aria-hidden="true"><i class="bi bi-patch-check-fill"></i></span>
            <div>
                <p class="cv-report__authority">@siteName</p>
                <h1 class="cv-report__title">تقرير التحقق من الشهادة</h1>
                <p class="cv-report__sub">Certificate Verification Report</p>
            </div>
        </div>
        <a asp-action="Verify" class="cv-report__back"><i class="bi bi-arrow-right"></i> تحقق من شهادة أخرى</a>
    </header>

    @if (Model.CertificateFound && Model.HasPublishedDesign)
    {
        <section class="cv-verdict cv-verdict--@state" aria-live="polite">
            <span class="cv-verdict__seal"><i class="bi @iconClass" aria-hidden="true"></i></span>
            <div class="cv-verdict__body">
                <p class="cv-verdict__label">حالة التحقق</p>
                <p class="cv-verdict__title">@statusTitle</p>
                <p class="cv-verdict__desc">@statusDesc</p>
                <ul class="cv-verdict__facts">
                    <li><i class="bi bi-hash" aria-hidden="true"></i><span>رقم الشهادة:</span><strong class="cv-code">@Model.CertificateNumber</strong></li>
                    <li><i class="bi bi-calendar3" aria-hidden="true"></i><span>تاريخ الإصدار:</span><strong>@Model.IssueDate?.ToString("yyyy-MM-dd")</strong></li>
                    <li><i class="bi bi-patch-check" aria-hidden="true"></i><span>الحالة:</span><strong>@Model.Status</strong></li>
                </ul>
            </div>
        </section>

        <section class="cv-doc" aria-label="الشهادة الرقمية للمتدرب">
            <div class="cv-doc__frame">
                <div class="cv-paper"
                     style="--certificate-ratio: @Model.DesignCanvasWidth / @Model.DesignCanvasHeight; background-color: @Model.DesignBackgroundColor; border: @Model.DesignBorderWidth.ToString(CultureInfo.InvariantCulture)px solid @Model.DesignBorderColor; border-radius: @Model.DesignBorderRadius.ToString(CultureInfo.InvariantCulture)px;">
                    @if (!string.IsNullOrWhiteSpace(Model.DesignBackgroundImageUrl))
                    {
                        <img class="cv-paper__bg" src="@SafeUrl.ForAttribute(Model.DesignBackgroundImageUrl, "#")" alt="" aria-hidden="true" />
                    }
                    @foreach (var element in Model.DesignElements)
                    {
                        var isDivider = string.Equals(element.ElementType, "divider", StringComparison.OrdinalIgnoreCase);
                        var isQr = string.Equals(element.ElementType, "qr", StringComparison.OrdinalIgnoreCase);
                        var isBarcode = string.Equals(element.ElementType, "barcode", StringComparison.OrdinalIgnoreCase);
                        var isPartnerLogo = string.Equals(element.ElementType, "partner_logo", StringComparison.OrdinalIgnoreCase);
                        var isPartnerSignature = string.Equals(element.ElementType, "partner_signature", StringComparison.OrdinalIgnoreCase);
                        var isInstructorSignature = string.Equals(element.ElementType, "instructor_signature", StringComparison.OrdinalIgnoreCase);
                        var isSignature = isPartnerSignature || isInstructorSignature;
                        // Artwork elements render nothing when the course has nothing to place.
                        if ((isPartnerLogo || isSignature) && string.IsNullOrWhiteSpace(element.ImageSrc))
                        {
                            continue;
                        }
                        var isImage = isQr || isBarcode || isPartnerLogo || isSignature;
                        var imageAlt = isQr ? "رمز التحقق (QR)" : isBarcode ? "باركود الشهادة" : isPartnerLogo ? "شعار الجهة الداعمة" : isPartnerSignature ? "توقيع الجهة الداعمة" : "توقيع المدرب";
                        // QR/barcode pixels are generated server-side (data: URIs), so they bypass the
                        // URL guard; logo and signature paths are admin-supplied and must be sanitised.
                        var imageSrc = isQr || isBarcode ? element.ImageSrc : SafeUrl.ForAttribute(element.ImageSrc, "#");
                        var style = $"left:{Percentage(element.X, Model.DesignCanvasWidth)};top:{Percentage(element.Y, Model.DesignCanvasHeight)};width:{Percentage(element.Width, Model.DesignCanvasWidth)};height:{Percentage(element.Height, Model.DesignCanvasHeight)};z-index:{element.ZIndex};color:{element.FontColor};font-family:'{element.FontFamily}',sans-serif;font-size:{FontSize(element.FontSize)};font-weight:{element.FontWeight};text-align:{element.TextAlign};justify-content:{(element.TextAlign == "right" ? "flex-start" : element.TextAlign == "left" ? "flex-end" : "center")};transform:rotate({element.Rotation}deg);transform-origin:center;";
                        <div class="cv-el @(isDivider ? "cv-el--divider" : string.Empty)" style="@style">
                            @if (isImage)
                            {
                                <img src="@imageSrc" alt="@imageAlt" style="width:100%;height:100%;object-fit:contain;" />
                            }
                            else if (!isDivider)
                            {
                                @element.Content
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="cv-doc__caption">
                <span><span class="cv-dot cv-dot--@state"></span> حالة الشهادة: <strong>@Model.Status</strong></span>
                <span><i class="bi bi-shield-check"></i> وثيقة صادرة عن الجهة المصدرة، وتُعرض هنا بغرض التحقق.</span>
            </div>
        </section>

        <section class="cv-record" aria-label="بيانات الشهادة">
            <h2 class="cv-record__title"><i class="bi bi-card-text"></i> بيانات الشهادة الرسمية</h2>
            <dl class="cv-record__grid">
                <div class="cv-record__row">
                    <dt>رقم الشهادة</dt>
                    <dd class="cv-code">@Model.CertificateNumber</dd>
                </div>
                <div class="cv-record__row">
                    <dt>الحالة</dt>
                    <dd>@Model.Status</dd>
                </div>
                <div class="cv-record__row">
                    <dt>اسم المتدرب</dt>
                    <dd>@(Model.TraineeNameArabic ?? Model.TraineeName)</dd>
                </div>
                <div class="cv-record__row">
                    <dt>الاسم بالإنجليزية</dt>
                    <dd dir="ltr">@(Model.TraineeNameEnglish ?? Model.TraineeName)</dd>
                </div>
                <div class="cv-record__row">
                    <dt>الدورة التدريبية</dt>
                    <dd>@Model.CourseNameArabic<span class="cv-sub" dir="ltr">@Model.CourseNameEnglish</span></dd>
                </div>
                <div class="cv-record__row">
                    <dt>تاريخ الإصدار</dt>
                    <dd>@Model.IssueDate?.ToString("yyyy-MM-dd")</dd>
                </div>
            </dl>
        </section>

        <div class="cv-report__actions">
            <button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة الشهادة</button>
            <a asp-action="Verify" class="btn btn-primary"><i class="bi bi-search"></i> تحقق من شهادة أخرى</a>
        </div>

        <p class="cv-report__note">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>
                هذه النتيجة صادرة آلياً عن السجل الرسمي لـ @siteName وتعكس حالة الشهادة لحظة الاستعلام
                (@DateTime.Now.ToString("yyyy-MM-dd HH:mm")). للتحقق من صحة الوثيقة المطبوعة يُرجى
                مطابقة رقم الشهادة وبيانات المتدرب والدورة الظاهرة أعلاه.
            </span>
        </p>
    }
    else
    {
        <div class="cv-notfound">
            <div class="cv-notfound__mark cv-notfound__mark--@state" aria-hidden="true"><i class="bi @iconClass"></i></div>
            <h2 class="cv-notfound__title">@statusTitle</h2>
            <p class="cv-notfound__text">@statusDesc</p>

            @if (Model.CertificateFound)
            {
                <div class="cv-record">
                    <h2 class="cv-record__title"><i class="bi bi-card-text"></i> بيانات الشهادة</h2>
                    <dl class="cv-record__grid">
                        <div class="cv-record__row">
                            <dt>رقم الشهادة</dt>
                            <dd class="cv-code">@Model.CertificateNumber</dd>
                        </div>
                        <div class="cv-record__row">
                            <dt>الحالة</dt>
                            <dd>@Model.Status</dd>
                        </div>
                        <div class="cv-record__row">
                            <dt>اسم المتدرب</dt>
                            <dd>@(Model.TraineeNameArabic ?? Model.TraineeName)</dd>
                        </div>
                        <div class="cv-record__row">
                            <dt>الدورة التدريبية</dt>
                            <dd>@Model.CourseNameArabic<span class="cv-sub" dir="ltr">@Model.CourseNameEnglish</span></dd>
                        </div>
                    </dl>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.SearchCode))
            {
                <p class="cv-notfound__entered">المدخل الذي تم التحقق منه: <span class="cv-code">@Model.SearchCode</span></p>
            }

            <div class="cv-report__actions">
                <a asp-action="Verify" class="btn btn-primary"><i class="bi bi-search"></i> تحقق من شهادة أخرى</a>
            </div>
        </div>
    }
</div>

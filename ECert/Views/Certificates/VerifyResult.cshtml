@using System.Globalization
@model ECert.Models.ViewModels.PublicCertificateVerificationViewModel

@{
    ViewData["Title"] = "نتيجة التحقق";
    var headingClass = Model.IsValid ? "text-success" : Model.CertificateFound ? "text-warning" : "text-danger";
    var iconClass = Model.IsValid ? "bi-check-circle-fill" : Model.CertificateFound ? "bi-exclamation-triangle-fill" : "bi-x-circle-fill";
    var statusClass = Model.IsValid ? "text-bg-success" : Model.CertificateFound ? "text-bg-warning" : "text-bg-danger";

    string Percentage(int value, int total)
        => $"{(value * 100d / Math.Max(total, 1)).ToString("0.###", CultureInfo.InvariantCulture)}%";

    string FontSize(int value)
        => $"{(value * 100d / Math.Max(Model.DesignCanvasWidth, 1)).ToString("0.###", CultureInfo.InvariantCulture)}cqw";
}

<style>
    .verify-shell { max-width: 1180px; margin-inline: auto; }
    .verify-status { border-radius: 18px; border: 1px solid rgba(15, 23, 42, .08); box-shadow: 0 10px 28px rgba(15, 23, 42, .06); }
    .certificate-viewport { overflow: hidden; border-radius: 18px; background: #e8edf4; padding: clamp(.55rem, 1.2vw, 1rem); box-shadow: 0 18px 44px rgba(15, 23, 42, .15); }
    .certificate-design { position: relative; width: 100%; aspect-ratio: var(--certificate-ratio); container-type: inline-size; overflow: hidden; isolation: isolate; box-shadow: 0 3px 14px rgba(15, 23, 42, .14); }
    .certificate-design__element { position: absolute; display: flex; align-items: center; overflow-wrap: anywhere; white-space: pre-wrap; line-height: 1.35; }
    .certificate-design__element--divider { border-top: max(1px, .16cqw) solid currentColor; height: 0 !important; align-items: unset; }
    .certificate-design__watermark { position: absolute; inset: auto 2.8% 3% auto; z-index: 50; display: inline-flex; align-items: center; gap: .35rem; padding: .3rem .55rem; border-radius: 999px; font-size: clamp(.62rem, 1.6cqw, .82rem); font-weight: 700; color: #166534; background: rgba(240, 253, 244, .88); border: 1px solid rgba(22, 101, 52, .24); backdrop-filter: blur(4px); }
    .certificate-design__watermark.is-not-valid { color: #9a3412; background: rgba(255, 247, 237, .9); border-color: rgba(154, 52, 18, .24); }
    .certificate-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; }
    .certificate-fallback { max-width: 680px; margin-inline: auto; }
    @@media (max-width: 575.98px) {
        .verify-shell { padding-inline: .15rem; }
        .verify-status .card-body { padding: 1rem !important; }
        .certificate-viewport { border-radius: 13px; padding: .42rem; }
        .certificate-actions .btn { flex: 1 1 auto; }
    }
    @@media print {
        .site-header, .site-footer, .verify-status, .certificate-actions, .verify-back { display: none !important; }
        .certificate-viewport { padding: 0; overflow: visible; box-shadow: none; background: transparent; }
        .certificate-design { box-shadow: none; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
        .certificate-design__watermark { display: none; }
    }
</style>

<div class="verify-shell py-4 py-md-5">
    @if (Model.CertificateFound && Model.HasPublishedDesign)
    {
        <section class="verify-status card border-0 mb-3" aria-live="polite">
            <div class="card-body py-3 px-3 px-md-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi @iconClass @headingClass fs-4" aria-hidden="true"></i>
                    <div>
                        <strong class="@headingClass">@(Model.IsValid ? "شهادة موثّقة" : "تنبيه حول حالة الشهادة")</strong>
                        <span class="text-muted d-block d-sm-inline ms-sm-2 small">@Model.Message</span>
                    </div>
                </div>
                <span class="badge @statusClass align-self-start align-self-md-auto">@Model.Status</span>
            </div>
        </section>

        <section class="certificate-viewport" aria-label="الشهادة الرقمية للمتدرب">
            <div class="certificate-design"
                 style="--certificate-ratio: @Model.DesignCanvasWidth / @Model.DesignCanvasHeight; background-color: @Model.DesignBackgroundColor; border: @Model.DesignBorderWidth.ToString(CultureInfo.InvariantCulture)px solid @Model.DesignBorderColor; border-radius: @Model.DesignBorderRadius.ToString(CultureInfo.InvariantCulture)px;">
                @foreach (var element in Model.DesignElements)
                {
                    var isDivider = string.Equals(element.ElementType, "divider", StringComparison.OrdinalIgnoreCase);
                    var isQr = string.Equals(element.ElementType, "qr", StringComparison.OrdinalIgnoreCase);
                    var style = $"left:{Percentage(element.X, Model.DesignCanvasWidth)};top:{Percentage(element.Y, Model.DesignCanvasHeight)};width:{Percentage(element.Width, Model.DesignCanvasWidth)};height:{Percentage(element.Height, Model.DesignCanvasHeight)};z-index:{element.ZIndex};color:{element.FontColor};font-family:'{element.FontFamily}',sans-serif;font-size:{FontSize(element.FontSize)};font-weight:{element.FontWeight};text-align:{element.TextAlign};justify-content:{(element.TextAlign == "right" ? "flex-start" : element.TextAlign == "left" ? "flex-end" : "center")};transform:rotate({element.Rotation}deg);transform-origin:center;";
                    <div class="certificate-design__element @(isDivider ? "certificate-design__element--divider" : string.Empty)" style="@style">
                        @if (isQr)
                        {
                            <img src="@element.ImageSrc" alt="رمز التحقق (QR)" style="width:100%;height:100%;object-fit:contain;" />
                        }
                        else if (!isDivider)
                        {
                            @element.Content
                        }
                    </div>
                }
                <div class="certificate-design__watermark @(Model.IsValid ? string.Empty : "is-not-valid")">
                    <i class="bi @(Model.IsValid ? "bi-patch-check-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i>
                    @(Model.IsValid ? "متحقق منها رقمياً" : "تحقق من حالة الشهادة")
                </div>
            </div>
        </section>

        <div class="certificate-actions mt-3">
            <a asp-action="Verify" class="btn btn-outline-primary"><i class="bi bi-search"></i> تحقق من شهادة أخرى</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 certificate-fallback">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="mb-3 @headingClass" style="font-size:4rem;" aria-hidden="true"><i class="bi @iconClass"></i></div>

                @if (Model.IsValid)
                {
                    <h3 class="@headingClass mb-2">تم التحقق من الشهادة</h3>
                    <p class="text-muted mb-4">الشهادة موجودة وحالتها سارية. تظهر هنا البيانات العامة اللازمة للتحقق فقط.</p>
                }
                else if (Model.CertificateFound)
                {
                    <h3 class="@headingClass mb-2">الشهادة غير قابلة للاعتماد</h3>
                    <p class="text-muted mb-4">@Model.Message</p>
                }
                else
                {
                    <h3 class="@headingClass mb-3">تعذر التحقق من الشهادة</h3>
                    <p class="text-muted mb-2">@Model.Message</p>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchCode))
                    {
                        <p class="small text-muted mb-0">المدخل الذي تم التحقق منه: <code>@Model.SearchCode</code></p>
                    }
                }

                @if (Model.CertificateFound)
                {
                    <div class="table-responsive text-start">
                        <table class="table table-borderless align-middle mb-0">
                            <caption class="visually-hidden">بيانات الشهادة ونتيجة حالتها</caption>
                            <tbody>
                                <tr><th scope="row" class="w-50">رقم الشهادة</th><td><code>@Model.CertificateNumber</code></td></tr>
                                <tr><th scope="row">اسم المتدرب بالعربية</th><td>@(Model.TraineeNameArabic ?? Model.TraineeName)</td></tr>
                                <tr><th scope="row">اسم المتدرب بالإنجليزية</th><td dir="ltr">@(Model.TraineeNameEnglish ?? Model.TraineeName)</td></tr>
                                <tr><th scope="row">الدورة</th><td><span dir="ltr">@Model.CourseNameEnglish</span><span class="d-block text-muted">@Model.CourseNameArabic</span></td></tr>
                                <tr><th scope="row">تاريخ الإصدار</th><td>@Model.IssueDate?.ToString("yyyy-MM-dd")</td></tr>
                                <tr><th scope="row">الحالة</th><td><span class="badge @statusClass">@Model.Status</span></td></tr>
                            </tbody>
                        </table>
                    </div>
                }

                <hr class="my-4" />
                <a asp-action="Verify" class="btn btn-outline-primary verify-back"><i class="bi bi-search"></i> تحقق من شهادة أخرى</a>
            </div>
        </div>
    }
</div>

@model ECert.Models.InstallmentPlan
@{
    ViewData["Title"] = "طباعة جدول الأقساط";
    Layout = "_AdminLayout";
    var views = ViewBag.Views as List<ECert.Services.InstallmentService.InstallmentView> ?? new();
    decimal netPaid = ViewBag.NetPaid is decimal np ? np : 0m;
    var invoice = Model.Invoice;
    string StatusLabel(string status) => status switch
    {
        "Paid" => "مدفوع",
        "Partial" => "جزئي",
        "Late" => "متأخر",
        "Upcoming" => "قادم",
        _ => status
    };
    string StatusTone(string status) => status switch
    {
        "Paid" => "ok",
        "Partial" => "warn",
        "Late" => "bad",
        _ => "neutral"
    };
}

@section Styles {
    <style>
        .ip-actions { display: flex; gap: .5rem; margin-bottom: 1rem; }
        .ip-sheet { background: #fff; color: #1a2233; max-width: 820px; margin-inline: auto; padding: 1.5rem; font-family: "Tajawal", "Segoe UI", system-ui, sans-serif; }
        .ip-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #14335c; padding-bottom: .75rem; margin-bottom: 1rem; }
        .ip-head h1 { margin: 0; font-size: 1.25rem; color: #14335c; }
        .ip-head p { margin: 0; font-size: .8rem; color: #6b7688; }
        .ip-meta { display: grid; grid-template-columns: repeat(2, 1fr); gap: .35rem 1.5rem; margin-bottom: 1rem; font-size: .9rem; }
        .ip-meta span { color: #6b7688; }
        .ip-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-bottom: 1rem; }
        .ip-kpi { border: 1px solid #d8dee9; border-radius: 8px; padding: .6rem .75rem; }
        .ip-kpi b { display: block; font-size: 1.05rem; color: #14335c; }
        .ip-kpi span { font-size: .72rem; color: #6b7688; }
        .ip-table { width: 100%; border-collapse: collapse; }
        .ip-table th, .ip-table td { border: 1px solid #e2e7ef; padding: .45rem .6rem; font-size: .85rem; text-align: start; }
        .ip-table th { background: #f4f6fa; color: #42506b; }
        .ip-table td.num { text-align: end; font-variant-numeric: tabular-nums; }
        .ip-badge { display: inline-block; padding: .1rem .5rem; border-radius: 999px; font-size: .75rem; border: 1px solid transparent; }
        .ip-badge--ok { background: #e6f4ea; color: #1e6b3a; border-color: #bfe3c9; }
        .ip-badge--warn { background: #fdf3d8; color: #8a6100; border-color: #f0dcae; }
        .ip-badge--bad { background: #fbe7e7; color: #9b2c2c; border-color: #f0c5c5; }
        .ip-badge--neutral { background: #eef1f6; color: #42506b; border-color: #d8dee9; }
        .ip-foot { margin-top: 1.5rem; display: flex; justify-content: space-between; font-size: .8rem; color: #6b7688; }
        @@media print {
            @@page { size: A4; margin: 12mm; }
            .no-print, .admin-nav, .admin-topbar, .admin-nav__footer { display: none !important; }
            .admin-shell, .admin-main, .admin-content { display: block !important; padding: 0 !important; margin: 0 !important; background: #fff !important; }
            .ip-sheet { max-width: none; padding: 0; }
            .ip-table th, .ip-table td, .ip-badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
}

<div class="ip-actions no-print">
    <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة / حفظ PDF</button>
    <button type="button" class="btn btn-outline-secondary" onclick="window.close()">إغلاق</button>
</div>

<div class="ip-sheet">
    <div class="ip-head">
        <div>
            <h1>جدول الأقساط</h1>
            <p>@(ViewBag.InstitutionName ?? "مركز التدريب")</p>
        </div>
        <div class="text-end">
            <p>@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
        </div>
    </div>

    <div class="ip-meta">
        <div><span>رقم الفاتورة:</span> <strong>@invoice?.InvoiceNumber</strong></div>
        <div><span>المتدرب:</span> <strong>@(invoice?.TraineeNameArabic ?? invoice?.TraineeName)</strong></div>
        <div><span>الدورة:</span> <strong>@invoice?.CourseName</strong></div>
        <div><span>إجمالي الفاتورة:</span> <strong>@Model.TotalAmount.ToString("N2") @Currency.Symbol</strong></div>
        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <div style="grid-column: 1 / -1;"><span>ملاحظة:</span> @Model.Note</div>
        }
    </div>

    <div class="ip-kpis">
        <div class="ip-kpi"><span>إجمالي الخطة</span><b>@Model.TotalAmount.ToString("N2") @Currency.Symbol</b></div>
        <div class="ip-kpi"><span>المدفوع (صافي)</span><b>@netPaid.ToString("N2") @Currency.Symbol</b></div>
        <div class="ip-kpi"><span>المتبقي</span><b>@((Model.TotalAmount - netPaid).ToString("N2")) @Currency.Symbol</b></div>
    </div>

    <table class="ip-table">
        <thead>
            <tr>
                <th>#</th>
                <th>تاريخ الاستحقاق</th>
                <th>المبلغ المستحق</th>
                <th>المدفوع</th>
                <th>المتبقي</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in views)
            {
                <tr>
                    <td>@v.Sequence</td>
                    <td>@v.DueDate.ToString("yyyy-MM-dd")</td>
                    <td class="num">@v.Amount.ToString("N2") @Currency.Symbol</td>
                    <td class="num">@v.Paid.ToString("N2") @Currency.Symbol</td>
                    <td class="num">@v.Remaining.ToString("N2") @Currency.Symbol</td>
                    <td><span class="ip-badge ip-badge--@StatusTone(v.Status)">@StatusLabel(v.Status)</span></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="ip-foot">
        <span>أُنشئت بواسطة: @Model.CreatedBy</span>
        <span>تاريخ الإنشاء: @Model.CreatedAt.ToString("yyyy-MM-dd")</span>
    </div>
</div>

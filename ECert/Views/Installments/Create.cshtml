@{
    ViewData["Title"] = "خطة الأقساط";
    ViewData["PageIcon"] = "bi-calendar-plus";
    ViewData["PageDesc"] = "قسّم إجمالي الفاتورة على أقساط بتواريخ استحقاق؛ يجب أن يساوي مجموعها إجمالي الفاتورة";
    Layout = "_AdminLayout";
    var invoice = ViewBag.Invoice as Invoice;
    var plan = ViewBag.Plan as ECert.Models.InstallmentPlan;
    var existing = plan?.Installments.OrderBy(i => i.DueDate).ThenBy(i => i.Sequence).ToList() ?? new List<ECert.Models.Installment>();
    var rows = existing.Count > 0 ? existing : new List<ECert.Models.Installment> { new() { Sequence = 1, Amount = 0, DueDate = DateTime.Today }, new() { Sequence = 2, Amount = 0, DueDate = DateTime.Today.AddMonths(1) } };
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> عودة</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="a-note a-note--danger mb-4" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> <div>@TempData["Error"]</div></div>
}

@if (invoice != null)
{
    <div class="a-note a-note--info mb-4">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <div>
            <strong>الفاتورة:</strong> @invoice.InvoiceNumber —
            <strong>المتدرب:</strong> @(invoice.TraineeNameArabic ?? invoice.TraineeName) —
            <strong>إجمالي الفاتورة:</strong> @invoice.TotalAmount.ToString("N2") @Currency.Symbol —
            <strong>المدفوع:</strong> @invoice.PaidAmount.ToString("N2") @Currency.Symbol
        </div>
    </div>

    <div class="a-card">
        <div class="a-card__body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="invoiceId" value="@invoice.InvoiceId" />
                <div class="a-table-wrap">
                    <table class="table a-table align-middle" id="instTable">
                        <thead>
                            <tr><th>#</th><th>المبلغ (@Currency.Symbol)</th><th>تاريخ الاستحقاق</th><th></th></tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < rows.Count; i++)
                            {
                                <tr>
                                    <td class="inst-seq">@(i + 1)</td>
                                    <td><input type="number" name="amount" min="0" step="0.01" value="@(rows[i].Amount > 0 ? rows[i].Amount.ToString("0.00") : "")" class="form-control" /></td>
                                    <td><input type="date" name="dueDate" value="@rows[i].DueDate.ToString("yyyy-MM-dd")" class="form-control" /></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="bi bi-x-lg"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-outline-secondary mt-2" onclick="addRow()"><i class="bi bi-plus-lg"></i> إضافة قسط</button>
                <div class="a-field a-field--full mt-3">
                    <label class="a-field__label" for="instNote">ملاحظة</label>
                    <input id="instNote" type="text" name="note" maxlength="500" value="@plan?.Note" class="form-control" placeholder="اختياري" />
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ الخطة</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        function renumber() {
            document.querySelectorAll('#instTable tbody tr').forEach(function (tr, idx) {
                tr.querySelector('.inst-seq').textContent = idx + 1;
            });
        }
        function addRow() {
            var tbody = document.querySelector('#instTable tbody');
            var row = document.createElement('tr');
            row.innerHTML = '<td class="inst-seq"></td>'
                + '<td><input type="number" name="amount" min="0" step="0.01" class="form-control" /></td>'
                + '<td><input type="date" name="dueDate" class="form-control" /></td>'
                + '<td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="bi bi-x-lg"></i></button></td>';
            tbody.appendChild(row);
            renumber();
        }
        function removeRow(btn) {
            btn.closest('tr').remove();
            renumber();
        }
    </script>
}

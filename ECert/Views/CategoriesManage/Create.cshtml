@{
    ViewData["Title"] = "إضافة فئة";
    ViewData["PageIcon"] = "bi-plus-circle";
    ViewData["PageDesc"] = "أنشئ فئة جديدة واختر أيقونتها";
    Layout = "_AdminLayout";
    ViewData["CurrentIcon"] = null;
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للفئات</a>
    </div>
</div>

<div class="a-card a-card--narrow">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-tags" aria-hidden="true"></i> بيانات الفئة</h2>
    </div>
    <div class="a-card__body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="a-error mb-3"></div>

            <div class="a-field">
                <label class="a-label a-label--required" for="CategoryName">اسم الفئة</label>
                <input id="CategoryName" type="text" name="CategoryName" class="form-control" required />
            </div>
            <div class="a-field">
                <label class="a-label" for="Description">الوصف</label>
                <textarea id="Description" name="Description" class="form-control" rows="3"></textarea>
            </div>

            <partial name="_PresetIconPicker" />

            <div class="a-field">
                <label class="a-label" for="categoryImage">أو ارفع صورة أو أيقونة مخصصة</label>
                <input id="categoryImage" type="file" name="icon" accept="image/*" class="form-control" onchange="previewIcon(this)" />
                <span class="a-hint">رفع صورة اختياري. إذا اخترت صورة وأيقونة جاهزة معاً، ستُستخدم الصورة المرفوعة.</span>
                <img id="iconPreview" class="a-media-preview a-media-preview--avatar" src="" alt="معاينة الأيقونة المختارة" hidden />
            </div>

            <div class="form-check mb-0">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked />
                <label class="form-check-label">نشطة</label>
            </div>

            <div class="a-form__actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> حفظ الفئة</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function previewIcon(input) {
        const preview = document.getElementById('iconPreview');
        if (input.files && input.files[0]) {
            document.querySelectorAll('.preset-icon-input').forEach(item => item.checked = false);
            document.querySelectorAll('.preset-icon-option').forEach(item => item.classList.remove('is-selected'));
            const reader = new FileReader();
            reader.onload = function (e) { preview.src = e.target.result; preview.hidden = false; };
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.hidden = true;
        }
    }
</script>
}

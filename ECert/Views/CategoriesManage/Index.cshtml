@model List<ECert.Models.Category>
@using ECert.Services
@{
    ViewData["Title"] = "إدارة الفئات";
    ViewData["PageIcon"] = "bi-grid-3x3-gap";
    ViewData["PageDesc"] = "تصنيف الدورات التدريبية حسب التخصص والمجال";
    Layout = "_AdminLayout";
}
<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> إضافة فئة</a>
    </div>
</div>

<form method="get" class="a-toolbar" role="search">
    <div class="a-toolbar__field a-toolbar__field--grow">
        <label class="a-field__label visually-hidden" for="pageSearch">بحث</label>
        <div class="a-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="pageSearch" type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم الفئة..." />
        </div>
    </div>
    <div class="a-toolbar__actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search)) { <a asp-action="Index" class="btn btn-outline-secondary">مسح</a> }
    </div>
</form>

<div class="a-card">
    <div class="a-card__body a-card__body--flush">
        <div class="a-table-wrap">
            <table class="table a-table table-hover align-middle">
                <thead>
                    <tr>
                        <th>الأيقونة</th>
                        <th>اسم الفئة</th>
                        <th>الوصف</th>
                        <th>عدد الدورات</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td>
                                    @if (CategoryIconCatalog.IsAllowed(cat.IconUrl))
                                    {
                                        <span class="d-inline-flex align-items-center justify-content-center rounded bg-light text-primary" style="width:40px;height:40px;">
                                            <i class="@cat.IconUrl" style="font-size:1.35rem;"></i>
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(cat.IconUrl))
                                    {
                                        <img src="@cat.IconUrl" alt="@cat.CategoryName" style="width:40px;height:40px;object-fit:contain;border-radius:8px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="bi bi-image" style="font-size:1.5rem;"></i></span>
                                    }
                                </td>
                                <td class="fw-bold">@cat.CategoryName</td>
                                <td class="text-muted small">@(cat.Description ?? "-")</td>
                                <td><span class="a-badge a-badge--info a-badge--none">@cat.Courses.Count</span></td>
                                <td>
                                    @if (cat.IsActive)
                                    {
                                        <span class="a-badge a-badge--success">نشطة</span>
                                    }
                                    else
                                    {
                                        <span class="a-badge a-badge--neutral">معطلة</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@cat.CategoryId" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@cat.CategoryId" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الفئة؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="p-0">
                                <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-tags", Title = "لا توجد فئات", Text = "لم تُضف أي فئة بعد. ابدأ بإنشاء أول فئة للدورات.", ActionText = "إضافة فئة", ActionHref = Url.Action("Create") })" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

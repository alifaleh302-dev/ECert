@{
    ViewData["Title"] = "لوحة المالي";
    ViewData["PageIcon"] = "bi-cash-coin";
    ViewData["PageDesc"] = "متابعة الإيرادات والتحصيل والفواتير المعلقة في مكان واحد";
    Layout = "_AdminLayout";

    var recentPayments = ViewBag.RecentPayments as List<ECert.Models.Payment> ?? new();
    var recentInvoices = ViewBag.RecentInvoices as List<ECert.Models.Invoice> ?? new();

    var kpis = new List<KpiCard>
    {
        new() { Label = "إجمالي الإيرادات", Value = ((decimal)ViewBag.TotalRevenue).ToString("N0"), Icon = "bi-cash-stack", Tone = "brand", Hint = "ريال", Href = Url.Action("CourseRevenue", "Reports") },
        new() { Label = "المبالغ المحصلة", Value = ((decimal)ViewBag.TotalPaid).ToString("N0"), Icon = "bi-check-circle", Tone = "success", Hint = "ريال" },
        new() { Label = "المبالغ المتبقية", Value = ((decimal)ViewBag.TotalRemaining).ToString("N0"), Icon = "bi-exclamation-circle", Tone = "danger", Hint = "ريال" },
        new() { Label = "فواتير غير مدفوعة", Value = ViewBag.UnpaidCount?.ToString() ?? "0", Icon = "bi-receipt", Tone = "warning", Hint = "تحتاج متابعة", Href = Url.Action("Index", "Invoices") },
        new() { Label = "فواتير مدفوعة", Value = ViewBag.PaidCount?.ToString() ?? "0", Icon = "bi-check2-all", Tone = "info" },
        new() { Label = "مدفوعة جزئياً", Value = ViewBag.PartialCount?.ToString() ?? "0", Icon = "bi-hourglass-split", Tone = "neutral" },
    };

    var quickLinks = new (string Ctrl, string Action, string Label, string Icon)[]
    {
        ("Invoices", "Index", "الفواتير", "bi-receipt"),
        ("Payments", "Index", "الدفعات", "bi-cash-stack"),
        ("Reports", "CourseRevenue", "تقارير الإيرادات", "bi-graph-up"),
    };
}

<div class="page-header">
    <partial name="_PageHeader" />
</div>

<section class="a-kpis" aria-label="المؤشرات المالية">
    @foreach (var kpi in kpis)
    {
        <partial name="_KpiCard" model="kpi" />
    }
</section>

<section class="a-card mb-4" aria-label="إجراءات سريعة">
    <div class="a-card__header">
        <h2 class="a-card__title"><i class="bi bi-lightning-charge" aria-hidden="true"></i> إجراءات سريعة</h2>
    </div>
    <div class="a-card__body">
        <div class="a-quicklinks">
            @foreach (var link in quickLinks)
            {
                <a class="a-quicklink" asp-controller="@link.Ctrl" asp-action="@link.Action">
                    <i class="bi @link.Icon" aria-hidden="true"></i>
                    <span>@link.Label</span>
                </a>
            }
        </div>
    </div>
</section>

<div class="a-grid-2">
    <section class="a-card" aria-label="آخر الدفعات">
        <div class="a-card__header">
            <h2 class="a-card__title"><i class="bi bi-cash" aria-hidden="true"></i> آخر الدفعات</h2>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Payments" asp-action="Index">عرض الكل</a>
        </div>
        @if (recentPayments.Any())
        {
            <div class="a-table-wrap">
                <table class="a-table">
                    <thead>
                        <tr>
                            <th scope="col">الفاتورة</th>
                            <th scope="col">المبلغ</th>
                            <th scope="col">الطريقة</th>
                            <th scope="col">التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in recentPayments)
                        {
                            <tr>
                                <td><span class="a-code">@p.Invoice?.InvoiceNumber</span></td>
                                <td class="a-table__num">@p.Amount.ToString("N0") ريال</td>
                                <td>@p.PaymentMethod</td>
                                <td class="a-table__num">@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-cash-stack", Title = "لا توجد دفعات بعد", Text = "ستظهر آخر الدفعات هنا فور تسجيلها." })" />
        }
    </section>

    <section class="a-card" aria-label="أحدث الفواتير">
        <div class="a-card__header">
            <h2 class="a-card__title"><i class="bi bi-receipt" aria-hidden="true"></i> أحدث الفواتير</h2>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Invoices" asp-action="Index">عرض الكل</a>
        </div>
        @if (recentInvoices.Any())
        {
            <div class="a-table-wrap">
                <table class="a-table">
                    <thead>
                        <tr>
                            <th scope="col">الرقم</th>
                            <th scope="col">المتدرب</th>
                            <th scope="col">المبلغ</th>
                            <th scope="col">الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in recentInvoices)
                        {
                            <tr>
                                <td><span class="a-code">@inv.InvoiceNumber</span></td>
                                <td class="a-table__primary">@inv.TraineeName</td>
                                <td class="a-table__num">@inv.TotalAmount.ToString("N0") ريال</td>
                                <td>
                                    @switch (inv.Status)
                                    {
                                        case "Unpaid":
                                            <span class="a-badge a-badge--danger">غير مدفوعة</span>
                                            break;
                                        case "PartiallyPaid":
                                            <span class="a-badge a-badge--warning">جزئية</span>
                                            break;
                                        case "Paid":
                                            <span class="a-badge a-badge--success">مدفوعة</span>
                                            break;
                                        case "Cancelled":
                                            <span class="a-badge a-badge--neutral">ملغية</span>
                                            break;
                                        default:
                                            <span class="a-badge a-badge--neutral">@inv.Status</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyState { Icon = "bi-receipt-cutoff", Title = "لا توجد فواتير بعد", Text = "ستظهر أحدث الفواتير هنا فور إنشائها." })" />
        }
    </section>
</div>
